			count: 1
			path: lib/Service/TaskService.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\Service\\\\TaskService\\:\\:\\$userSession is never read, only written\\.$#"
			count: 1
			path: lib/Service/TaskService.php

		# forecast-roll-up-and-categories: AuthorizedAdminSetting app-id-string false positive
		# (same documented stub mistype as the other settings controllers above).
		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/ForecastSettingsController.php

		# sla-engine-and-escalation: same AuthorizedAdminSetting app-id-string false positive.
		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/SlaPolicyController.php

		# Pre-existing BI-export debt (feat c9713bf0) surfaced by the pre-merge check:strict
		# gate; untouched by the forecast change. Tracked under issue #496.
		-
			message: "#^Comparison operation \"\\>\\=\" between int\\<1, max\\> and 1 is always true\\.$#"
			count: 1
			path: lib/Service/Export/CronExpressionHelper.php

		-
			message: "#^Call to an undefined method OCP\\\\ICache\\:\\:add\\(\\)\\.$#"
			count: 1
			path: lib/Service/Export/ExportExecutionService.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\Service\\\\Export\\\\ExportJobService\\:\\:\\$logger is never read, only written\\.$#"
			count: 1
			path: lib/Service/Export/ExportJobService.php

		# IngestProductVendorMaster: PRICING_FIELDS_PROTECTED is REQ-PVM-007 spec documentation,
		# used as a named guard list (future wire-up in the ingest merge logic).
		-
			message: "#^Constant OCA\\\\Pipelinq\\\\Repair\\\\IngestProductVendorMaster\\:\\:PRICING_FIELDS_PROTECTED is unused\\.$#"
			count: 1
			path: lib/Repair/IngestProductVendorMaster.php

		# SMS provider clients: $credentials injected via factory for future wire-up;
		# current OR-leaf dispatch path handles auth via sourceId (same pattern as
		# $notificationService, $emailSyncService etc. in the baseline above).
		-
			message: "#^Property OCA\\\\Pipelinq\\\\Service\\\\Provider\\\\CmComSmsClient\\:\\:\\$credentials is never read, only written\\.$#"
			count: 1
			path: lib/Service/Provider/CmComSmsClient.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\Service\\\\Provider\\\\MessageBirdSmsClient\\:\\:\\$credentials is never read, only written\\.$#"
			count: 1
			path: lib/Service/Provider/MessageBirdSmsClient.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\Service\\\\Provider\\\\TwilioSmsClient\\:\\:\\$credentials is never read, only written\\.$#"
			count: 1
			path: lib/Service/Provider/TwilioSmsClient.php

		# New AuthorizedAdminSetting attribute false positives — same stub mistype as existing
		# entries (runtime accepts plain string; nextcloud/ocp stub requires class-string).
		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/LoyaltyController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 4
			path: lib/Controller/MdmAvgWorkflowController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/MdmMergeController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 1
			path: lib/Controller/MdmSyncQueueController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/MdmTrustConfigController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/PosCustomerSettingsController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 3
			path: lib/Controller/PosTenderController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/ShillinqApController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 1
			path: lib/Controller/TimeEntryWipController.php

		# AppInfo/Application.php: registerEventListener class-string type issue (runtime works;
		# stub over-constrains the second parameter to IEventListener class-string).
		-
			message: "#^Parameter \\#2 \\$listener of method OCP\\\\AppFramework\\\\Bootstrap\\\\IRegistrationContext\\:\\:registerEventListener\\(\\) expects class\\-string\\<OCP\\\\EventDispatcher\\\\IEventListener\\<OCP\\\\EventDispatcher\\\\Event\\>\\>,#"
			count: 1
			path: lib/AppInfo/Application.php

		# AppInfo/Application.php: OC\App\AppStore\Fetcher\AppFetcher is a server internal
		# class (not in nextcloud/ocp stubs); used for feature-flags at runtime.
		-
			message: "#^Class OC\\\\App\\\\AppStore\\\\Fetcher\\\\AppFetcher not found\\.$#"
			count: 1
			path: lib/AppInfo/Application.php

		# SetupController: DataResponse generic type mismatch — the OCP stub uses a strict
		# generic T constraint (DataResponseType) that doesn't match plain arrays. Runtime works.
		# 6 pre-existing + 3 from the seed-demo-data action (align-claims-and-first-hour)
		# + 1 from the skip-demo-data action (the optional demo-data step has to be
		# satisfiable without seeding, or it covers the app with the setup wizard).
		-
			message: "#^Parameter \\#1 \\$data of class OCP\\\\AppFramework\\\\Http\\\\DataResponse constructor expects T of OCP\\\\AppFramework\\\\Http\\\\DataResponseType, array<string, .*> given\\.$#"
			count: 10
			path: lib/Controller/SetupController.php

		# ---------------------------------------------------------------------
		# Added 2026-08-12 (nextcloud-coding-standard migration, PR #809).
		#
		# These six are NOT new defects. They are pre-existing code that only
		# became visible when nextcloud/ocp went ^31 -> ^34: the v34 stubs type
		# ISystemTagObjectMapper's tag ids precisely as string / list<string>,
		# where v31 was loose. Nothing in #809 touched this logic — the
		# identical code is on development at SystemTagCrudService.php:225
		# (the strict in_array) and :141 (tagIds: [$tagId]).
		# ---------------------------------------------------------------------

		# SystemTagCrudService: system tag ids are STRINGS throughout
		# ISystemTagObjectMapper, but this service carries them as int. The
		# consequence is a live bug — isTagUsedByOtherTypes() compares an int
		# strictly against list<string>, so it can never return true, and
		# unassignAndCleanup() therefore deletes a global tag that other object
		# types may still use. Tracked in
		# https://github.com/ConductionNL/pipelinq/issues/810.
		#
		# Deliberately NOT fixed in #809: repairing the guard makes the method
		# start returning true, which changes what gets deleted. That is a
		# behavioural change and #809 is a whitespace/brace reformat plus a
		# toolchain bump. It needs its own PR and its own regression test.
		-
			message: "#^Parameter \\$tagIds of method OCP\\\\SystemTag\\\\ISystemTagObjectMapper\\:\\:assignTags\\(\\) expects array\\<int, string\\>\\|string, array\\<int, int\\> given\\.$#"
			count: 1
			path: lib/Service/SystemTagCrudService.php

		-
			message: "#^Parameter \\$tagIds of method OCP\\\\SystemTag\\\\ISystemTagObjectMapper\\:\\:unassignTags\\(\\) expects array\\<int, string\\>\\|string, array\\<int, int\\> given\\.$#"
			count: 1
			path: lib/Service/SystemTagCrudService.php

		-
			message: "#^Call to function in_array\\(\\) with arguments int, array\\<int, string\\> and true will always evaluate to false\\.$#"
			count: 1
			path: lib/Service/SystemTagCrudService.php

		-
			message: "#^Result of && is always false\\.$#"
			count: 1
			path: lib/Service/SystemTagCrudService.php

		-
			message: "#^Strict comparison using \\=\\=\\= between false and true will always evaluate to false\\.$#"
			count: 1
			path: lib/Service/SystemTagCrudService.php

		# EmailMatchService: a defensive is_array() on the row returned by
		# IResult::fetch(). PHPStan calls it redundant only because the narrow
		# type comes from a PHPDoc ("Because the type is coming from a PHPDoc"),
		# not from a real signature, so the guard is doing genuine runtime work.
		# Kept as-is; see https://github.com/ConductionNL/pipelinq/issues/811.
		-
			message: "#^Strict comparison using \\=\\=\\= between true and false will always evaluate to false\\.$#"
			count: 1
			path: lib/Service/EmailMatchService.php
