# phpstan baseline for pipelinq lint debt.
#
# The 22 entries below are tracked in https://github.com/ConductionNL/pipelinq/issues/496
# and consist of:
#   - unread DI properties (feature-flag / future-wire-up stubs injected for
#     forward-compatibility, e.g. loggers, notificationService, appConfig), and
#   - AuthorizedAdminSetting attribute calls that pass the app-id string, which the
#     nextcloud/ocp stub mistypes as class-string<IDelegatedSettings> (false positive;
#     the runtime signature accepts a plain string).
#
# Resynced 2026-05-31 (pipelinq-quality-phpstan-burndown): seven stale entries that no
# longer fire — three unused named-constants now wired up, the CsrfTokenManager
# invalid-type, and two logic warnings — were resolved in earlier OR-adoption / quality
# phases and dropped here.
#
# Do NOT regenerate this baseline without first triaging issue #496.

parameters:
	ignoreErrors:
		-
			message: "#^Property OCA\\\\Pipelinq\\\\BackgroundJob\\\\CallbackOverdueJob\\:\\:\\$notificationService is never read, only written\\.$#"
			count: 1
			path: lib/BackgroundJob/CallbackOverdueJob.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\BackgroundJob\\\\EmailSyncJob\\:\\:\\$emailSyncService is never read, only written\\.$#"
			count: 1
			path: lib/BackgroundJob/EmailSyncJob.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\BackgroundJob\\\\TaskEscalationJob\\:\\:\\$taskService is never read, only written\\.$#"
			count: 1
			path: lib/BackgroundJob/TaskEscalationJob.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\BackgroundJob\\\\TaskExpiryJob\\:\\:\\$notificationService is never read, only written\\.$#"
			count: 1
			path: lib/BackgroundJob/TaskExpiryJob.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 1
			path: lib/Controller/LedgerController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 3
			path: lib/Controller/LeadSourceController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/ProspectSettingsController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 1
			path: lib/Controller/ReportingController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 3
			path: lib/Controller/RequestChannelController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 8
			path: lib/Controller/SettingsController.php

		-
			message: "#^Parameter \\#1 \\$settings of attribute class OCP\\\\AppFramework\\\\Http\\\\Attribute\\\\AuthorizedAdminSetting constructor expects class\\-string\\<OCP\\\\Settings\\\\IDelegatedSettings\\>, string given\\.$#"
			count: 2
			path: lib/Controller/PosBookkeepingConfigController.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\Service\\\\CalendarSyncService\\:\\:\\$logger is never read, only written\\.$#"
			count: 1
			path: lib/Service/CalendarSyncService.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\Service\\\\CallbackService\\:\\:\\$logger is never read, only written\\.$#"
			count: 1
			path: lib/Service/CallbackService.php

		-
			message: "#^Property OCA\\\\Pipelinq\\\\Service\\\\EmailSyncService\\:\\:\\$logger is never read, only written\\.$#"
