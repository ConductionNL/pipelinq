{
	"name": "conduction/pipelinq",
	"description": "Pipelinq CRM for Nextcloud",
	"type": "nextcloud-app",
	"license": "EUPL-1.2",
	"authors": [
		{
			"name": "Conduction Development Team",
			"email": "info@conduction.nl"
		}
	],
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.0",
		"nextcloud/ocp": "*"
	},
	"autoload": {
		"psr-4": {
			"OCA\\Pipelinq\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Pipelinq\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/",
			"OCA\\": "vendor/nextcloud/ocp/OCA/",
			"NCU\\": "vendor/nextcloud/ocp/NCU/"
		}
	},
	"scripts": {
		"check:strict": [
			"vendor/bin/phpunit -c phpunit.xml --no-coverage"
		],
		"test": [
			"vendor/bin/phpunit -c phpunit.xml --no-coverage"
		]
	}
}
