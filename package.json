{
  "name": "pipelinq",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/check-vue-demi.js",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "check:schema-l10n": "node scripts/check-schema-l10n.js",
    "check:vue-demi": "node scripts/check-vue-demi.js",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test:l10n": "node tests/l10n/check-l10n.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "stylelint": "stylelint \"{src,css}/**/*.{vue,scss,css}\"",
    "stylelint-fix": "stylelint \"src/**/*.vue\" \"src/**/*.scss\" \"src/**/*.css\" --fix",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "test:e2e:install": "playwright install chromium",
    "check:manifest": "node scripts/check-manifest.js",
    "format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@conduction/nextcloud-vue": "^2.3.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/password-confirmation": "^6.1.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@vueuse/core": "^14.3.0",
    "axe-core": "^4.10.0",
    "dexie": "^4.4.4",
    "dompurify": "^3.0.0",
    "gridstack": "^12.6.0",
    "marked": "^18.0.9",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "path-browserify": "^1.0.1",
    "pinia": "^2.1.7",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "overrides": {
    "@nextcloud/axios": "~2.5.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/prettier-config": "^1.2.0",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "@playwright/test": "^1.49.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vue/compiler-sfc": "^3.5.41",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "babel-loader": "^10.1.1",
    "commander": "^12.1.0",
    "css-loader": "~7.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.99.0",
    "sass-loader": "^17.0.0",
    "style-loader": "~4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "terser-webpack-plugin": "^5.6.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.3.0",
    "vue-loader": "^17.4.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^6.0.1"
  },
  "prettier": "@nextcloud/prettier-config"
}
