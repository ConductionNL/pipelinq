    <repair-steps>
        <post-migration>
            <!--
                BEFORE InitializeSettings, which imports the register. OpenRegister
                matches an existing schema by (application, slug) and CREATES a new one
                when that misses, so renaming a slug in the shipped fragment does not
                rename anything — it orphans the old schema and every object already
                written against it, silently. Renaming the row first means the import
                updates the schema in place and keeps its id, and its shard table.
            -->
            <step>OCA\Pipelinq\Repair\RenameLoyaltyAccountSchemaSlug</step>
            <step>OCA\Pipelinq\Repair\InitializeSettings</step>
            <!--
                After InitializeSettings imports the register: the schema edit
                changes the DECLARATION, but every row already written still
                holds the Dutch string, and a filter on the new value returns
                null rather than an error.
            -->
            <step>OCA\Pipelinq\Repair\RenameDutchPipelinqValues</step>
            <step>OCA\Pipelinq\Repair\NormaliseCtiPhoneNumbers</step>
            <step>OCA\Pipelinq\Repair\NormaliseTicketTitle</step>
            <step>OCA\Pipelinq\Repair\InitSlaStatus</step>
            <step>OCA\Pipelinq\Repair\IngestProductVendorMaster</step>
            <step>OCA\Pipelinq\Repair\MigratePosBookkeepingToShillinq</step>
            <step>OCA\Pipelinq\Repair\UnifyClientContactIdentity</step>
            <step>OCA\Pipelinq\Repair\SeedTrustConfigurationRows</step>
            <step>OCA\Pipelinq\Repair\RemoveRetiredAvgJobs</step>
            <step>OCA\Pipelinq\Repair\DrainMdmSyncQueue</step>
            <step>OCA\Pipelinq\Repair\MigrateAvgVerzoekenToOrDsar</step>
            <step>OCA\Pipelinq\Repair\RemoveLegacyPspKeys</step>
            <!--
                Must run AFTER the register sync that adds the English columns.
                Covers pipelinq, pipelinq-portal AND sla: the renamed properties
                are spread across all three, and a step that migrated only some
                would leave the rest silently reading null.
            -->
            <step>OCA\Pipelinq\Repair\RenameDutchColumns</step>
        </post-migration>
        <!--
            FRESH INSTALL. Nextcloud does NOT run post-migration on a first install:
            `Installer::installAppLastSteps()` guards both the pre-migration and
            post-migration blocks with `if ($previousVersion !== '')`, and only
            `repair-steps/install` runs unconditionally afterwards. Until this block
            existed a brand-new Pipelinq install ran NONE of the steps above, so
            InitializeSettings never fired and the pipelinq register and schemas were
            never imported. The step is annotated
            `@spec openspec/specs/openregister-integration/spec.md#requirement-auto-configuration-on-install-repair-step`
            — the spec said "on install"; the wiring never fired on install.

            Only baseline-CREATING steps belong here. Everything else above operates
            on data a fresh install does not have: the Normalise*/Unify*/Drain*/
            InitSlaStatus steps rewrite existing rows, the Migrate*/Remove* steps are
            one-way migrations, and IngestProductVendorMaster consumes a shillinq
            export that a new instance has never received.
        -->
        <install>
            <step>OCA\Pipelinq\Repair\InitializeSettings</step>
            <!--
                After InitializeSettings imports the register: the schema edit
                changes the DECLARATION, but every row already written still
                holds the Dutch string, and a filter on the new value returns
                null rather than an error.
            -->
            <step>OCA\Pipelinq\Repair\RenameDutchPipelinqValues</step>
            <step>OCA\Pipelinq\Repair\SeedTrustConfigurationRows</step>
        </install>
    </repair-steps>

