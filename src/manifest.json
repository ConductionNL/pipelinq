					{ "id": "8",  "widgetId": "client-overview",    "gridX": 6, "gridY": 17, "gridWidth": 6,  "gridHeight": 4 },
					{ "id": "9",  "widgetId": "billing-categories", "gridX": 0, "gridY": 21, "gridWidth": 6,  "gridHeight": 4 },
					{ "id": "12", "widgetId": "report-export",      "gridX": 0, "gridY": 25, "gridWidth": 12, "gridHeight": 3 },
					{ "id": "13", "widgetId": "xwiki-knowledge",    "gridX": 0, "gridY": 28, "gridWidth": 6,  "gridHeight": 5 }
				]
			},
