					{ "id": "my-work",            "type": "custom", "title": "My Work" },
					{ "id": "client-overview",    "type": "custom", "title": "Client Overview" },
					{ "id": "billing-categories", "type": "custom", "title": "Hours by billing category" },
					{ "id": "unified-analytics",  "type": "custom", "title": "Unified Analytics" },
					{ "id": "navi-analytics",     "type": "custom", "title": "Ask Navi" },
