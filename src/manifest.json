				"register": "pipelinq",
				"schema": "intakeSubmission",
				"filter": {
					"form": "@route.id"
				},
				"sortKey": "submittedAt",
				"sortOrder": "desc",
				"columns": [
					"submittedAt",
					"status",
					"contactId",
					"leadId"
				],
				"emptyText": "No submissions yet",
				"showAdd": false,
				"showFormDialog": false,
				"sidebar": {
					"enabled": true,
					"showMetadata": true
