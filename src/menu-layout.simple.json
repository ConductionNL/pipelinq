	"pages": [
		{
			"id": "Reports",
			"configAppend": {
				"cards": [
					{
						"id": "SlaAttainment",
						"label": "SLA attainment",
						"description": "How many tickets were answered within their deadline.",
						"icon": "ChartLine",
