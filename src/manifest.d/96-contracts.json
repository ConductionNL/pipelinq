{
	"menu": [
		{
			"id": "Contracts",
			"label": "Contracts",
			"icon": "FileSign",
			"route": "Contracts",
			"order": 52
		}
	],
	"pages": [
		{
			"id": "Contracts",
			"route": "/contracts",
			"type": "index",
			"title": "Contracts",
			"config": {
				"register": "pipelinq",
				"schema": "salesContract",
				"columns": [
					{ "key": "contractNumber", "label": "Contract number" },
					{ "key": "title", "label": "Title" },
					{ "key": "status", "label": "Status" },
					{ "key": "billingInterval", "label": "Billing interval" },
					{ "key": "valuePerInterval", "label": "Value per interval" },
					{ "key": "endDate", "label": "End date" }
				],
				"filters": [
					"status",
					"ownerId",
					"clientRef"
				]
			}
		},
		{
			"id": "ContractDetail",
			"route": "/contracts/:id",
			"type": "detail",
			"title": "Contract",
			"config": {
				"register": "pipelinq",
				"schema": "salesContract",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"_note": "Agreement archetype (bespoke-detail-pages). A contract is a legal/commercial agreement watched for value and renewal, so the body opens with the Terms data widget 8-wide + an in-grid stats-block KPI card top-right (rule 2, replacing the two loose uncarded stat tiles: Recurring value sums variableConsideration, Fixed value sums fixedConsideration — the contract schema's real amount fields, @objectId-scoped) and the related graph (client via clientRef, renewal lead, predecessor contract) below it, and a full-width Billing data widget (billingInterval, valuePerInterval, value, currency, invoiceReference, lineItems array-on-object) below. The signed contract PDF and amendments live in Documents full-width — the single most-consulted artefact on an agreement record. NO comms leaves: contract declares no email/calendar linkedType (the renewal conversation happens on the linked renewalLead). The lineItems are an ARRAY-on-object (product refs + amounts), not a FK child schema, so they auto-render inside the data widget rather than as an object-list. lifecycleActions is wired to the OR-authoritative status lifecycle (draft -> active -> renewed/churned/cancelled), which drives the manual state transitions; the automated 'expiring'/'renewed' hops are still set by the renewal job. Sidebar is audit-only.",
				"widgets": [
					{ "id": "contract-terms", "type": "data", "title": "Terms", "icon": "FileSign", "content": { "columns": 2, "include": ["contractNumber", "title", "startDate", "endDate", "autoRenew", "noticePeriodDays", "status", "ownerId", "cancellationReason", "renewalLeadOutcome", "noticeReminderSent", "notes"], "overrides": { "status": { "editable": false } } } },
					{ "id": "contract-kpis", "type": "stats-block", "title": "Value", "icon": "CurrencyEur", "content": { "entries": [
						{ "title": "Recurring value", "register": "pipelinq", "schema": "salesContract", "metric": "sum", "field": "variableConsideration", "countLabel": "EUR / interval", "filter": { "id": "@objectId" } },
						{ "title": "Fixed value", "register": "pipelinq", "schema": "salesContract", "metric": "sum", "field": "fixedConsideration", "countLabel": "EUR", "filter": { "id": "@objectId" } }
					] } },
					{ "id": "contract-billing", "type": "data", "title": "Billing", "icon": "CurrencyEur", "content": { "columns": 3, "include": ["billingInterval", "valuePerInterval", "value", "currency", "invoiceReference", "lineItems"] } },
					{ "id": "contract-related", "type": "related", "title": "Related", "icon": "LinkVariant" },
					{ "id": "contract-files", "type": "integration", "integrationId": "files", "title": "Signed contract & amendments", "icon": "FolderOutline" }
				],
				"layout": [
					{ "id": "1", "widgetId": "contract-terms",   "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "2", "widgetId": "contract-kpis",    "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "3", "widgetId": "contract-related", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 3 },
					{ "id": "4", "widgetId": "contract-billing", "gridX": 0, "gridY": 5, "gridWidth": 12, "gridHeight": 3 },
					{ "id": "5", "widgetId": "contract-files",   "gridX": 0, "gridY": 8, "gridWidth": 12, "gridHeight": 3 }
				],
				"bodyWidgets": [
					{
						"id": "contract-invoicing",
						"component": "ContractInvoicingSection",
						"placement": "after-related",
						"props": { "contractId": "@objectId" }
					}
				],
				"lifecycleActions": { "field": "status" },
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		}
	]
}
