{
	"menu": [
		{
			"id": "Contracts",
			"label": "Contracts",
			"icon": "icon-category-organization",
			"route": "Contracts",
			"order": 52
		}
	],
	"pages": [
		{
			"id": "Contracts",
			"route": "/contracts",
			"type": "index",
			"title": "Contracts",
			"config": {
				"register": "pipelinq",
				"schema": "contract",
				"columns": [
					"contractNumber",
					"title",
					"status",
					"billingInterval",
					"valuePerInterval",
					"endDate"
				],
				"filters": [
					"status",
					"ownerId",
					"clientRef"
				]
			}
		},
		{
			"id": "ContractDetail",
			"route": "/contracts/:id",
			"type": "detail",
			"title": "Contract",
			"config": {
				"register": "pipelinq",
				"schema": "contract",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"_note": "Agreement archetype (bespoke-detail-pages). A contract is a legal/commercial agreement watched for value and renewal, so the body opens with two KPI stat cards (Value per interval / Total contract value) then the agreement fields split (ADR-062 rev3) into Terms (contractNumber, title, start/end, autoRenew, noticePeriod, status, owner, cancellation/renewal admin) 8-wide + the related graph (client via clientRef, renewal lead, predecessor contract) 4-wide for the renewal chain, and a full-width Billing data widget (billingInterval, valuePerInterval, value, currency, invoiceReference, lineItems array-on-object) below. The signed contract PDF and amendments live in Documents full-width — the single most-consulted artefact on an agreement record. NO comms leaves: contract declares no email/calendar linkedType (the renewal conversation happens on the linked renewalLead). The lineItems are an ARRAY-on-object (product refs + amounts), not a FK child schema, so they auto-render inside the data widget rather than as an object-list. lifecycleActions is wired to the OR-authoritative status lifecycle (draft -> active -> renewed/churned/cancelled), which drives the manual state transitions; the automated 'expiring'/'renewed' hops are still set by the renewal job. Sidebar is audit-only.",
				"widgets": [
					{ "id": "contract-value", "type": "stat", "title": "Value per interval", "icon": "CurrencyEur", "content": { "label": "Value / interval", "format": "currency", "source": { "register": "pipelinq", "schema": "contract", "metric": "sum", "field": "valuePerInterval", "filter": { "id": "@objectId" } } } },
					{ "id": "contract-total", "type": "stat", "title": "Contract value", "icon": "Cash", "content": { "label": "Total value", "format": "currency", "source": { "register": "pipelinq", "schema": "contract", "metric": "sum", "field": "value", "filter": { "id": "@objectId" } } } },
					{ "id": "contract-terms", "type": "data", "title": "Terms", "icon": "FileSign", "content": { "columns": 2, "include": ["contractNumber", "title", "startDate", "endDate", "autoRenew", "noticePeriodDays", "status", "ownerId", "cancellationReason", "renewalLeadOutcome", "noticeReminderSent", "notes"] } },
					{ "id": "contract-billing", "type": "data", "title": "Billing", "icon": "CurrencyEur", "content": { "columns": 3, "include": ["billingInterval", "valuePerInterval", "value", "currency", "invoiceReference", "lineItems"] } },
					{ "id": "contract-related", "type": "related", "title": "Related", "icon": "LinkVariant" },
					{ "id": "contract-files", "type": "integration", "integrationId": "files", "title": "Signed contract & amendments", "icon": "FolderOutline" }
				],
				"layout": [
					{ "id": "1", "widgetId": "contract-value",   "gridX": 0, "gridY": 0, "gridWidth": 6, "gridHeight": 2 },
					{ "id": "2", "widgetId": "contract-total",   "gridX": 6, "gridY": 0, "gridWidth": 6, "gridHeight": 2 },
					{ "id": "3", "widgetId": "contract-terms",   "gridX": 0, "gridY": 2, "gridWidth": 8, "gridHeight": 5 },
					{ "id": "4", "widgetId": "contract-related", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 5 },
					{ "id": "6", "widgetId": "contract-billing", "gridX": 0, "gridY": 7, "gridWidth": 12, "gridHeight": 3 },
					{ "id": "5", "widgetId": "contract-files",   "gridX": 0, "gridY": 10, "gridWidth": 12, "gridHeight": 3 }
				],
				"bodyWidgets": [
					{
						"id": "contract-invoicing",
						"component": "ContractInvoicingSection",
						"placement": "after-related",
						"props": { "contractId": "@objectId" }
					}
				],
				"lifecycleActions": { "field": "status" },
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		}
	]
}
