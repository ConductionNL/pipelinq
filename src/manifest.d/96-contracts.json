{
	"menu": [
		{
			"id": "Contracts",
			"label": "Contracts",
			"icon": "FileSign",
			"route": "Contracts",
			"order": 52
		}
	],
	"pages": [
		{
			"id": "Contracts",
			"route": "/contracts",
			"type": "index",
			"title": "Contracts",
			"config": {
				"register": "pipelinq",
				"schema": "salesContract",
				"columns": [
					{
						"key": "contractNumber",
						"label": "Contract number",
						"link": true
					},
					{
						"key": "title",
						"label": "Title"
					},
					{
						"key": "clientRef",
						"label": "Client",
						"labelField": "name"
					},
					{
						"key": "status",
						"label": "Status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"draft": "default",
								"active": "success",
								"expiring": "warning",
								"renewed": "info",
								"churned": "error",
								"cancelled": "error"
							}
						}
					},
					{
						"key": "billingInterval",
						"label": "Billing period"
					},
					{
						"key": "valuePerInterval",
						"label": "Value per period",
						"format": {
							"style": "currency",
							"currency": "@config.currency",
							"decimals": 2
						}
					},
					{
						"key": "endDate",
						"label": "End date"
					}
				],
				"filters": [
					"status",
					"ownerId",
					"clientRef"
				],
				"_note": "Board look (PqContracten, round 12): the count line, three KPI tiles above the list, quick filters by status, the status as a coloured pill and the client by name. Ending soonest first.",
				"showTitle": true,
				"showTitleIcon": false,
				"countText": "{shown} of {total} contracts · amounts excl. VAT · ending soonest first",
				"sortKey": "endDate",
				"sortOrder": "asc",
				"headerButtons": [
					{
						"action": "export",
						"label": "Download"
					},
					{
						"action": "add",
						"variant": "primary",
						"icon": "Plus",
						"label": "New contract"
					}
				],
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true,
						"showCount": true
					},
					{
						"label": "To renew",
						"filter": {
							"status": "expiring"
						},
						"showCount": true
					},
					{
						"label": "Active",
						"filter": {
							"status": "active"
						},
						"showCount": true
					},
					{
						"label": "Terminated",
						"filter": {
							"status": "cancelled"
						},
						"showCount": true
					}
				],
				"viewSwitch": [
					"table",
					"cards",
					"board",
					"map"
				],
				"footerNote": "A contract expires soon when its end date falls within the notice period. Recurring revenue per month counts active and expiring contracts.",
				"statRow": [
					{
						"id": "contracts-mrr",
						"type": "stat",
						"content": {
							"label": "Recurring revenue per month",
							"format": {
								"style": "currency",
								"currency": "@config.currency",
								"decimals": 0
							},
							"caption": "from active and expiring monthly contracts",
							"source": {
								"register": "pipelinq",
								"schema": "salesContract",
								"metric": "sum",
								"field": "valuePerInterval",
								"filter": {
									"status": [
										"active",
										"expiring"
									],
									"billingInterval": "monthly"
								}
							}
						}
					},
					{
						"id": "contracts-to-renew",
						"type": "stat",
						"content": {
							"label": "To renew within 90 days",
							"caption": "contracts that end within 90 days",
							"source": {
								"register": "pipelinq",
								"schema": "salesContract",
								"metric": "count",
								"filter": {
									"status": [
										"active",
										"expiring"
									],
									"endDate[lte]": "@today+90d"
								}
							}
						}
					},
					{
						"id": "contracts-auto-renew",
						"type": "stat",
						"content": {
							"label": "Auto renew on",
							"caption": "the rest needs a renewal lead",
							"source": {
								"register": "pipelinq",
								"schema": "salesContract",
								"metric": "count",
								"filter": {
									"autoRenew": true
								}
							}
						}
					}
				],
				"filterMenu": true
			}
		},
		{
			"id": "ContractDetail",
			"route": "/contracts/:id",
			"type": "detail",
			"title": "Contract",
			"config": {
				"register": "pipelinq",
				"schema": "salesContract",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"_note": "Agreement archetype (bespoke-detail-pages). A contract is a legal/commercial agreement watched for value and renewal, so the body opens with the Terms data widget 8-wide beside the full-height related graph, then the stats-block KPI card left of the Billing data widget (rule 2, replacing the two loose uncarded stat tiles: Recurring value sums valuePerInterval, @objectId-scoped, in the contract's own currency through currencyField. It used to sum variableConsideration and fixedConsideration, which the salesContract schema does not have, so both tiles read zero on every contract; `value` is an alias of valuePerInterval, so there is no fixed amount to show). The related graph links the client via clientRef, the renewal lead and the predecessor contract; the Billing data widget holds billingInterval, valuePerInterval, value, currency, invoiceReference and the lineItems array-on-object. The signed contract PDF and amendments live in Documents full-width — the single most-consulted artefact on an agreement record. NO comms leaves: contract declares no email/calendar linkedType (the renewal conversation happens on the linked renewalLead). The lineItems are an ARRAY-on-object (product refs + amounts), not a FK child schema, so they auto-render inside the data widget rather than as an object-list. lifecycleActions is wired to the OR-authoritative status lifecycle (draft -> active -> renewed/churned/cancelled), which drives the manual state transitions; the automated 'expiring'/'renewed' hops are still set by the renewal job. Sidebar is audit-only.",
				"widgets": [
					{
						"id": "contract-panels",
						"type": "tabs",
						"title": "Contract parts",
						"icon": "ViewDashboard",
						"_note": "The board's tab strip (PqContract): Overview stacks the terms, billing, related records and the signed files; History is the audit trail, drawn last.",
						"content": {
							"ariaLabel": "Contract parts",
							"tabs": [
								{
									"label": "Overview",
									"widgetIds": [
										"contract-terms",
										"contract-billing",
										"contract-related",
										"contract-files"
									]
								},
								{
									"label": "History",
									"widgetId": "contract-history"
								}
							]
						}
					},
					{
						"id": "contract-terms",
						"type": "data",
						"title": "Terms",
						"icon": "FileSign",
						"content": {
							"columns": 2,
							"include": [
								"contractNumber",
								"title",
								"startDate",
								"endDate",
								"autoRenew",
								"noticePeriodDays",
								"status",
								"ownerId",
								"cancellationReason",
								"renewalLeadOutcome",
								"noticeReminderSent",
								"notes"
							],
							"overrides": {
								"status": {
									"editable": false
								},
								"ownerId": {
									"formatter": "userDisplayName"
								}
							}
						}
					},
					{
						"id": "contract-billing",
						"type": "sections",
						"title": "Billing",
						"icon": "CurrencyEur",
						"content": {
							"sections": [
								{ "widgetId": "contract-billing-fields" },
								{ "widgetId": "contract-invoice" },
								{ "title": "Lines", "widgetId": "contract-lines" }
							]
						}
					},
					{
						"id": "contract-billing-fields",
						"type": "data",
						"title": "Billing",
						"content": {
							"columns": 2,
							"include": [
								"billingInterval",
								"valuePerInterval",
								"value",
								"currency"
							]
						}
					},
					{
						"id": "contract-invoice",
						"type": "facts",
						"title": "Invoice reference",
						"_note": "PqContract Facturering: the invoice reference with a copy button, and when and by whom the contract went to invoicing (invoicedAt / invoicedBy, written by Send to invoicing).",
						"content": {
							"fields": [
								{ "label": "Invoice reference", "path": "invoiceReference", "copy": true },
								{ "as": "line", "template": "On {invoicedAt:date-long} sent to invoicing by {invoicedBy:user}" }
							],
							"emptyText": "Not sent to invoicing yet."
						}
					},
					{
						"id": "contract-lines",
						"type": "record-list",
						"title": "Lines",
						"content": {
							"presentation": "table",
							"limit": 50,
							"objectRows": {
								"path": "lineItems",
								"refs": [
									{ "field": "productRef", "register": "pipelinq", "schema": "product", "as": "productRecord" }
								]
							},
							"columns": [
								{ "label": "Product", "value": ["{productRecord.name}", "{product}"] },
								{ "label": "Description", "value": "{description}" },
								{ "label": "Quantity", "value": "{quantity}", "align": "end" },
								{ "label": "Unit value", "value": ["{unitValue|currency}", "{unitPrice|currency}"], "align": "end" }
							],
							"emptyText": "No lines on this contract."
						}
					},
					{
						"id": "contract-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					},
					{
						"id": "contract-files",
						"type": "integration",
						"integrationId": "files",
						"title": "Signed contract and amendments",
						"icon": "FolderOutline"
					},
					{
						"id": "contract-history",
						"type": "audit-trail",
						"title": "History",
						"icon": "History"
					},
					{
						"id": "contract-kpi-recurring",
						"type": "stat",
						"title": "Recurring value",
						"content": {
							"label": "Recurring value",
							"format": {
								"style": "currency",
								"currencyField": "currency",
								"decimals": 0
							},
							"caption": "per period",
							"source": {
								"register": "pipelinq",
								"schema": "salesContract",
								"metric": "sum",
								"field": "valuePerInterval",
								"filter": {
									"id": "@objectId"
								}
							}
						}
					},
					{
						"id": "contract-kpi-days",
						"type": "stat",
						"title": "Days to end date",
						"content": {
							"label": "Days to end date",
							"objectField": "endDate",
							"display": "countdown",
							"countdown": {
								"unit": "days"
							},
							"caption": "until the end date"
						}
					},
					{
						"id": "contract-kpi-invoiced",
						"type": "stat",
						"title": "Contract value",
						"content": {
							"label": "Value",
							"format": {
								"style": "currency",
								"currencyField": "currency",
								"decimals": 0
							},
							"caption": "{billingInterval}",
							"source": {
								"register": "pipelinq",
								"schema": "salesContract",
								"metric": "sum",
								"field": "value",
								"filter": {
									"id": "@objectId"
								}
							}
						}
					},
					{
						"id": "side-client",
						"type": "facts",
						"title": "Client",
						"icon": "OfficeBuildingOutline",
						"content": {
							"source": {
								"register": "pipelinq",
								"schema": "client",
								"id": "@object.clientRef"
							},
							"fields": [
								{
									"as": "lead",
									"initialsPath": "name",
									"title": "name",
									"subtitle": [
										{
											"path": "type",
											"map": {
												"organization": "Organisation",
												"person": "Resident"
											}
										}
									]
								},
								{
									"label": "Email",
									"path": "email",
									"format": "email"
								},
								{
									"label": "Phone",
									"path": "phone",
									"format": "phone"
								}
							],
							"link": {
								"label": "Client page",
								"route": {
									"name": "ClientDetail",
									"params": {
										"id": "@object.clientRef"
									}
								}
							},
							"emptyText": "No client linked to this contract yet"
						}
					},
					{
						"id": "side-owner",
						"type": "facts",
						"title": "Owner",
						"icon": "AccountTie",
						"content": {
							"fields": [
								{
									"as": "lead",
									"initialsPath": "ownerId",
									"title": "ownerId",
									"subtitle": [
										{
											"text": "Owner of this contract"
										}
									]
								}
							],
							"emptyText": "No owner set"
						}
					},
					{
						"id": "contract-kpis",
						"type": "stats-block",
						"title": "Value",
						"icon": "Cash",
						"content": {
							"entries": [
								{
									"title": "Recurring value",
									"register": "pipelinq",
									"schema": "salesContract",
									"metric": "sum",
									"field": "valuePerInterval",
									"currencyField": "currency",
									"countLabel": "per interval",
									"filter": {
										"id": "@objectId"
									}
								}
							]
						}
					},
					{
						"id": "side-history",
						"type": "audit-trail",
						"title": "History",
						"icon": "History",
						"content": {
							"limit": 4
						}
					}
				],
				"layout": [
					{
						"id": "k1",
						"widgetId": "contract-kpi-recurring",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "k2",
						"widgetId": "contract-kpi-days",
						"gridX": 4,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "k3",
						"widgetId": "contract-kpi-invoiced",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "1",
						"widgetId": "contract-panels",
						"gridX": 0,
						"gridY": 2,
						"gridWidth": 12,
						"gridHeight": 18,
						"showTitle": false
					}
				],
				"bodyWidgets": [
					{
						"id": "contract-invoicing",
						"component": "ContractInvoicingSection",
						"placement": "after-related",
						"props": {
							"contractId": "@objectId"
						}
					}
				],
				"lifecycleActions": {
					"field": "status"
				},
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				},
				"sideColumn": [
					"side-client",
					"side-owner",
					"side-history"
				],
				"breadcrumb": {
					"label": "Contracts",
					"route": "Contracts",
					"currentField": "contractNumber",
					"separator": "/"
				},
				"statusPill": {
					"field": "status",
					"colorMap": {
						"draft": "default",
						"active": "success",
						"expiring": "warning",
						"renewed": "info",
						"churned": "error",
						"cancelled": "error"
					},
					"labels": {
						"draft": "Draft",
						"active": "Active",
						"expiring": "Expires soon",
						"renewed": "Renewed",
						"churned": "Churned",
						"cancelled": "Cancelled"
					}
				},
				"typePill": {
					"field": "billingInterval",
					"variant": "default",
					"labels": {
						"monthly": "Monthly",
						"quarterly": "Quarterly",
						"annual": "Annually",
						"one-off": "One-off"
					}
				},
				"headerMeta": "ends {endDate|date}, notice period {noticePeriodDays} days",
				"actionsMenu": {
					"label": "More"
				},
				"identifierField": "contractNumber",
				"nextStep": {
					"field": "status",
					"stages": {
						"expiring": {
							"title": "What now? In the renewal period",
							"after": "Then: send the notice period reminder to the client",
							"checklist": [
								{
									"label": "Renewal lead exists",
									"doneField": "renewalLeadRef"
								},
								{
									"label": "Notice period reminder sent",
									"doneWhen": {
										"field": "noticeReminderSent",
										"op": "eq",
										"value": true
									},
									"hint": "Send it before the last day to give notice"
								}
							]
						}
					}
				},
				"headerActions": [
					{
						"id": "send-to-invoicing",
						"type": "api-call",
						"label": "Send to invoicing",
						"icon": "SendOutline",
						"method": "POST",
						"url": "/apps/pipelinq/api/handoff/contract/@objectId/send-to-invoicing",
						"successMessage": "Contract sent to invoicing.",
						"visibleWhen": {
							"endpoint": "/apps/pipelinq/api/handoff/contract/@objectId/availability",
							"field": "canSend",
							"op": "eq",
							"value": true
						}
					},
					{
						"id": "open-renewal-lead",
						"type": "navigate",
						"label": "Open renewal lead",
						"icon": "TrendingUp",
						"target": "/leads/@object.renewalLeadRef",
						"visibleWhen": {
							"field": "renewalLeadRef",
							"op": "neq",
							"value": ""
						}
					}
				],
				"primaryActionByStage": {
					"expiring": "open-renewal-lead"
				},
				"follow": false,
				"quickActions": [
					"send-to-invoicing"
				]
			}
		}
	]
}
