{
	"menu": [
		{
			"id": "Contracts",
			"label": "Contracts",
			"icon": "icon-category-organization",
			"route": "Contracts",
			"order": 52
		}
	],
	"pages": [
		{
			"id": "Contracts",
			"route": "/contracts",
			"type": "index",
			"title": "Contracts",
			"config": {
				"register": "pipelinq",
				"schema": "contract",
				"columns": [
					"contractNumber",
					"title",
					"status",
					"billingInterval",
					"valuePerInterval",
					"endDate"
				],
				"filters": [
					"status",
					"ownerId",
					"clientRef"
				]
			}
		},
		{
			"id": "ContractDetail",
			"route": "/contracts/:id",
			"type": "detail",
			"title": "Contract",
			"config": {
				"register": "pipelinq",
				"schema": "contract",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"_note": "Agreement archetype (bespoke-detail-pages). A contract is a legal/commercial agreement watched for value and renewal, so the body opens with two KPI stat cards (Value per interval / Total contract value) then the agreement fields (contractNumber, title, billingInterval, currency, startDate/endDate, autoRenew, noticePeriodDays, status, owner) 8-wide and the related graph (client via clientRef, the renewal lead, the predecessor contract) 4-wide for the renewal chain. The signed contract PDF and amendments live in Documents full-width — the single most-consulted artefact on an agreement record. NO comms leaves: contract declares no email/calendar linkedType (the renewal conversation happens on the linked renewalLead). The lineItems are an ARRAY-on-object (product refs + amounts), not a FK child schema, so they auto-render inside the data widget rather than as an object-list.",
				"widgets": [
					{ "id": "contract-value", "type": "stat", "title": "Value per interval", "content": { "label": "Value / interval", "format": "currency", "source": { "register": "pipelinq", "schema": "contract", "metric": "sum", "field": "valuePerInterval", "filter": { "id": "@objectId" } } } },
					{ "id": "contract-total", "type": "stat", "title": "Contract value", "content": { "label": "Total value", "format": "currency", "source": { "register": "pipelinq", "schema": "contract", "metric": "sum", "field": "value", "filter": { "id": "@objectId" } } } },
					{ "id": "contract-data", "type": "data", "title": "Contract", "content": { "columns": 2 } },
					{ "id": "contract-related", "type": "related", "title": "Related" },
					{ "id": "contract-files", "type": "integration", "integrationId": "files", "title": "Signed contract & amendments" }
				],
				"layout": [
					{ "id": "1", "widgetId": "contract-value",   "gridX": 0, "gridY": 0, "gridWidth": 6, "gridHeight": 2 },
					{ "id": "2", "widgetId": "contract-total",   "gridX": 6, "gridY": 0, "gridWidth": 6, "gridHeight": 2 },
					{ "id": "3", "widgetId": "contract-data",    "gridX": 0, "gridY": 2, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "4", "widgetId": "contract-related", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 4 },
					{ "id": "5", "widgetId": "contract-files",   "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 3 }
				],
				"bodyWidgets": [
					{
						"id": "contract-invoicing",
						"component": "ContractInvoicingSection",
						"placement": "after-related",
						"props": { "contractId": "@objectId" }
					}
				],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		}
	]
}
