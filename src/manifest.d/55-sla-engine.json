{
	"menu": [
		{
			"id": "SlaAttainment",
			"label": "SLA attainment",
			"icon": "ChartLine",
			"route": "SlaAttainment",
			"order": 98
		}
	],
	"pages": [
		{
			"id": "SlaAttainment",
			"_note": "SLA attainment: the four headline figures and the per-group breakdown read GET /apps/pipelinq/api/sla/attainment. The period (bucket) and grouping filters drive every read; the server defaults the period to the current bucket window and names the grouping in labels.group, which heads the group column.",
			"route": "/sla/attainment",
			"type": "dashboard",
			"title": "SLA attainment",
			"config": {
				"description": "Service Level Agreement performance per policy / tier / target",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"pageFilters": [
					{ "key": "bucket", "label": "Period", "type": "select", "default": "month", "options": [
						{ "value": "day", "label": "Day" },
						{ "value": "week", "label": "Week" },
						{ "value": "month", "label": "Month" },
						{ "value": "quarter", "label": "Quarter" }
					] },
					{ "key": "groupBy", "label": "Group by", "type": "select", "default": "policy", "options": [
						{ "value": "policy", "label": "Policy" },
						{ "value": "tier", "label": "Customer tier" },
						{ "value": "team", "label": "Team" },
						{ "value": "target", "label": "Target kind" },
						{ "value": "customer", "label": "Customer" }
					] }
				],
				"widgets": [
					{ "id": "sla-attainment", "type": "stat", "title": "Overall attainment", "content": { "label": "Overall attainment", "caption": "of all targets", "icon": "CheckCircle", "variant": "primary", "format": { "style": "percent", "decimals": 1 }, "source": { "kind": "endpoint", "url": "/apps/pipelinq/api/sla/attainment", "path": "attainmentPercent", "params": { "bucket": "@page.bucket", "groupBy": "@page.groupBy" } } } },
					{ "id": "sla-total", "type": "stat", "title": "Total", "content": { "label": "Total", "caption": "targets in period", "icon": "ChartLine", "format": { "style": "number", "decimals": 0 }, "source": { "kind": "endpoint", "url": "/apps/pipelinq/api/sla/attainment", "path": "total", "params": { "bucket": "@page.bucket", "groupBy": "@page.groupBy" } } } },
					{ "id": "sla-met", "type": "stat", "title": "Met", "content": { "label": "Met", "caption": "on-time", "icon": "CheckCircle", "variant": "success", "format": { "style": "number", "decimals": 0 }, "source": { "kind": "endpoint", "url": "/apps/pipelinq/api/sla/attainment", "path": "met", "params": { "bucket": "@page.bucket", "groupBy": "@page.groupBy" } } } },
					{ "id": "sla-breached", "type": "stat", "title": "Breached", "content": { "label": "Breached", "caption": "over-deadline", "icon": "AlertOctagon", "variant": "error", "format": { "style": "number", "decimals": 0 }, "source": { "kind": "endpoint", "url": "/apps/pipelinq/api/sla/attainment", "path": "breached", "params": { "bucket": "@page.bucket", "groupBy": "@page.groupBy" } } } },
					{
						"id": "sla-breakdown",
						"type": "object-table",
						"title": "Breakdown",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/sla/attainment", "params": { "bucket": "@workspace.bucket", "groupBy": "@workspace.groupBy" }, "responsePath": "details.byGroup" },
							"columns": [
								{ "key": "groupName", "label": "Group", "labelPath": "labels.group", "cellClass": "cn-cell--strong" },
								{ "key": "total", "label": "Total", "format": { "style": "number" } },
								{ "key": "met", "label": "Met", "format": { "style": "number" } },
								{ "key": "breached", "label": "Breached", "format": { "style": "number" } },
								{ "key": "attainmentPercent", "label": "Attainment", "format": { "style": "percent", "decimals": 1 } }
							],
							"emptyText": "No SLA targets in this period"
						}
					}
				],
				"layout": [
					{ "id": 1, "widgetId": "sla-attainment", "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
					{ "id": 2, "widgetId": "sla-total", "gridX": 3, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
					{ "id": 3, "widgetId": "sla-met", "gridX": 6, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
					{ "id": 4, "widgetId": "sla-breached", "gridX": 9, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
					{ "id": 5, "widgetId": "sla-breakdown", "gridX": 0, "gridY": 2, "gridWidth": 12, "gridHeight": 6 }
				]
			}
		}
	]
}
