{
	"pages": [
		{
			"id": "CampaignEvents",
			"_note": "campaign-events (PqEvenement). The events every campaign holds, newest first. Reached from a campaign's Events card; not a menu entry, because the board keeps Marketing to campaigns and newsletters.",
			"route": "/campaign-events",
			"type": "index",
			"title": "Campaign events",
			"config": {
				"register": "pipelinq",
				"schema": "campaignEvent",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"addLabel": "New event",
				"sortKey": "startAt",
				"sortOrder": "desc",
				"countText": "{shown} of {total} events · newest first",
				"viewModes": ["table", "cards", "calendar"],
				"calendar": { "dateField": "startAt", "endDateField": "endAt", "titleField": "title" },
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Registration open", "filter": { "signupStatus": "open" } },
					{ "label": "Fully booked", "filter": { "signupStatus": "full" } }
				],
				"columns": ["title", "campaign", "startAt", "venue", "capacity", "signupStatus"],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "CampaignEventDetail" }
				]
			}
		},
		{
			"id": "CampaignEventDetail",
			"_note": "campaign-events (PqEvenement). One event: four counts over its registrations (registered against the places, waiting list, from the newsletter, new in pipelinq), the registrations as a list, and the form, the place and the history beside it. The registrations are their own schema, so the counts and the list are queries on eventRegistration filtered on this event, not numbers kept on the event.",
			"route": "/campaign-events/:id",
			"type": "detail",
			"title": "Campaign event",
			"config": {
				"register": "pipelinq",
				"schema": "campaignEvent",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showTypeEyebrow": true,
				"follow": false,
				"sidebar": { "enabled": false },
				"breadcrumb": { "label": "Campaigns", "route": "Campaigns", "separator": "/" },
				"headerMeta": "{startAt|fulldate}, {startAt|time} to {endAt|time} · {venue}",
				"statusPill": {
					"field": "signupStatus",
					"labels": { "draft": "Draft", "open": "Registration open", "full": "Fully booked", "closed": "Registration closed", "cancelled": "Cancelled" },
					"colorMap": { "open": "success", "full": "warning", "draft": "info", "closed": "default", "cancelled": "error" }
				},
				"actionsMenu": { "label": "More" },
				"widgets": [
					{
						"id": "event-kpi-registered",
						"type": "stat",
						"content": {
							"label": "Registered",
							"caption": "of {capacity} places",
							"source": { "register": "pipelinq", "schema": "eventRegistration", "metric": "count", "filter": { "event": "@objectId", "status": "confirmed" } }
						}
					},
					{
						"id": "event-kpi-waitlist",
						"type": "stat",
						"content": {
							"label": "Waiting list",
							"caption": "moves up when someone cancels",
							"source": { "register": "pipelinq", "schema": "eventRegistration", "metric": "count", "filter": { "event": "@objectId", "status": "waitlist" } }
						}
					},
					{
						"id": "event-kpi-newsletter",
						"type": "stat",
						"content": {
							"label": "From the newsletter",
							"caption": "the rest came through the website and posts",
							"source": { "register": "pipelinq", "schema": "eventRegistration", "metric": "count", "filter": { "event": "@objectId", "source": "newsletter" } }
						}
					},
					{
						"id": "event-kpi-new",
						"type": "stat",
						"content": {
							"label": "New in pipelinq",
							"caption": "registrations without an existing record became a contact",
							"source": { "register": "pipelinq", "schema": "eventRegistration", "metric": "count", "filter": { "event": "@objectId", "newContact": true } }
						}
					},
					{
						"id": "event-panels",
						"type": "tabs",
						"title": "Campaign event",
						"content": {
							"ariaLabel": "Campaign event",
							"tabs": [
								{ "label": "Overview", "widgetIds": ["event-data", "event-registrations-recent"] },
								{ "label": "Registrations", "widgetId": "event-registrations", "countFrom": { "register": "pipelinq", "schema": "eventRegistration", "filter": { "event": "@objectId" } } },
								{ "label": "Registration form", "widgetId": "event-form" },
								{ "label": "History", "widgetId": "event-history" }
							]
						}
					},
					{
						"id": "event-data",
						"type": "data",
						"title": "Event details",
						"content": {
							"columns": 2,
							"include": ["title", "reference", "campaign", "startAt", "endAt", "venue", "room", "capacity", "signupStatus", "description"]
						}
					},
					{
						"id": "event-registrations-recent",
						"type": "object-table",
						"title": "Latest registrations",
						"content": {
							"register": "pipelinq",
							"schema": "eventRegistration",
							"filter": { "event": "@objectId" },
							"sort": { "field": "registeredAt", "dir": "desc" },
							"limit": 5,
							"emptyText": "No registrations yet.",
							"columns": [
								{ "key": "name", "label": "Name", "cellClass": "cn-cell--strong" },
								{ "key": "address", "label": "Address" },
								{ "key": "source", "label": "Registered via" },
								{ "key": "registeredAt", "label": "Registered on", "formatter": "date" },
								{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "confirmed": "success", "waitlist": "warning", "cancelled": "default" } } }
							]
						}
					},
					{
						"id": "event-registrations",
						"type": "object-table",
						"title": "Registrations",
						"content": {
							"register": "pipelinq",
							"schema": "eventRegistration",
							"filter": { "event": "@objectId" },
							"sort": { "field": "registeredAt", "dir": "asc" },
							"limit": 50,
							"emptyText": "No registrations yet.",
							"_columnsNote": "PqEvenement's Registrations tab: name, address, how and when, and the status as a coloured pill. The party size and the waiting list position stay on the Registrations list page (EventRegistrations), which lists every field.",
							"columns": [
								{ "key": "name", "label": "Name", "cellClass": "cn-cell--strong" },
								{ "key": "address", "label": "Address" },
								{ "key": "source", "label": "Registered via" },
								{ "key": "registeredAt", "label": "Registered on", "formatter": "date" },
								{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "confirmed": "success", "waitlist": "warning", "cancelled": "default" } } }
							]
						}
					},
					{
						"id": "event-history",
						"type": "timeline",
						"title": "History",
						"content": { "auditTrail": true, "order": "desc" }
					},
					{
						"id": "event-form",
						"type": "data",
						"title": "Registration form",
						"content": {
							"columns": 1,
							"include": ["formTitle", "pageUrl", "signupClosesAt"]
						}
					},
					{
						"id": "event-location",
						"type": "data",
						"title": "Location",
						"content": {
							"columns": 1,
							"include": ["room", "capacity", "hosts", "reminderAt"],
							"overrides": { "hosts": { "formatter": "userDisplayName" } }
						}
					},
					{
						"id": "event-side-history",
						"type": "timeline",
						"title": "History",
						"content": { "auditTrail": true, "order": "desc", "limit": 3 }
					}
				],
				"_bandNote": "PqEvenement: the four counts stand in a row across the page, above the tabs and the side column.",
				"band": [
					{ "widgetId": "event-kpi-registered", "span": 3 },
					{ "widgetId": "event-kpi-waitlist", "span": 3 },
					{ "widgetId": "event-kpi-newsletter", "span": 3 },
					{ "widgetId": "event-kpi-new", "span": 3 }
				],
				"layout": [
					{ "id": "5", "widgetId": "event-panels", "gridX": 0, "gridY": 0, "gridWidth": 12, "gridHeight": 6, "showTitle": false, "sizeToContent": true }
				],
				"sideColumn": ["event-form", "event-location", "event-side-history"]
			}
		},
		{
			"id": "EventRegistrations",
			"_note": "campaign-events (PqEvenement). Every registration over all events, with the lenses the event's Registrations tab draws (confirmed, waiting list, cancelled) and a board by status, for the colleague who works the waiting list.",
			"route": "/event-registrations",
			"type": "index",
			"title": "Registrations",
			"config": {
				"register": "pipelinq",
				"schema": "eventRegistration",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"sortKey": "registeredAt",
				"sortOrder": "desc",
				"viewModes": ["table", "cards", "board"],
				"board": { "statusField": "status" },
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Confirmed", "filter": { "status": "confirmed" } },
					{ "label": "Waiting list", "filter": { "status": "waitlist" } },
					{ "label": "Cancelled", "filter": { "status": "cancelled" } }
				],
				"columns": ["name", "event", "address", "source", "registeredAt", "status"]
			}
		}
	]
}
