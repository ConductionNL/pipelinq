{
  "menu": [
    {
      "id": "MarketingGroup",
      "label": "Marketing",
      "order": 130,
      "children": [
        {
          "id": "SocialAccounts",
          "label": "Social accounts",
          "icon": "AccountBoxOutline",
          "route": "SocialAccounts",
          "order": 60
        },
        {
          "id": "SocialPosts",
          "label": "Social posts",
          "icon": "BullhornOutline",
          "route": "SocialPosts",
          "order": 62
        },
        {
          "id": "SocialPerformance",
          "label": "Social performance",
          "icon": "ChartLine",
          "route": "SocialPerformance",
          "order": 64
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "SocialAccounts",
      "_note": "Connected accounts as a CUSTOM page rather than a declarative type:index (social-publishing). The reason is not styling: Connect is a three-step conversation the grammar has no verb for. Pipelinq answers WHAT to connect, the browser posts that to OpenRegister's own connect endpoint with the user's session, and the network's consent screen returns to this page's own path. The authorization code and the token never pass through Pipelinq, which is rule 2 of the marketing architecture and cannot be expressed as a form field.",
      "route": "/social-accounts",
      "type": "custom",
      "title": "Social accounts",
      "component": "SocialAccountsView",
      "config": {
        "register": "pipelinq",
        "schema": "socialAccount"
      }
    },
    {
      "id": "SocialAccountDetail",
      "_note": "The same view, addressed per account. It exists because OpenRegister's safeReturnUrl() keeps only the PATH of a proposed return URL: a query string is dropped, so the account being connected has to be IN the path for the browser to be identifiable on the way back from the consent screen.",
      "route": "/social-accounts/:id",
      "type": "custom",
      "title": "Social account",
      "component": "SocialAccountsView",
      "config": {
        "register": "pipelinq",
        "schema": "socialAccount"
      }
    },
    {
      "id": "SocialPosts",
      "_note": "Social posts as a declarative type:index page. Add navigates to SocialPostNew, which mounts the one composing surface the change owns (SocialPostComposeModal): the per-network variants, the live character count against each network's own limit and the submit-for-approval step have no declarative equivalent, so showAdd and showFormDialog stay off. Row view opens SocialPostDetail.",
      "route": "/social-posts",
      "type": "index",
      "title": "Social posts",
      "config": {
        "register": "pipelinq",
        "schema": "socialPost",
        "columnOverrides": {
          "createdBy": {
            "formatter": "userDisplayName"
          }
        },
        "documentationUrl": "https://pipelinq.conduction.nl",
        "showAdd": false,
        "showFormDialog": false,
        "showEditAction": false,
        "showCopyAction": false,
        "showMassImport": false,
        "showMassExport": false,
        "showMassCopy": false,
        "headerActions": [
          {
            "id": "create",
            "label": "New post",
            "icon": "Plus",
            "handler": "navigate",
            "route": "SocialPostNew"
          }
        ],
        "showTitle": true,
        "showTitleIcon": false,
        "rowTitle": "plain",
        "rowRoute": "SocialPostDetail",
        "showViewAction": false,
        "countText": "{shown} of {total} posts · newest first",
        "searchPlaceholder": "Filter by title",
        "sortKey": "publishedAt",
        "sortOrder": "desc",
        "headerButtons": [
          {
            "action": "export",
            "label": "Download",
            "icon": "Download"
          },
          {
            "action": "create",
            "variant": "primary",
            "icon": "Plus",
            "label": "New post"
          }
        ],
        "quickFilters": [
          {
            "label": "All",
            "filter": {},
            "default": true,
            "showCount": true
          },
          {
            "label": "Waiting for approval",
            "filter": {
              "status": "approval"
            },
            "showCount": true
          },
          {
            "label": "Scheduled to go out",
            "filter": {
              "status": "scheduled"
            },
            "showCount": true
          },
          {
            "label": "Failed",
            "filter": {
              "status": "failed"
            },
            "showCount": true
          }
        ],
        "columns": [
          {
            "key": "title",
            "label": "Title"
          },
          {
            "key": "status",
            "label": "Status",
            "formatter": "enumLabel",
            "widget": "badge",
            "widgetProps": {
              "colorMap": {
                "draft": "default",
                "approval": "purple",
                "scheduled": "info",
                "published": "success",
                "failed": "error"
              }
            }
          },
          {
            "key": "scheduledFor",
            "label": "Scheduled for",
            "formatter": "relativeDate",
            "formatterOptions": {
              "time": true
            }
          },
          {
            "key": "publishedAt",
            "label": "Published on",
            "formatter": "relativeDate",
            "formatterOptions": {
              "time": true
            }
          }
        ],
        "footerNote": "A post can go to several networks at once, each with its own text.",
        "filterMenu": true,
        "_boardNote": "Board PqSocial: the count line, the four lenses with counts, Download and New post in the header, the status as a coloured badge. Under the list: Sociale prestaties (per-network totals, 30 days) and Social accounts (status pill, the account's next step opens the account).",
        "afterList": [
          {
            "id": "social-network-performance",
            "type": "object-table",
            "title": "Social performance",
            "content": {
              "endpointSource": {
                "url": "/apps/pipelinq/api/social-performance/networks",
                "params": {
                  "days": 30
                },
                "responsePath": "data"
              },
              "headerSubtitle": "Last 30 days",
              "columns": [
                {
                  "key": "label",
                  "label": "Network"
                },
                {
                  "key": "published",
                  "label": "Published",
                  "align": "end",
                  "format": {
                    "style": "decimal",
                    "decimals": 0
                  }
                },
                {
                  "key": "views",
                  "label": "Views",
                  "align": "end",
                  "format": {
                    "style": "decimal",
                    "decimals": 0
                  }
                },
                {
                  "key": "likes",
                  "label": "Likes",
                  "align": "end",
                  "format": {
                    "style": "decimal",
                    "decimals": 0
                  }
                },
                {
                  "key": "comments",
                  "label": "Comments",
                  "align": "end",
                  "format": {
                    "style": "decimal",
                    "decimals": 0
                  }
                },
                {
                  "key": "shares",
                  "label": "Shared",
                  "align": "end",
                  "format": {
                    "style": "decimal",
                    "decimals": 0
                  }
                },
                {
                  "key": "followers",
                  "label": "Followers",
                  "align": "end",
                  "format": {
                    "style": "decimal",
                    "decimals": 0
                  }
                },
                {
                  "key": "engagementPercent",
                  "label": "Engagement rate",
                  "align": "end",
                  "format": {
                    "style": "percent",
                    "decimals": 1
                  }
                }
              ],
              "emptyText": "Nothing published in the last 30 days."
            }
          },
          {
            "id": "social-accounts",
            "type": "record-list",
            "title": "Social accounts",
            "content": {
              "register": "pipelinq",
              "schema": "socialAccount",
              "limit": 20,
              "title": "{network}",
              "meta": "{handle}",
              "valueLabels": {
                "network": {
                  "mastodon": "Mastodon",
                  "bluesky": "Bluesky",
                  "linkedin": "LinkedIn",
                  "instagram": "Instagram",
                  "facebook": "Facebook",
                  "threads": "Threads",
                  "x": "X"
                }
              },
              "pill": {
                "field": "status",
                "labels": {
                  "pending": "Connecting",
                  "active": "Active",
                  "expired": "Expired",
                  "relink_needed": "Reconnect needed",
                  "disabled": "Disabled",
                  "not_configured": "Not set up"
                },
                "colorMap": {
                  "active": "success",
                  "relink_needed": "warning",
                  "expired": "warning",
                  "pending": "info",
                  "disabled": "default",
                  "not_configured": "default"
                }
              },
              "rowAction": {
                "type": "open-page",
                "target": "SocialAccountDetail",
                "variant": "outlined",
                "label": "Open",
                "labels": {
                  "field": "status",
                  "map": {
                    "active": "Revoke",
                    "relink_needed": "Reconnect",
                    "expired": "Reconnect",
                    "not_configured": "Connect",
                    "pending": "Connect",
                    "disabled": "Connect"
                  }
                }
              },
              "emptyText": "No social accounts yet."
            }
          }
        ]
      }
    },
    {
      "id": "SocialPostNew",
      "route": "/social-posts/new",
      "type": "custom",
      "title": "New post",
      "component": "SocialPostFormView",
      "_note": "Mounts SocialPostComposeModal in create mode (social-publishing). Matches the ArticleNew / SegmentNew / TemplateNew convention of a thin route wrapper around the one editing surface the change owns.",
      "config": {
        "register": "pipelinq",
        "schema": "socialPost"
      }
    },
    {
      "id": "SocialPostDetail",
      "_note": "Post record as a declarative type:detail page (ADR-062 grid). The post's own metadata auto-renders in the data widget. The approval step is the header's actionsComponent (SocialPostHeaderActions), beside Edit. The RESOLVED text per network and the approvals taken live in SocialPostVariantsSection (placement before-body, because what the post says is the reason a marketer opened the page), and the per-account outcomes with their retry and share actions live in SocialPublicationsSection (placement end). The approval is not lifecycleActions: it has to record WHO decided, which the transition grammar has no field for.",
      "route": "/social-posts/:id",
      "type": "detail",
      "title": "Social post",
      "actionsComponent": "SocialPostHeaderActions",
      "config": {
        "register": "pipelinq",
        "schema": "socialPost",
        "documentationUrl": "https://pipelinq.conduction.nl",
        "widgets": [
          {
            "id": "social-post-variants",
            "type": "SocialPostVariantsWidget",
            "title": "What it says per network",
            "icon": "TextBoxOutline",
            "content": {
              "title": "What it says per network"
            }
          },
          {
            "id": "social-post-publications",
            "type": "SocialPublicationsWidget",
            "title": "Where it went",
            "icon": "SendOutline",
            "content": {
              "title": "Where it went"
            }
          },
          {
            "id": "social-post-history",
            "type": "audit-trail",
            "title": "History",
            "icon": "History"
          },
          {
            "id": "social-post-panels",
            "type": "tabs",
            "title": "Social post",
            "content": {
              "ariaLabel": "Social post",
              "tabs": [
                {
                  "widgetIds": [
                    "social-post-variants",
                    "social-post-publications"
                  ],
                  "label": "Overview"
                },
                {
                  "widgetId": "social-post-history",
                  "label": "History",
                  "countFrom": "widget"
                }
              ]
            }
          },
          {
            "id": "social-post-approvals",
            "type": "record-list",
            "title": "Approvals",
            "icon": "CheckDecagramOutline",
            "_note": "Board PqSocialBericht: Goedkeuringen in the side column, one line per decision (when, what and who), with the rule under it. The rows are the post's own approvals list.",
            "content": {
              "objectRows": {
                "path": "approvals"
              },
              "presentation": "rows",
              "leading": [
                "{decidedAt|date}",
                "{at|date}"
              ],
              "title": [
                "{decision} by {userId|user}",
                "{decision} by {by|user}"
              ],
              "valueLabels": {
                "decision": {
                  "approved": "Approved",
                  "rejected": "Rejected"
                }
              },
              "footnote": "A post waits for approval before it can be scheduled.",
              "emptyText": "No decision yet. A post waits for approval before it can be scheduled."
            }
          },
          {
            "id": "social-post-data",
            "type": "data",
            "title": "Post details",
            "icon": "InformationOutline",
            "content": {
              "columns": 1,
              "include": [
                "status",
                "scheduledFor",
                "publishedAt",
                "campaignId",
                "articleId",
                "createdBy",
                "agentAuthored"
              ],
              "overrides": {
                "createdBy": {
                  "formatter": "userDisplayName"
                }
              },
              "editable": false,
              "title": "Post details"
            }
          }
        ],
        "gridFloat": false,
        "layout": [
          {
            "id": "1",
            "widgetId": "social-post-panels",
            "gridX": 0,
            "gridY": 0,
            "gridWidth": 12,
            "gridHeight": 8,
            "sizeToContent": true
          }
        ],
        "sideColumn": [
          "social-post-data",
          "social-post-approvals"
        ],
        "titleField": "title",
        "extend": [
          "campaignId"
        ],
        "_headerMetaNote": "Board PqSocialBericht: \"3 netwerken · campagne Afvalvrije week 2026\". The networks are the post's publications (one per account it went to); the campaign is read through _extend, so its name shows rather than its id.",
        "headerMeta": {
          "count": "networks",
          "zero": "campaign {campaignId.name}",
          "one": "{count:networks} network · campaign {campaignId.name}",
          "other": "{count:networks} networks · campaign {campaignId.name}"
        },
        "headerMetaCounts": {
          "networks": {
            "register": "pipelinq",
            "schema": "socialPublication",
            "filter": {
              "postId": "@objectId"
            }
          }
        },
        "headerCard": true,
        "breadcrumb": {
          "label": "Social posts",
          "route": "SocialPosts"
        },
        "statusPill": {
          "field": "status",
          "labels": {
            "draft": "Draft",
            "approval": "Waiting for approval",
            "scheduled": "Scheduled",
            "published": "Published",
            "failed": "Failed"
          },
          "colorMap": {
            "draft": "default",
            "approval": "purple",
            "scheduled": "info",
            "published": "success",
            "failed": "error"
          }
        },
        "_boardNote": "Board PqSocialBericht: the text per network and where it went in an Overview tab beside History, the post details in the side column, the status as a coloured pill."
      }
    },
    {
      "id": "SocialPerformance",
      "_note": "Engagement ranking as a CUSTOM page. The ranking divides engagement by the follower count the daily pull recorded, which no single-schema declarative view can express, and the page renders its table shell before the one request that fills it (pipelinq#1781: never await a per-object fan-out before painting).",
      "route": "/social-performance",
      "type": "custom",
      "title": "Social performance",
      "component": "SocialPerformanceView",
      "config": {
        "register": "pipelinq",
        "schema": "socialPublication"
      }
    }
  ]
}
