{
	"menu": [
		{
			"id": "MarketingGroup",
			"label": "Marketing",
			"order": 130,
			"children": [
				{
					"id": "MailingLists",
					"label": "Lists",
					"icon": "EmailMultiple",
					"route": "MailingLists",
					"order": 30
				}
			]
		}
	],
	"pages": [
		{
			"id": "MailingLists",
			"_note": "Mailing lists as a declarative type:index page. Nothing here needs a component: the fields are flat, the row action opens the detail page, and Add is the standard create dialog. That is the ADR-031 and ADR-049 default, and the reason the list detail page below is not one is stated on that page.",
			"route": "/mailing-lists",
			"type": "index",
			"title": "Lists",
			"config": {
				"register": "pipelinq",
				"schema": "mailingList",
				"columnOverrides": {
					"createdBy": {
						"formatter": "userDisplayName"
					}
				},
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showViewAction": false,
				"actions": [
					{
						"id": "view",
						"label": "Open",
						"icon": "Eye",
						"handler": "navigate",
						"route": "MailingListDetail"
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"countText": "{shown} of {total} lists",
				"searchPlaceholder": "Filter by name",
				"filterMenu": true,
				"viewModes": [
					"table",
					"cards",
					"board",
					"map"
				],
				"board": {
					"statusField": "status"
				},
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "Download"
					},
					{
						"action": "add",
						"variant": "primary",
						"label": "New list"
					}
				],
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true,
						"showCount": true
					},
					{
						"label": "Active",
						"filter": {
							"status": "active"
						},
						"showCount": true
					},
					{
						"label": "Paused",
						"filter": {
							"status": "paused"
						},
						"showCount": true
					}
				],
				"columns": [
					"name",
					{
						"key": "optInMode",
						"label": "Way of signing up"
					},
					"publicSignup",
					{
						"key": "status",
						"label": "Status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"active": "success",
								"paused": "warning",
								"archived": "default"
							}
						}
					}
				],
				"map": {
					"center": [
						52.09,
						5.12
					]
				}
			}
		},
		{
			"id": "MailingListDetail",
			"_note": "Mailing list record as a declarative type:detail page. The list's own fields (name, opt-in mode, sender identity, footer address, status) auto-render in the body via CnObjectDataWidget. The subscriptions table stays a kind:'section' bodyWidget for two reasons no declarative primitive covers: (1) a membership row is read through its STATE, so each row needs a chip vocabulary mapping pending/confirmed/unsubscribed/bounced to a colour and a label, and the object-list widget renders a value, not a chip; (2) the page leads with per-state counts, and summaryAggregates filters are equality-only over one schema and cannot break one field out into four counts on one strip. The section self-fetches GET /api/mailing-lists/{id}/subscriptions, which returns both in one envelope.",
			"route": "/mailing-lists/:id",
			"type": "detail",
			"title": "Mailing list",
			"config": {
				"register": "pipelinq",
				"schema": "mailingList",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"widgets": [
					{
						"id": "list-panels",
						"type": "tabs",
						"title": "Mailing list",
						"content": {
							"ariaLabel": "Mailing list",
							"tabs": [
								{
									"widgetIds": [
										"mailing-list-data"
									],
									"label": "Overview"
								},
								{
									"widgetId": "list-history",
									"label": "History"
								}
							]
						}
					},
					{
						"id": "mailing-list-data",
						"type": "data",
						"title": "List details",
						"content": {
							"title": "List details",
							"columns": 2,
							"include": [
								"senderName",
								"senderEmail",
								"replyTo",
								"optInMode",
								"publicSignup",
								"footerAddress",
								"description"
							],
							"overrides": {
								"senderName": {
									"order": 0
								},
								"senderEmail": {
									"order": 1,
									"label": "Sender e-mail address"
								},
								"replyTo": {
									"order": 2,
									"label": "Reply address"
								},
								"optInMode": {
									"order": 3,
									"label": "Way of signing up",
									"enumLabels": {
										"double": "Double",
										"soft": "Soft"
									}
								},
								"publicSignup": {
									"order": 4,
									"label": "Public sign-up"
								},
								"footerAddress": {
									"order": 5,
									"label": "Address in the footer"
								},
								"description": {
									"order": 6,
									"gridColumn": 2
								}
							},
							"collapsedFields": 7,
							"editable": false
						}
					},
					{
						"id": "list-history",
						"type": "timeline",
						"title": "History",
						"content": {
							"auditTrail": true,
							"order": "desc"
						}
					},
					{
						"id": "list-side-history",
						"type": "timeline",
						"title": "History",
						"content": {
							"auditTrail": true,
							"order": "desc",
							"limit": 3
						}
					},
					{
						"id": "list-signup-form",
						"type": "ListSignupFormWidget",
						"title": "Mailing list sign-up form",
						"content": {
							"title": "Mailing list sign-up form"
						}
					},
					{
						"id": "list-subscriber-view",
						"type": "ListSubscriberViewWidget",
						"title": "What a subscriber sees",
						"content": {
							"title": "What a subscriber sees"
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "list-panels",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 6,
						"showTitle": false,
						"sizeToContent": true
					}
				],
				"bodyWidgets": [
					{
						"id": "list-subscriptions",
						"component": "SubscriptionsSection",
						"title": "Subscribers",
						"placement": "end",
						"props": {
							"listId": "@objectId",
							"card": true
						},
						"card": false,
						"colSpan": 12
					}
				],
				"sidebar": {
					"enabled": false
				},
				"follow": false,
				"showTypeEyebrow": false,
				"statusPill": {
					"field": "status",
					"labels": {
						"active": "Active",
						"paused": "Paused",
						"archived": "Archived"
					},
					"colorMap": {
						"active": "success",
						"paused": "warning",
						"archived": "default"
					}
				},
				"typePill": {
					"field": "optInMode",
					"labels": {
						"double": "Double opt-in",
						"soft": "Soft opt-in"
					},
					"colorMap": {
						"double": "info",
						"soft": "default"
					}
				},
				"breadcrumb": {
					"label": "Mailing lists",
					"route": "MailingLists",
					"separator": "/"
				},
				"headerMeta": {
					"count": "confirmed",
					"zero": "No confirmed subscribers · created by {createdBy|user} on {createdAt|longdate}",
					"one": "1 confirmed subscriber · created by {createdBy|user} on {createdAt|longdate}",
					"other": "{count:confirmed} confirmed subscribers · created by {createdBy|user} on {createdAt|longdate}"
				},
				"actionsMenu": {
					"label": "More"
				},
				"sideColumn": [
					"list-side-history",
					"list-signup-form",
					"list-subscriber-view"
				],
				"sideColumnOrder": "declared",
				"headerMetaCounts": {
					"confirmed": {
						"register": "pipelinq",
						"schema": "subscription",
						"filter": {
							"listId": "@objectId",
							"state": "confirmed"
						}
					}
				}
			}
		}
	]
}
