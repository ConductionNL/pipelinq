{
	"menu": [
		{
			"id": "MarketingGroup",
			"label": "Marketing",
			"order": 130,
			"children": [
				{
					"id": "Campaigns",
					"label": "Campaigns",
					"icon": "BullhornOutline",
					"route": "Campaigns",
					"order": 45
				}
			]
		}
	],
	"pages": [
		{
			"id": "Campaigns",
			"_note": "Campaign list as a declarative type:index page (marketing-campaigns). Add and the row Edit action open CampaignFormDialog in the form-dialog slot instead of the declarative dialog: a campaign written through OpenRegister's object API carries whatever utmCampaign the browser sent and stores a source outside the tenant's vocabulary without complaint. Minting the campaign value once, freezing it across a rename, and refusing an unknown source or medium live in CampaignService, which only POST and PATCH /api/campaigns reach. The report is not reachable from here either: it is a card on the Reports page (ADR-112).",
			"route": "/campaigns",
			"type": "index",
			"title": "Campaigns",
			"slots": {
				"form-dialog": "CampaignFormDialog"
			},
			"config": {
				"register": "pipelinq",
				"schema": "campaign",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"addLabel": "New campaign",
				"showEditAction": true,
				"showCopyAction": false,
				"sortKey": "startsAt",
				"sortOrder": "desc",
				"countText": "{shown} of {total} campaigns · newest first",
				"searchPlaceholder": "Filter by name or UTM value",
				"filterMenu": true,
				"viewModes": [
					"table",
					"cards",
					"board",
					"map"
				],
				"board": {
					"statusField": "status"
				},
				"footerNote": "A campaign bundles mailings and posts, with one landing page and one report.",
				"headerActions": [
					{
						"id": "campaign-report",
						"label": "Campaign report",
						"icon": "ChartBoxOutline",
						"handler": "navigate",
						"route": "CampaignReportPage"
					}
				],
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "Download"
					},
					{
						"action": "campaign-report",
						"label": "Campaign report",
						"icon": "ChartBoxOutline"
					},
					{
						"action": "add",
						"variant": "primary",
						"label": "New campaign"
					}
				],
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true,
						"showCount": true
					},
					{
						"label": "Running",
						"filter": {
							"status": "running"
						},
						"showCount": true
					},
					{
						"label": "Planned",
						"filter": {
							"status": "planned"
						},
						"showCount": true
					},
					{
						"label": "Finished",
						"filter": {
							"status": "finished"
						},
						"showCount": true
					}
				],
				"columns": [
					"name",
					{
						"key": "status",
						"label": "Status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"running": "success",
								"planned": "info",
								"finished": "default",
								"cancelled": "error"
							}
						},
						"formatter": "enumText"
					},
					"utmCampaign",
					"startsAt",
					"endsAt"
				],
				"map": {
					"center": [
						52.09,
						5.12
					]
				}
			}
		},
		{
			"id": "CampaignDetail",
			"_note": "Campaign record as a declarative type:detail page (ADR-062 grid). The campaign's own fields auto-render in the details widget. Edit opens CampaignFormDialog in the form-dialog slot, the same dialog as the Campaigns index, so an edit here also goes through CampaignService. The landing page block is a bodyWidgets section rather than a declarative widget for two reasons: it carries an ACTION that dispatches a cross-app event portaliq answers, which no declarative action expresses, and it must surface portaliq's own typed error code verbatim, which a generic write dialog would collapse into a save failure. Its props carry @objectId, the only token that resolves on a detail page.",
			"route": "/campaigns/:id",
			"type": "detail",
			"title": "Campaign",
			"slots": {
				"form-dialog": "CampaignFormDialog"
			},
			"config": {
				"register": "pipelinq",
				"schema": "campaign",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"widgets": [
					{
						"id": "campaign-panels",
						"type": "tabs",
						"title": "Campaign",
						"content": {
							"ariaLabel": "Campaign",
							"tabs": [
								{
									"widgetIds": [
										"campaign-data",
										"campaign-events",
										"campaign-landing",
										"campaign-report"
									],
									"label": "Overview"
								},
								{
									"widgetId": "campaign-history",
									"label": "History",
									"countFrom": "widget"
								}
							]
						}
					},
					{
						"id": "campaign-data",
						"type": "data",
						"title": "Campaign details",
						"content": {
							"title": "Campaign details",
							"columns": 3,
							"include": [
								"goal",
								"status",
								"utmCampaign",
								"utmSource",
								"utmMedium",
								"startsAt",
								"endsAt",
								"budgetEur"
							],
							"overrides": {
								"goal": {
									"order": 0
								},
								"status": {
									"order": 1,
									"enumLabels": {
										"planned": "Planned",
										"running": "Running",
										"finished": "Finished",
										"cancelled": "Cancelled"
									},
									"pill": {
										"variantMap": {
											"running": "success",
											"planned": "info",
											"finished": "default",
											"cancelled": "error"
										}
									}
								},
								"utmCampaign": {
									"order": 2,
									"label": "UTM campaign"
								},
								"utmSource": {
									"order": 3,
									"label": "UTM source"
								},
								"utmMedium": {
									"order": 4,
									"label": "UTM medium"
								},
								"startsAt": {
									"order": 5,
									"format": "date-long"
								},
								"endsAt": {
									"order": 6,
									"format": "date-long"
								},
								"budgetEur": {
									"order": 7,
									"formatter": "wholeCurrency"
								}
							}
						}
					},
					{
						"id": "campaign-history",
						"type": "timeline",
						"title": "History",
						"content": {
							"auditTrail": true,
							"order": "desc"
						}
					},
					{
						"id": "campaign-contents",
						"type": "menu",
						"title": "In this campaign",
						"content": {
							"style": "tree",
							"showIcons": false,
							"activeItemHighlight": "none",
							"expandedByDefault": true,
							"items": [
								{
									"label": "Newsletters",
									"url": "/index.php/apps/pipelinq/blasts",
									"countFrom": {
										"register": "pipelinq",
										"schema": "blast",
										"filter": {
											"campaignId": "@objectId"
										}
									},
									"countLabel": {
										"one": "{count} newsletter",
										"other": "{count} newsletters"
									}
								},
								{
									"label": "Social posts",
									"url": "/index.php/apps/pipelinq/social-posts",
									"countFrom": {
										"register": "pipelinq",
										"schema": "socialPost",
										"filter": {
											"campaignId": "@objectId"
										}
									},
									"countLabel": {
										"one": "{count} social post",
										"other": "{count} social posts"
									}
								},
								{
									"label": "1 article, the content of the page",
									"url": "/index.php/apps/pipelinq/articles",
									"visibleIf": {
										"object.articleBody": {
											"truthy": true
										}
									}
								},
								{
									"label": "Leads",
									"url": "/index.php/apps/pipelinq/leads",
									"countFrom": {
										"register": "pipelinq",
										"schema": "lead",
										"filter": {
											"campaignId": "@objectId"
										}
									},
									"countLabel": {
										"one": "{count} lead",
										"other": "{count} leads"
									}
								}
							]
						},
						"_note": "PqCampagne \"In deze campagne\": each line names how many the campaign holds, counted per campaign (countFrom with @objectId, countLabel)."
					},
					{
						"id": "campaign-side-history",
						"type": "timeline",
						"title": "History",
						"content": {
							"auditTrail": true,
							"order": "desc",
							"limit": 3
						}
					},
					{
						"id": "campaign-landing",
						"type": "CampaignLandingPageWidget",
						"title": "Landing page",
						"content": {
							"title": "Landing page"
						}
					},
					{
						"id": "campaign-report",
						"type": "CampaignReportWidget",
						"title": "Campaign report",
						"content": {
							"title": "Campaign report"
						}
					},
					{
						"id": "campaign-events",
						"type": "record-list",
						"title": "Events",
						"_note": "campaign-events (PqEvenement): the events this campaign holds, each opening its event page.",
						"content": {
							"register": "pipelinq",
							"schema": "campaignEvent",
							"filter": {
								"campaign": "@objectId"
							},
							"sort": {
								"field": "startAt",
								"dir": "asc"
							},
							"limit": 10,
							"title": "{title}",
							"meta": "{startAt|date} · {venue}",
							"rowRoute": "CampaignEventDetail",
							"headerLink": {
								"label": "All events",
								"route": "CampaignEvents"
							},
							"emptyText": "This campaign holds no events yet."
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "campaign-panels",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"showTitle": false,
						"gridHeight": 6,
						"sizeToContent": true
					}
				],
				"sidebar": {
					"enabled": false
				},
				"follow": false,
				"showTypeEyebrow": false,
				"statusPill": {
					"field": "status",
					"labels": {
						"planned": "Planned",
						"running": "Running",
						"finished": "Finished",
						"cancelled": "Cancelled"
					},
					"colorMap": {
						"running": "success",
						"planned": "info",
						"finished": "default",
						"cancelled": "error"
					}
				},
				"breadcrumb": {
					"label": "Campaigns",
					"route": "Campaigns",
					"separator": "/"
				},
				"headerMeta": "{startsAt|date} to {endsAt|date} · budget {budgetEur|currency:EUR}",
				"actionsMenu": {
					"label": "More"
				},
				"sideColumn": [
					"campaign-contents",
					"campaign-side-history"
				]
			}
		},
		{
			"id": "CampaignReportPage",
			"_note": "The campaign report (marketing-campaigns, ADR-112). Reached as a card on the Reports page and never as a menu entry of its own. Custom because the page renders ONE aggregate response that joins blasts, touchpoints, leads and shillinq invoices across four schemas, with three attribution models already computed in it; no declarative index or dashboard primitive expresses that, and building it from per-object reads is the fan-out pipelinq#1781 removed from the blast performance page. Missing primitive: an aggregation-backed report page.",
			"route": "/reports/campaign",
			"type": "custom",
			"title": "Campaign report",
			"component": "CampaignReportView",
			"config": {
				"register": "pipelinq",
				"schema": "campaign",
				"documentationUrl": "https://pipelinq.conduction.nl"
			}
		}
	]
}
