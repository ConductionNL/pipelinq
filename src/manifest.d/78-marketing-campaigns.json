{
	"menu": [
		{
			"id": "MarketingGroup",
			"label": "Marketing",
			"order": 130,
			"children": [
				{
					"id": "Campaigns",
					"label": "Campaigns",
					"icon": "BullhornOutline",
					"route": "Campaigns",
					"order": 45
				}
			]
		}
	],
	"pages": [
		{
			"id": "Campaigns",
			"_note": "Campaign list as a declarative type:index page (marketing-campaigns). Add and the row Edit action open CampaignFormDialog in the form-dialog slot instead of the declarative dialog: a campaign written through OpenRegister's object API carries whatever utmCampaign the browser sent and stores a source outside the tenant's vocabulary without complaint. Minting the campaign value once, freezing it across a rename, and refusing an unknown source or medium live in CampaignService, which only POST and PATCH /api/campaigns reach. The report is not reachable from here either: it is a card on the Reports page (ADR-112).",
			"route": "/campaigns",
			"type": "index",
			"title": "Campaigns",
			"slots": {
				"form-dialog": "CampaignFormDialog"
			},
			"config": {
				"register": "pipelinq",
				"schema": "campaign",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"addLabel": "New campaign",
				"showEditAction": true,
				"showCopyAction": false,
				"sortKey": "startsAt",
				"sortOrder": "desc",
				"countText": "{shown} of {total} campaigns · newest first",
				"searchPlaceholder": "Filter by name or UTM value",
				"filterMenu": true,
				"viewModes": [
					"table",
					"cards",
					"board",
					"map"
				],
				"board": {
					"statusField": "status"
				},
				"footerNote": "A campaign bundles mailings and posts, with one landing page and one report.",
				"headerActions": [
					{
						"id": "campaign-report",
						"label": "Campaign report",
						"icon": "ChartBoxOutline",
						"handler": "navigate",
						"route": "CampaignReportPage"
					}
				],
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "Download"
					},
					{
						"action": "campaign-report",
						"label": "Campaign report",
						"icon": "ChartBoxOutline"
					},
					{
						"action": "add",
						"variant": "primary",
						"label": "New campaign"
					}
				],
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true,
						"showCount": true
					},
					{
						"label": "Running",
						"filter": {
							"status": "running"
						},
						"showCount": true
					},
					{
						"label": "Planned",
						"filter": {
							"status": "planned"
						},
						"showCount": true
					},
					{
						"label": "Finished",
						"filter": {
							"status": "finished"
						},
						"showCount": true
					}
				],
				"columns": [
					"name",
					{
						"key": "status",
						"label": "Status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"running": "success",
								"planned": "info",
								"finished": "default",
								"cancelled": "error"
							}
						},
						"formatter": "enumText"
					},
					"utmCampaign",
					"startsAt",
					"endsAt"
				],
				"map": {
					"center": [
						52.09,
						5.12
					]
				}
			}
		},
		{
			"id": "CampaignDetail",
			"_note": "Campaign record as a declarative type:detail page (ADR-062 grid). The campaign's own fields auto-render in the details widget. Edit opens CampaignFormDialog in the form-dialog slot, the same dialog as the Campaigns index, so an edit here also goes through CampaignService. The landing page block is a bodyWidgets section rather than a declarative widget for two reasons: it carries an ACTION that dispatches a cross-app event portaliq answers, which no declarative action expresses, and it must surface portaliq's own typed error code verbatim, which a generic write dialog would collapse into a save failure. Its props carry @objectId, the only token that resolves on a detail page.",
			"route": "/campaigns/:id",
			"type": "detail",
			"title": "Campaign",
			"slots": {
				"form-dialog": "CampaignFormDialog"
			},
			"config": {
				"register": "pipelinq",
				"schema": "campaign",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"widgets": [
					{
						"id": "campaign-panels",
						"type": "tabs",
						"title": "Campaign",
						"content": {
							"ariaLabel": "Campaign",
							"tabs": [
								{
									"widgetIds": [
										"campaign-data",
										"campaign-landing",
										"campaign-report",
										"campaign-report-channels"
									],
									"label": "Overview"
								},
								{
									"widgetId": "campaign-history",
									"label": "History",
									"countFrom": "widget"
								}
							]
						}
					},
					{
						"id": "campaign-data",
						"type": "data",
						"title": "Campaign details",
						"content": {
							"title": "Campaign details",
							"columns": 3,
							"include": [
								"goal",
								"status",
								"utmCampaign",
								"utmSource",
								"utmMedium",
								"startsAt",
								"endsAt",
								"budgetEur"
							],
							"overrides": {
								"goal": {
									"order": 0
								},
								"status": {
									"order": 1,
									"enumLabels": {
										"planned": "Planned",
										"running": "Running",
										"finished": "Finished",
										"cancelled": "Cancelled"
									}
								},
								"utmCampaign": {
									"order": 2,
									"label": "UTM campaign"
								},
								"utmSource": {
									"order": 3,
									"label": "UTM source"
								},
								"utmMedium": {
									"order": 4,
									"label": "UTM medium"
								},
								"startsAt": {
									"order": 5
								},
								"endsAt": {
									"order": 6
								},
								"budgetEur": {
									"order": 7
								}
							}
						}
					},
					{
						"id": "campaign-history",
						"type": "timeline",
						"title": "History",
						"content": {
							"auditTrail": true,
							"order": "desc"
						}
					},
					{
						"id": "campaign-contents",
						"type": "markdown",
						"title": "In this campaign",
						"content": {
							"markdown": "[Nieuwsbrieven](/index.php/apps/pipelinq/blasts)\n\n[Sociale berichten](/index.php/apps/pipelinq/social-posts)\n\n[Artikelen, de inhoud van de pagina](/index.php/apps/pipelinq/articles)\n\n[Leads](/index.php/apps/pipelinq/leads)"
						}
					},
					{
						"id": "campaign-side-history",
						"type": "timeline",
						"title": "History",
						"content": {
							"auditTrail": true,
							"order": "desc",
							"limit": 3
						}
					},
					{
						"id": "campaign-landing",
						"type": "CampaignLandingPageWidget",
						"title": "Landing page",
						"content": {
							"title": "Landing page"
						}
					},
					{
						"id": "campaign-report",
						"type": "facts",
						"title": "Campaign report",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/campaigns/@objectId/report" },
							"fields": [
								{ "label": "Clicks", "path": "view.tiles.clicks", "format": "number" },
								{ "label": "Submissions", "path": "view.tiles.submissions", "format": "number" },
								{ "label": "Leads", "path": "view.tiles.leads", "format": "number" },
								{ "label": "Attributed value", "path": "view.tiles.attributedValue", "format": "currency" },
								{ "label": "Cost", "path": "view.tiles.cost", "format": "currency" }
							]
						}
					},
					{
						"id": "campaign-report-channels",
						"type": "object-table",
						"title": "Per channel",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/campaigns/@objectId/report", "responsePath": "view.channelRows" },
							"columns": [
								{ "key": "channel", "label": "Channel", "cellClass": "cn-cell--strong" },
								{ "key": "reach", "label": "Reach", "format": { "style": "number" } },
								{ "key": "opened", "label": "Opened", "format": { "style": "number" } },
								{ "key": "clicks", "label": "Clicks", "format": { "style": "number" } },
								{ "key": "visits", "label": "Visits", "format": { "style": "number" } },
								{ "key": "submissions", "label": "Submissions", "format": { "style": "number" } }
							],
							"emptyText": "No channel has run for this campaign yet."
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "campaign-panels",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"showTitle": false,
						"gridHeight": 6,
						"sizeToContent": true
					}
				],
				"sidebar": {
					"enabled": false
				},
				"follow": false,
				"showTypeEyebrow": false,
				"statusPill": {
					"field": "status",
					"labels": {
						"planned": "Planned",
						"running": "Running",
						"finished": "Finished",
						"cancelled": "Cancelled"
					},
					"colorMap": {
						"running": "success",
						"planned": "info",
						"finished": "default",
						"cancelled": "error"
					}
				},
				"breadcrumb": {
					"label": "Campaigns",
					"route": "Campaigns",
					"separator": "/"
				},
				"headerMeta": "{startsAt|date} to {endsAt|date} · budget {budgetEur|currency:EUR}",
				"actionsMenu": {
					"label": "More"
				},
				"sideColumn": [
					"campaign-contents",
					"campaign-side-history"
				]
			}
		},
		{
			"id": "CampaignReportPage",
			"_note": "The campaign report (marketing-campaigns, ADR-112), reached as a card on the Reports page and from a campaign's landing page card (?campaign=<id>). One GET /api/campaigns/{id}/report joins blasts, touchpoints, leads and shillinq invoices server-side and answers the page's rows in `view`, split by the chosen attribution model.",
			"route": "/reports/campaign",
			"type": "dashboard",
			"title": "Campaign report",
			"config": {
				"documentationUrl": "https://pipelinq.conduction.nl",
				"pageFilters": [
					{
						"key": "campaign",
						"label": "Campaign",
						"type": "select",
						"fromQuery": "campaign",
						"optionsFrom": { "register": "pipelinq", "schema": "campaign", "labelField": "name" }
					},
					{
						"key": "model",
						"label": "Attribution model",
						"type": "select",
						"clearable": true,
						"placeholder": "The campaign's own model",
						"options": [
							{ "value": "first", "label": "First touch" },
							{ "value": "last", "label": "Last touch" },
							{ "value": "linear", "label": "Linear" }
						]
					}
				],
				"widgets": [
					{
						"id": "campaign-report-clicks",
						"type": "stat",
						"title": "Clicks",
						"content": {
							"label": "Clicks",
							"format": { "style": "number", "decimals": 0 },
							"endpointSource": {
								"url": "/apps/pipelinq/api/campaigns/@workspace.campaign/report",
								"params": { "model": "@workspace.model?" }
							},
							"valueField": "view.tiles.clicks"
						}
					},
					{
						"id": "campaign-report-submissions",
						"type": "stat",
						"title": "Submissions",
						"content": {
							"label": "Submissions",
							"format": { "style": "number", "decimals": 0 },
							"endpointSource": {
								"url": "/apps/pipelinq/api/campaigns/@workspace.campaign/report",
								"params": { "model": "@workspace.model?" }
							},
							"valueField": "view.tiles.submissions"
						}
					},
					{
						"id": "campaign-report-leads",
						"type": "stat",
						"title": "Leads",
						"content": {
							"label": "Leads",
							"format": { "style": "number", "decimals": 0 },
							"endpointSource": {
								"url": "/apps/pipelinq/api/campaigns/@workspace.campaign/report",
								"params": { "model": "@workspace.model?" }
							},
							"valueField": "view.tiles.leads"
						}
					},
					{
						"id": "campaign-report-attributed",
						"type": "stat",
						"title": "Attributed value",
						"content": {
							"label": "Attributed value",
							"format": { "style": "currency", "decimals": 2 },
							"endpointSource": {
								"url": "/apps/pipelinq/api/campaigns/@workspace.campaign/report",
								"params": { "model": "@workspace.model?" }
							},
							"valueField": "view.tiles.attributedValue"
						}
					},
					{
						"id": "campaign-report-cost",
						"type": "stat",
						"title": "Cost",
						"content": {
							"label": "Cost",
							"format": { "style": "currency", "decimals": 2 },
							"endpointSource": {
								"url": "/apps/pipelinq/api/campaigns/@workspace.campaign/report",
								"params": { "model": "@workspace.model?" }
							},
							"valueField": "view.tiles.cost",
							"emptyText": "Not recorded"
						}
					},
					{
						"id": "campaign-report-channels",
						"type": "object-table",
						"title": "Per channel",
						"content": {
							"endpointSource": {
								"url": "/apps/pipelinq/api/campaigns/@workspace.campaign/report",
								"params": { "model": "@workspace.model?" },
								"responsePath": "view.channelRows"
							},
							"columns": [
								{ "key": "channel", "label": "Channel", "cellClass": "cn-cell--strong" },
								{ "key": "reach", "label": "Reach", "format": { "style": "number" } },
								{ "key": "opened", "label": "Opened", "format": { "style": "number" } },
								{ "key": "clicks", "label": "Clicks", "format": { "style": "number" } },
								{ "key": "visits", "label": "Visits", "format": { "style": "number" } },
								{ "key": "submissions", "label": "Submissions", "format": { "style": "number" } }
							],
							"emptyText": "No channel has run for this campaign yet."
						}
					},
					{
						"id": "campaign-report-model",
						"type": "object-table",
						"title": "Attributed value per channel",
						"content": {
							"endpointSource": {
								"url": "/apps/pipelinq/api/campaigns/@workspace.campaign/report",
								"params": { "model": "@workspace.model?" },
								"responsePath": "view.modelRows"
							},
							"columns": [
								{ "key": "channel", "label": "Channel", "cellClass": "cn-cell--strong" },
								{ "key": "value", "label": "Attributed value", "format": { "style": "currency", "decimals": 2 } },
								{ "key": "sharePercent", "label": "Share", "format": { "style": "percent", "decimals": 1 } }
							],
							"emptyText": "Nothing is attributed yet."
						}
					},
					{
						"id": "campaign-report-leads-table",
						"type": "object-table",
						"title": "Leads",
						"content": {
							"endpointSource": {
								"url": "/apps/pipelinq/api/campaigns/@workspace.campaign/report",
								"params": { "model": "@workspace.model?" },
								"responsePath": "view.leadRows"
							},
							"columns": [
								{ "key": "title", "label": "Lead", "cellClass": "cn-cell--strong" },
								{
									"key": "basis",
									"label": "Closed on",
									"widget": "badge",
									"enum": ["paid_invoice", "won_lead", "open"],
									"enumLabels": { "paid_invoice": "Paid invoice", "won_lead": "Won lead", "open": "Open" },
									"widgetProps": { "colorMap": { "paid_invoice": "success", "won_lead": "warning", "open": "default" } }
								},
								{ "key": "value", "label": "Value", "format": { "style": "currency", "decimals": 2 } }
							],
							"rowRoute": "LeadDetail",
							"emptyText": "No lead came from this campaign yet."
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "campaign-report-clicks",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 2,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": 2,
						"widgetId": "campaign-report-submissions",
						"gridX": 2,
						"gridY": 0,
						"gridWidth": 2,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": 3,
						"widgetId": "campaign-report-leads",
						"gridX": 4,
						"gridY": 0,
						"gridWidth": 2,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": 4,
						"widgetId": "campaign-report-attributed",
						"gridX": 6,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": 5,
						"widgetId": "campaign-report-cost",
						"gridX": 9,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": 6,
						"widgetId": "campaign-report-channels",
						"gridX": 0,
						"gridY": 2,
						"gridWidth": 12,
						"gridHeight": 5
					},
					{ "id": 7, "widgetId": "campaign-report-model", "gridX": 0, "gridY": 7, "gridWidth": 6, "gridHeight": 5 },
					{
						"id": 8,
						"widgetId": "campaign-report-leads-table",
						"gridX": 6,
						"gridY": 7,
						"gridWidth": 6,
						"gridHeight": 5
					}
				]
			}
		}
	]
}
