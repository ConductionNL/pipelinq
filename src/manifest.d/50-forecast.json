{
	"menu": [
		{
			"id": "Forecast",
			"label": "Forecast",
			"icon": "ChartTimelineVariant",
			"route": "Forecast",
			"order": 95
		}
	],
	"pages": [
		{
			"id": "Forecast",
			"_note": "The forecast of the current quarter for the chosen level, worked out by GET /apps/pipelinq/api/forecast/summary (ForecastSummaryService): the latest snapshot per owner one level down, quota, won, committed and still to get (projected = won + committed + half of best case), the progress, the at-risk warning (below 90% of quota with under 30 days left), and the weekly trend. Override on an owner opens ForecastOverrideModal; Download exports the latest snapshot per owner as CSV.",
			"route": "/forecast",
			"type": "dashboard",
			"title": "Forecast",
			"config": {
				"documentationUrl": "https://pipelinq.conduction.nl",
				"pageFilters": [
					{
						"key": "level",
						"label": "Level",
						"type": "select",
						"control": "segmented",
						"default": "team",
						"options": [
							{ "value": "rep", "label": "Seller" },
							{ "value": "team", "label": "Team" },
							{ "value": "division", "label": "Division" },
							{ "value": "company", "label": "Company" }
						]
					}
				],
				"headerActions": [
					{
						"id": "forecast-download",
						"label": "Download",
						"type": "api-call",
						"icon": "Download",
						"method": "GET",
						"url": "/apps/pipelinq/api/forecast/summary",
						"params": { "level": "@workspace.level", "format": "csv" },
						"download": true,
						"filename": "forecast.csv",
						"successMessage": "Export downloaded"
					}
				],
				"widgets": [
					{
						"id": "forecast-quota",
						"type": "stat",
						"title": "Quota",
						"content": {
							"label": "Quota",
							"format": { "style": "currency", "decimals": 0 },
							"endpointSource": { "url": "/apps/pipelinq/api/forecast/summary", "params": { "level": "@workspace.level" } },
							"valueField": "summary.quota"
						}
					},
					{
						"id": "forecast-won",
						"type": "stat",
						"title": "Won",
						"content": {
							"label": "Won",
							"format": { "style": "currency", "decimals": 0 },
							"endpointSource": { "url": "/apps/pipelinq/api/forecast/summary", "params": { "level": "@workspace.level" } },
							"valueField": "summary.closedWon"
						}
					},
					{
						"id": "forecast-commit",
						"type": "stat",
						"title": "Committed",
						"content": {
							"label": "Committed",
							"format": { "style": "currency", "decimals": 0 },
							"endpointSource": { "url": "/apps/pipelinq/api/forecast/summary", "params": { "level": "@workspace.level" } },
							"valueField": "summary.commit"
						}
					},
					{
						"id": "forecast-gap",
						"type": "stat",
						"title": "Still to get",
						"content": {
							"label": "Still to get",
							"format": { "style": "currency", "decimals": 0 },
							"endpointSource": { "url": "/apps/pipelinq/api/forecast/summary", "params": { "level": "@workspace.level" } },
							"valueField": "summary.gap",
							"caption": "{summary.gapPercent}% below quota",
							"variantWhen": [
								{ "op": "gt", "value": 0, "variant": "warning" }
							]
						}
					},
					{
						"id": "forecast-progress",
						"type": "facts",
						"title": "This quarter",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/forecast/summary", "params": { "level": "@workspace.level" } },
							"fields": [
								{ "path": "period.label", "as": "title" },
								{ "label": "On track", "path": "summary.onTrack", "limitPath": "summary.quota", "as": "meter" }
							]
						}
					},
					{
						"id": "forecast-at-risk",
						"type": "facts",
						"title": "Risk",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/forecast/summary", "params": { "level": "@workspace.level" } },
							"fields": [
								{ "path": "summary.atRiskText", "as": "text" }
							],
							"emptyText": "Nothing to act on this quarter."
						}
					},
					{
						"id": "forecast-owners",
						"type": "object-table",
						"title": "Per owner",
						"content": {
							"endpointSource": {
								"url": "/apps/pipelinq/api/forecast/summary",
								"params": { "level": "@workspace.level" },
								"responsePath": "rows"
							},
							"columns": [
								{ "key": "ownerName", "label": "Owner", "sortable": true, "cellClass": "cn-cell--strong" },
								{
									"key": "commit",
									"label": "Commit",
									"sortable": true,
									"format": { "style": "currency", "decimals": 0 },
									"secondary": "{overrideReason}"
								},
								{
									"key": "bestCase",
									"label": "Best case",
									"sortable": true,
									"format": { "style": "currency", "decimals": 0 }
								},
								{
									"key": "pipeline",
									"label": "Pipeline",
									"sortable": true,
									"format": { "style": "currency", "decimals": 0 }
								},
								{
									"key": "closedWon",
									"label": "Closed won",
									"sortable": true,
									"format": { "style": "currency", "decimals": 0 }
								},
								{
									"key": "quota",
									"label": "Quota",
									"sortable": true,
									"format": { "style": "currency", "decimals": 0 }
								}
							],
							"actions": [
								{
									"id": "override",
									"label": "Override",
									"icon": "Pencil",
									"type": "open-modal",
									"target": "ForecastOverrideModal",
									"props": {
										"periodId": "@row.periodId",
										"ownerId": "@row.ownerId",
										"level": "@row.level",
										"category": "commit",
										"currentAmount": "@row.commit"
									}
								}
							],
							"emptyText": "No snapshots yet. Forecast snapshots are generated every Monday. Check back after the next run."
						}
					},
					{
						"id": "forecast-trend",
						"type": "chart",
						"title": "Commit, best case and pipeline over time",
						"subtitle": "Weekly snapshots, taken every Monday",
						"content": {
							"chartKind": "line",
							"valueFormat": "currency",
							"emptyLabel": "Forecast snapshots are generated every Monday. Check back after the next run.",
							"endpointSource": {
								"url": "/apps/pipelinq/api/forecast/summary",
								"params": { "level": "@workspace.level" },
								"responsePath": "trend",
								"labelsPath": "labels",
								"series": [
									{ "name": "Commit", "path": "commit" },
									{ "name": "Best case", "path": "bestCase" },
									{ "name": "Pipeline", "path": "pipeline" }
								]
							}
						}
					},
					{
						"id": "forecast-moves",
						"type": "facts",
						"title": "Deal movements, week on week",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/forecast/summary", "params": { "level": "@workspace.level" } },
							"fields": [
								{ "label": "Moved into commit", "path": "trend.intoCommit", "format": "currency", "decimals": 0 },
								{ "label": "Taken out of commit", "path": "trend.outOfCommit", "format": "currency", "decimals": 0 }
							]
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "forecast-quota",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": 2,
						"widgetId": "forecast-won",
						"gridX": 3,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": 3,
						"widgetId": "forecast-commit",
						"gridX": 6,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": 4,
						"widgetId": "forecast-gap",
						"gridX": 9,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{ "id": 5, "widgetId": "forecast-progress", "gridX": 0, "gridY": 2, "gridWidth": 8, "gridHeight": 3 },
					{ "id": 6, "widgetId": "forecast-at-risk", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 3 },
					{ "id": 7, "widgetId": "forecast-owners", "gridX": 0, "gridY": 5, "gridWidth": 12, "gridHeight": 6 },
					{ "id": 8, "widgetId": "forecast-trend", "gridX": 0, "gridY": 11, "gridWidth": 8, "gridHeight": 5 },
					{ "id": 9, "widgetId": "forecast-moves", "gridX": 8, "gridY": 11, "gridWidth": 4, "gridHeight": 5 }
				]
			}
		},
		{
			"id": "ForecastTrend",
			"_note": "The signed-in seller's own forecast trend for the current quarter: GET /apps/pipelinq/api/forecast/summary with ownerId @me, which a seller may read for themself (ForecastAccessPolicy). The team view of the same trend is on the Forecast page.",
			"route": "/forecast/trend",
			"type": "dashboard",
			"title": "Forecast trend",
			"config": {
				"documentationUrl": "https://pipelinq.conduction.nl",
				"widgets": [
					{
						"id": "forecast-own-trend",
						"type": "chart",
						"title": "Commit, best case and pipeline over time",
						"subtitle": "Weekly snapshots, taken every Monday",
						"content": {
							"chartKind": "line",
							"valueFormat": "currency",
							"emptyLabel": "Forecast snapshots are generated every Monday. Check back after the next run.",
							"endpointSource": {
								"url": "/apps/pipelinq/api/forecast/summary",
								"params": { "level": "rep", "ownerId": "@me" },
								"responsePath": "trend",
								"labelsPath": "labels",
								"series": [
									{ "name": "Commit", "path": "commit" },
									{ "name": "Best case", "path": "bestCase" },
									{ "name": "Pipeline", "path": "pipeline" }
								]
							}
						}
					},
					{
						"id": "forecast-own-moves",
						"type": "facts",
						"title": "Deal movements, week on week",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/forecast/summary", "params": { "level": "rep", "ownerId": "@me" } },
							"fields": [
								{ "label": "Moved into commit", "path": "trend.intoCommit", "format": "currency", "decimals": 0 },
								{ "label": "Taken out of commit", "path": "trend.outOfCommit", "format": "currency", "decimals": 0 }
							]
						}
					}
				],
				"layout": [
					{ "id": 1, "widgetId": "forecast-own-trend", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
					{ "id": 2, "widgetId": "forecast-own-moves", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 5 }
				]
			}
		}
	]
}
