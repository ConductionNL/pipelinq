{
	"menu": [
		{
			"id": "MarketingGroup",
			"label": "Marketing",
			"order": 130,
			"children": [
				{
					"id": "Articles",
					"label": "Articles",
					"icon": "NewspaperVariantOutline",
					"route": "Articles",
					"order": 25
				}
			]
		}
	],
	"pages": [
		{
			"id": "Articles",
			"_note": "Article list as a declarative type:index page (marketing-article-hub), opened in table view; the cards view stays one toggle away, its title/description/image coming from the article schema's own configuration.objectNameField/objectDescriptionField/objectImageField. New article opens ArticleEditModal, the one editing surface the change owns: the ArticleService create path (author stamp, slug derivation, the ADR-088 agent-mark refusal) is reached through it, so showAdd/showFormDialog stay off. A saved article opens on its detail page. The built-in View action and a row click open ArticleDetail.",
			"route": "/articles",
			"type": "index",
			"title": "Articles",
			"config": {
				"register": "pipelinq",
				"schema": "article",
				"columnOverrides": { "author": { "formatter": "userDisplayName" } },
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"includeColumns": ["title", "status", "language", "publishedAt"],
				"headerActions": [
					{
						"id": "create",
						"label": "New article",
						"icon": "Plus",
						"type": "open-modal",
						"target": "ArticleEditModal"
					}
				]
			}
		},
		{
			"id": "ArticleDetail",
			"_note": "Article record as a declarative type:detail page (ADR-062 grid). The hero image and the markdown body are image and markdown widgets on the record's heroImage and body fields, the summary, links and agent mark a facts card on GET /api/articles/{id} (which answers the links as rows), and the article's metadata the data widget. The five lifecycle moves are api-call header actions shown by status; the server keeps stamping publishedAt on publish. Where the article is used is two stat tiles and a table on GET /api/articles/{id}/usages, joined server-side from campaignTemplate and blast.",
			"route": "/articles/:id",
			"type": "detail",
			"title": "Article",
			"slots": { "form-dialog": "ArticleDetailFormDialog" },
			"config": {
				"register": "pipelinq",
				"schema": "article",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"widgets": [
					{
						"id": "article-hero",
						"type": "image",
						"title": "Hero image",
						"content": { "field": "heroImage", "altField": "title" }
					},
					{ "id": "article-body", "type": "markdown", "title": "Text", "content": { "field": "body" } },
					{
						"id": "article-about",
						"type": "facts",
						"title": "Article",
						"icon": "NewspaperVariantOutline",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/articles/@objectId", "responsePath": "article" },
							"fields": [
								{ "path": "summary", "as": "text" },
								{ "label": "Drafted by", "path": "agentAuthoredBy" }
							],
							"rowsPath": "linkRows",
							"emptyText": "No summary or links yet."
						}
					},
					{
						"id": "article-data",
						"type": "data",
						"title": "Article details",
						"icon": "InformationOutline",
						"content": {
							"columns": 2,
							"include": ["status", "language", "author", "publishedAt", "portalPageRef", "tags", "slug"],
							"overrides": { "author": { "formatter": "userDisplayName" } }
						}
					},
					{
						"id": "article-used-templates",
						"type": "stat",
						"title": "Templates",
						"content": {
							"label": "Templates",
							"caption": "campaign templates use this article",
							"format": { "style": "number", "decimals": 0 },
							"endpointSource": { "url": "/apps/pipelinq/api/articles/@objectId/usages" },
							"valueField": "counts.template"
						}
					},
					{
						"id": "article-used-blasts",
						"type": "stat",
						"title": "Blasts",
						"content": {
							"label": "Blasts",
							"caption": "blasts use this article",
							"format": { "style": "number", "decimals": 0 },
							"endpointSource": { "url": "/apps/pipelinq/api/articles/@objectId/usages" },
							"valueField": "counts.blast"
						}
					},
					{
						"id": "article-usage",
						"type": "object-table",
						"title": "Where this is used",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/articles/@objectId/usages", "responsePath": "data" },
							"columns": [
								{
									"key": "kind",
									"label": "Kind",
									"enum": ["template", "blast"],
									"enumLabels": { "template": "Campaign template", "blast": "Blast" }
								},
								{ "key": "name", "label": "Name", "cellClass": "cn-cell--strong" },
								{
									"key": "status",
									"label": "Status",
									"widget": "badge",
									"enum": ["draft", "scheduled", "sending", "sent", "paused", "failed", "cancelled", "email", "sms"],
									"enumLabels": {
										"draft": "Draft",
										"scheduled": "Scheduled",
										"sending": "Sending",
										"sent": "Sent",
										"paused": "Paused",
										"failed": "Failed",
										"cancelled": "Cancelled",
										"email": "Email",
										"sms": "SMS"
									}
								}
							],
							"emptyText": "This article has not been used anywhere yet."
						}
					}
				],
				"layout": [
					{ "id": "2", "widgetId": "article-hero", "gridX": 0, "gridY": 0, "gridWidth": 12, "gridHeight": 5 },
					{ "id": "3", "widgetId": "article-body", "gridX": 0, "gridY": 5, "gridWidth": 8, "gridHeight": 10 },
					{ "id": "4", "widgetId": "article-about", "gridX": 8, "gridY": 5, "gridWidth": 4, "gridHeight": 5 },
					{ "id": "1", "widgetId": "article-data", "gridX": 8, "gridY": 10, "gridWidth": 4, "gridHeight": 5 },
					{
						"id": "5",
						"widgetId": "article-used-templates",
						"gridX": 0,
						"gridY": 15,
						"gridWidth": 6,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "6",
						"widgetId": "article-used-blasts",
						"gridX": 6,
						"gridY": 15,
						"gridWidth": 6,
						"gridHeight": 2,
						"showTitle": false
					},
					{ "id": "7", "widgetId": "article-usage", "gridX": 0, "gridY": 17, "gridWidth": 12, "gridHeight": 5 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{ "type": "audit" }
							]
						}
					]
				},
				"headerActions": [
					{
						"id": "submitForReview",
						"label": "Submit for review",
						"type": "api-call",
						"method": "POST",
						"url": "/apps/pipelinq/api/articles/@objectId/transition",
						"successMessage": "The article was moved",
						"payload": { "transition": "submitForReview" },
						"visibleWhen": { "field": "status", "op": "eq", "value": "draft" }
					},
					{
						"id": "returnToDraft",
						"label": "Return to draft",
						"type": "api-call",
						"method": "POST",
						"url": "/apps/pipelinq/api/articles/@objectId/transition",
						"successMessage": "The article was moved",
						"payload": { "transition": "returnToDraft" },
						"visibleWhen": { "field": "status", "op": "eq", "value": "review" }
					},
					{
						"id": "publish",
						"label": "Publish",
						"type": "api-call",
						"method": "POST",
						"url": "/apps/pipelinq/api/articles/@objectId/publish",
						"successMessage": "The article was moved",
						"visibleWhen": { "field": "status", "op": "in", "value": ["draft", "review"] }
					},
					{
						"id": "archive",
						"label": "Archive",
						"type": "api-call",
						"method": "POST",
						"url": "/apps/pipelinq/api/articles/@objectId/archive",
						"successMessage": "The article was moved",
						"visibleWhen": { "field": "status", "op": "eq", "value": "published" }
					},
					{
						"id": "restore",
						"label": "Restore as draft",
						"type": "api-call",
						"method": "POST",
						"url": "/apps/pipelinq/api/articles/@objectId/transition",
						"successMessage": "The article was moved",
						"payload": { "transition": "restore" },
						"visibleWhen": { "field": "status", "op": "eq", "value": "archived" }
					}
				]
			}
		}
	]
}
