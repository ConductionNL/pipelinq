{
	"_comment": "ADR-037 manifest fragment for marketing-search-intelligence (phase 5). Kept in its own file so the concurrent campaigns build does not conflict on the Marketing group. All three pages are path-routed: a deep link is /index.php/apps/pipelinq/marketing/keywords, never a hash route.",
	"menu": [
		{
			"id": "MarketingGroup",
			"label": "Marketing",
			"order": 130,
			"children": [
				{
					"id": "KeywordIntelligence",
					"label": "Keywords",
					"icon": "KeyVariant",
					"route": "KeywordIntelligence",
					"order": 72
				},
				{
					"id": "CompetitorWatches",
					"label": "Competitors",
					"icon": "AccountGroupOutline",
					"route": "CompetitorWatches",
					"order": 74
				},
				{
					"id": "ConnectionAudit",
					"label": "Connection audit",
					"icon": "AccountArrowRightOutline",
					"route": "ConnectionAudit",
					"order": 76
				}
			]
		}
	],
	"pages": [
		{
			"id": "KeywordIntelligence",
			"_note": "Keyword proposals (marketing-search-intelligence). Custom rather than a declarative type:index over keywordTarget, because what this page shows is not a collection at all: it is four DERIVATIONS computed over the searchQueryDaily rows at read time (position buckets, striking distance, cannibalisation, content gaps), served by one GET /api/marketing/keyword-proposals. The keywordTarget objects it can create are the OUTPUT, not the input. Missing primitive: a page backed by a computed report with a per-row create action.",
			"route": "/marketing/keywords",
			"type": "custom",
			"title": "Keywords",
			"component": "KeywordIntelligenceView",
			"config": {
				"register": "pipelinq",
				"schema": "keywordTarget",
				"documentationUrl": "https://pipelinq.conduction.nl"
			}
		},
		{
			"id": "CompetitorWatches",
			"_note": "Competitor watches and what they saw (marketing-search-intelligence), read from one GET /apps/pipelinq/api/marketing/watch-events that joins competitor, competitorWatch and watchEvent. A watch's last outcome tells 'they published nothing' apart from 'we could not read it', and Run now runs one watch (POST /api/marketing/competitor-watches/{id}/run). When no egress source is set, a card says so with the server's reason.",
			"route": "/marketing/competitors",
			"type": "dashboard",
			"title": "Competitors",
			"config": {
				"documentationUrl": "https://pipelinq.conduction.nl",
				"widgets": [
					{
						"id": "competitors-unconfigured",
						"type": "facts",
						"title": "Watches are off",
						"visibleWhen": {
							"endpoint": "/apps/pipelinq/api/marketing/watch-events",
							"field": "configured",
							"op": "eq",
							"value": false
						},
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/marketing/watch-events" },
							"fields": [
								{ "path": "reason", "as": "text" }
							],
							"notice": {
								"text": "Set an egress source under Settings, Marketing intelligence to switch the watches on.",
								"variant": "warning"
							}
						}
					},
					{
						"id": "competitor-watches",
						"type": "object-table",
						"title": "Watches",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/marketing/watch-events", "responsePath": "watches" },
							"columns": [
								{
									"key": "competitorId",
									"label": "Competitor",
									"widget": "fkResolve",
									"widgetProps": { "register": "pipelinq", "schema": "competitor", "labelField": "name" }
								},
								{
									"key": "kind",
									"label": "Watching",
									"secondary": "{target}",
									"enum": ["rss", "sitemap", "page", "fediverse", "search"],
									"enumLabels": {
										"rss": "Feed",
										"sitemap": "Sitemap",
										"page": "Page fragment",
										"fediverse": "Public timeline",
										"search": "Saved search"
									}
								},
								{
									"key": "schedule",
									"label": "How often",
									"enum": ["hourly", "daily", "weekly"],
									"enumLabels": { "hourly": "Every hour", "daily": "Every day", "weekly": "Every week" }
								},
								{ "key": "lastRunAt", "label": "Last run", "widget": "date", "widgetProps": { "showTime": true } },
								{
									"key": "lastOutcome",
									"label": "Outcome",
									"widget": "badge",
									"secondary": "{lastReason}",
									"enum": ["ok", "not_configured", "unavailable", "refused", "unparsable"],
									"enumLabels": {
										"ok": "Read",
										"not_configured": "Not configured",
										"unavailable": "Could not reach it",
										"refused": "Refused",
										"unparsable": "Could not read it"
									},
									"widgetProps": {
										"colorMap": {
											"ok": "success",
											"not_configured": "warning",
											"unavailable": "error",
											"refused": "error",
											"unparsable": "error"
										}
									}
								}
							],
							"actions": [
								{
									"id": "run",
									"label": "Run now",
									"type": "api-call",
									"method": "POST",
									"url": "/apps/pipelinq/api/marketing/competitor-watches/@row.id/run",
									"successMessage": "The watch ran"
								}
							],
							"emptyText": "No watches yet. Add a competitor and give it something to watch: a feed, a sitemap, a page fragment, a public fediverse timeline, or a saved search. LinkedIn and Meta are deliberately not options: neither offers a legitimate way to read another organisation's posts."
						}
					},
					{
						"id": "competitor-events",
						"type": "object-table",
						"title": "What changed",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/marketing/watch-events", "responsePath": "events" },
							"columns": [
								{
									"key": "title",
									"label": "Item",
									"widget": "link",
									"widgetProps": { "href": "{url}" },
									"secondary": "{diffSummary}",
									"cellClass": "cn-cell--strong"
								},
								{
									"key": "competitorId",
									"label": "Competitor",
									"widget": "fkResolve",
									"widgetProps": { "register": "pipelinq", "schema": "competitor", "labelField": "name" }
								},
								{
									"key": "kind",
									"label": "Source",
									"enum": ["rss", "sitemap", "page", "fediverse", "search"],
									"enumLabels": {
										"rss": "Feed",
										"sitemap": "Sitemap",
										"page": "Page fragment",
										"fediverse": "Public timeline",
										"search": "Saved search"
									}
								},
								{ "key": "seenAt", "label": "Seen", "widget": "date", "widgetProps": { "showTime": true } },
								{ "key": "relevanceScore", "label": "Relevance", "format": { "style": "number", "decimals": 2 } }
							],
							"emptyText": "Nothing has been seen yet. A watch records an item once, so a second run over unchanged sources adds nothing here."
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "competitors-unconfigured",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 2
					},
					{ "id": 2, "widgetId": "competitor-watches", "gridX": 0, "gridY": 2, "gridWidth": 12, "gridHeight": 6 },
					{ "id": 3, "widgetId": "competitor-events", "gridX": 0, "gridY": 8, "gridWidth": 12, "gridHeight": 6 }
				]
			}
		},
		{
			"id": "ConnectionAudit",
			"_note": "The follow audit (marketing-search-intelligence): a table on GET /apps/pipelinq/api/marketing/connection-audit that shows the reason beside every answer, so a marketer does not act on a wrong no. Check again reads the networks anew (refresh=true) and the table reads the result.",
			"route": "/marketing/connection-audit",
			"type": "dashboard",
			"title": "Connection audit",
			"config": {
				"documentationUrl": "https://pipelinq.conduction.nl",
				"headerActions": [
					{
						"id": "check-again",
						"label": "Check again",
						"type": "api-call",
						"method": "GET",
						"icon": "Refresh",
						"url": "/apps/pipelinq/api/marketing/connection-audit",
						"params": { "refresh": "true" },
						"successMessage": "The connections were checked again"
					}
				],
				"widgets": [
					{
						"id": "connection-audit",
						"type": "object-table",
						"title": "Connections",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/marketing/connection-audit", "responsePath": "rows" },
							"columns": [
								{
									"key": "counterpartHandle",
									"label": "Handle",
									"widget": "link",
									"widgetProps": { "href": "{counterpartUrl}" },
									"cellClass": "cn-cell--strong"
								},
								{
									"key": "network",
									"label": "Network",
									"enum": ["mastodon", "bluesky", "linkedin", "x", "facebook", "instagram", "threads"],
									"enumLabels": {
										"mastodon": "Mastodon",
										"bluesky": "Bluesky",
										"linkedin": "LinkedIn",
										"x": "X",
										"facebook": "Facebook page",
										"instagram": "Instagram business",
										"threads": "Threads"
									}
								},
								{
									"key": "weFollowThem",
									"label": "We follow them",
									"enum": ["yes", "no", "unknown"],
									"enumLabels": { "yes": "Yes", "no": "No", "unknown": "Cannot be checked" },
									"widget": "badge",
									"widgetProps": { "colorMap": { "yes": "success", "no": "warning", "unknown": "default" } }
								},
								{
									"key": "theyFollowUs",
									"label": "They follow us",
									"enum": ["yes", "no", "unknown"],
									"enumLabels": { "yes": "Yes", "no": "No", "unknown": "Cannot be checked" },
									"widget": "badge",
									"widgetProps": { "colorMap": { "yes": "success", "no": "warning", "unknown": "default" } }
								},
								{ "key": "reason", "label": "Reason" }
							],
							"emptyText": "Nothing to compare yet. Connect a social account and give a client a handle on the same network. Only Mastodon and Bluesky publish a follower list an audit can read; for the other networks this page will say so rather than guess."
						}
					}
				],
				"layout": [
					{ "id": 1, "widgetId": "connection-audit", "gridX": 0, "gridY": 0, "gridWidth": 12, "gridHeight": 8 }
				]
			}
		}
	]
}
