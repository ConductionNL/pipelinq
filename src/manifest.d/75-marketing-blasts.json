						"formatter": "userDisplayName"
					}
				},
				"documentationUrl": "https://pipelinq.conduction.nl",
				"selectable": true,
				"rowRoute": "BlastMonitor",
				"addLabel": "New newsletter",
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": true,
				"showMassCopy": false,
				"showMassDelete": false,
				"countText": "{shown} of {total} newsletters · open and click rate from our own measurements · newest first",
				"sortKey": "scheduledFor",
				"sortOrder": "desc",
				"searchPlaceholder": "Search this list",
