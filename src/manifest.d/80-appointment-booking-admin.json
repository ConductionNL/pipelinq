{
	"menu": [
		{
			"id": "BookingsGroup",
			"label": "Appointments",
			"icon": "icon-calendar",
			"order": 150,
			"children": [
				{
					"id": "Services",
					"label": "Services",
					"icon": "icon-toggle-pictures",
					"route": "Services"
				},
				{
					"id": "Resources",
					"label": "Resources",
					"icon": "icon-user",
					"route": "Resources"
				},
				{
					"id": "Bookings",
					"label": "Bookings",
					"icon": "icon-calendar",
					"route": "Bookings"
				}
			]
		}
	],
	"pages": [
		{
			"id": "Services",
			"_note": "Service catalogue as a declarative type:index page (pipelinq-views-to-declarative-r2). price→EUR currency, durationMinutes→duration format, status→badge, bookableOnline→boolean. 'New service' navigates to the bespoke ServiceDetail create form (id:'new'); row open navigates to ServiceDetail. ServiceDetail stays custom (multiStep sub-table editor + policy cards + cache-invalidation hook).",
			"route": "/services",
			"type": "index",
			"title": "Services",
			"config": {
				"register": "pipelinq",
				"schema": "service",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"columns": [
					"name",
					{ "key": "durationMinutes", "label": "Duration", "format": { "style": "duration", "unit": "minutes" } },
					{ "key": "price", "label": "Price", "format": { "style": "currency", "currency": "EUR", "decimals": 2 } },
					{ "key": "bookableOnline", "label": "Online", "type": "boolean" },
					{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "active": "success", "draft": "default", "archived": "default" } } }
				],
				"headerActions": [
					{ "id": "create", "label": "New service", "icon": "Plus", "handler": "navigate", "route": "ServiceDetail", "params": { "id": "new" } }
				],
				"actions": [
					{ "id": "view", "label": "Open", "icon": "Eye", "handler": "navigate", "route": "ServiceDetail" }
				]
			}
		},
		{
			"id": "ServiceDetail",
			"route": "/services/:id",
			"type": "custom",
			"title": "Service",
			"component": "ServiceDetailView",
			"config": {
				"register": "pipelinq",
				"schema": "service"
			}
		},
		{
			"id": "Resources",
			"_note": "Resource catalogue (staff/room/equipment) as a declarative type:index page (pipelinq-views-to-declarative-r2): the literal navigate params primitive now expresses 'New resource' → ResourceDetail id:'new'. type→badge, bookable→boolean, status→badge. ResourceDetail stays custom (workingHours grid + vacation list + cache invalidation).",
			"route": "/resources",
			"type": "index",
			"title": "Resources",
			"config": {
				"register": "pipelinq",
				"schema": "resource",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"columns": [
					"name",
					{ "key": "type", "label": "Type", "widget": "badge", "widgetProps": { "colorMap": { "staff": "primary", "room": "default", "equipment": "default" } } },
					{ "key": "bookable", "label": "Bookable", "type": "boolean" },
					{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "active": "success", "inactive": "default", "archived": "default" } } }
				],
				"headerActions": [
					{ "id": "create", "label": "New resource", "icon": "Plus", "handler": "navigate", "route": "ResourceDetail", "params": { "id": "new" } }
				],
				"actions": [
					{ "id": "view", "label": "Open", "icon": "Eye", "handler": "navigate", "route": "ResourceDetail" }
				]
			}
		},
		{
			"id": "ResourceDetail",
			"route": "/resources/:id",
			"type": "custom",
			"title": "Resource",
			"component": "ResourceDetailView",
			"config": {
				"register": "pipelinq",
				"schema": "resource"
			}
		},
		{
			"id": "Bookings",
			"_note": "Customer appointment ledger as a declarative type:index page (pipelinq-views-to-declarative-r1). View-only — admins create bookings through the public portal flow, never from this list — so the row click is the only action and navigates to the bespoke BookingDetail (reschedule/cancel/act), which stays custom.",
			"route": "/bookings",
			"type": "index",
			"title": "Bookings",
			"config": {
				"register": "pipelinq",
				"schema": "booking",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"columns": [
					"customerId",
					"serviceId",
					{ "key": "startAt", "label": "Datum/tijd", "format": "date-time" },
					{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "confirmed": "success", "completed": "primary", "no-show": "error", "pending-deposit": "warning", "cancelled-by-customer": "default", "cancelled-by-business": "default", "rescheduled": "default" } } },
					"source"
				],
				"actions": [
					{ "id": "view", "label": "Open", "icon": "Eye", "handler": "navigate", "route": "BookingDetail" }
				]
			}
		},
		{
			"id": "BookingDetail",
			"route": "/bookings/:id",
			"type": "custom",
			"title": "Booking",
			"component": "BookingDetailView",
			"config": {
				"register": "pipelinq",
				"schema": "booking"
			}
		}
	]
}
