{
	"menu": [
		{
			"id": "BookingsGroup",
			"label": "Appointments",
			"icon": "CalendarClockOutline",
			"order": 150,
			"children": [
				{
					"id": "Services",
					"label": "Services",
					"icon": "ViewGridOutline",
					"route": "Services"
				},
				{
					"id": "Resources",
					"label": "Resources",
					"icon": "SourceBranch",
					"route": "Resources"
				},
				{
					"id": "Bookings",
					"label": "Bookings",
					"icon": "Calendar",
					"route": "Bookings"
				}
			]
		}
	],
	"pages": [
		{
			"id": "Services",
			"_note": "Service catalogue as a declarative type:index page (pipelinq-views-to-declarative-r2). price→the service's own currency (reporting currency when unset; objectCurrency formatter), durationMinutes→duration format, status→badge with its x-enum-labels label (enumLabel formatter), bookableOnline→Yes/No (yesNo formatter; the library's check mark was too pale to see). 'New service' navigates to the bespoke ServiceDetail create form (id:'new'); row open navigates to ServiceDetail. ServiceDetail stays custom (multiStep sub-table editor + policy cards + cache-invalidation hook).",
			"route": "/services",
			"type": "index",
			"title": "Services and resources",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentService",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"selectable": true,
				"rowRoute": "ServiceDetail",
				"columns": [
					{
						"key": "name",
						"label": "Service",
						"secondary": "{description}"
					},
					{
						"key": "durationMinutes",
						"label": "Duration",
						"format": {
							"style": "number",
							"suffix": " min"
						}
					},
					{
						"key": "bufferBeforeMinutes",
						"label": "Buffer before / after",
						"format": {
							"style": "number",
							"suffix": " min"
						}
					},
					{
						"key": "price",
						"label": "Price",
						"formatter": "objectCurrency",
						"formatterOptions": {
							"decimals": 2
						}
					},
					{
						"key": "bookableOnline",
						"label": "Online",
						"type": "boolean",
						"formatter": "yesNo"
					},
					{
						"key": "requiredResourceTypes",
						"label": "Booked on",
						"sortable": false,
						"widget": "badge",
						"formatter": "enumLabel"
					},
					{
						"key": "status",
						"label": "Status",
						"formatter": "enumLabel",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"active": "success",
								"draft": "default",
								"archived": "default"
							}
						}
					}
				],
				"headerActions": [
					{
						"id": "create",
						"label": "New service",
						"icon": "Plus",
						"handler": "navigate",
						"route": "ServiceDetail",
						"params": {
							"id": "new"
						}
					}
				],
				"actions": [
					{
						"id": "view",
						"label": "View",
						"icon": "EyeOutline",
						"handler": "navigate",
						"route": "ServiceDetail"
					}
				],
				"showTitle": true,
				"showTitleIcon": false,
				"rowTitle": "plain",
				"countText": "{shown} of {total} services · what residents can book, and on whom or what it is booked",
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "Download"
					},
					{
						"action": "create",
						"variant": "primary",
						"icon": "Plus",
						"label": "New service"
					}
				],
				"searchPlaceholder": "Filter by service name",
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true,
						"showCount": true
					},
					{
						"label": "Online to book",
						"filter": {
							"bookableOnline": true
						},
						"showCount": true
					},
					{
						"label": "Draft",
						"filter": {
							"status": "draft"
						},
						"showCount": true
					},
					{
						"label": "Archived",
						"filter": {
							"status": "archived"
						},
						"showCount": true
					}
				],
				"viewSwitch": [
					"table",
					"cards",
					"board",
					"map"
				],
				"footerNote": "A service is booked on the resources with the requested kind and skills. A changed duration clears the saved free times.",
				"_boardNote": "Board look (PqServices, round 12): count line, quick filters with counts, the name with its description under it, the buffer and what a service is booked on.",
				"filterMenu": true
			}
		},
		{
			"id": "ServiceDetail",
			"route": "/services/:id",
			"type": "custom",
			"title": "Service",
			"component": "ServiceDetailView",
			"_note": "Uses CnDetailPage/CnDetailCard. The cached availability is expired on the server (AvailabilityCacheInvalidationListener). It derives display-only labels (formatDuration, formatCurrency, requiredSkillsLabel) that are not schema properties.",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentService"
			}
		},
		{
			"id": "Resources",
			"_note": "Resource catalogue (staff/room/equipment) as a declarative type:index page (pipelinq-views-to-declarative-r2): the literal navigate params primitive now expresses 'New resource' → ResourceDetail id:'new'. type→badge, bookable→boolean, status→badge. ResourceDetail stays custom (workingHours grid + vacation list + cache invalidation).",
			"route": "/resources",
			"type": "index",
			"title": "Resources",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentResource",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"selectable": false,
				"rowRoute": "ResourceDetail",
				"columns": [
					"name",
					{ "key": "type", "label": "Type", "widget": "badge", "widgetProps": { "colorMap": { "staff": "primary", "room": "default", "equipment": "default" } } },
					{ "key": "bookable", "label": "Bookable", "type": "boolean" },
					{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "active": "success", "inactive": "default", "archived": "default" } } }
				],
				"headerActions": [
					{ "id": "create", "label": "New resource", "icon": "Plus", "handler": "navigate", "route": "ResourceDetail", "params": { "id": "new" } }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "ResourceDetail" }
				]
			}
		},
		{
			"id": "ResourceDetail",
			"route": "/resources/:id",
			"type": "custom",
			"title": "Resource",
			"component": "ResourceDetailView",
			"_note": "The cached availability is expired on the server (AvailabilityCacheInvalidationListener). It holds a live useObjectSubscription so a concurrently edited resource updates in place.",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentResource"
			}
		},
		{
			"id": "Bookings",
			"_note": "Customer appointment ledger as a declarative type:index page (pipelinq-views-to-declarative-r1). View-only — admins create bookings through the public portal flow, never from this list — so the row click is the only action and navigates to the bespoke BookingDetail (reschedule/cancel/act), which stays custom.",
			"route": "/bookings",
			"type": "index",
			"title": "Bookings",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentBooking",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"selectable": false,
				"columns": [
					"customerId",
					"serviceId",
					{ "key": "startAt", "label": "Datum/tijd", "format": "date-time" },
					{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "confirmed": "success", "completed": "primary", "no-show": "error", "pending-deposit": "warning", "cancelled-by-customer": "default", "cancelled-by-business": "default", "rescheduled": "default" } } },
					"source"
				],
				"actions": [
					{ "id": "view", "label": "Open", "icon": "Eye", "handler": "navigate", "route": "BookingDetail" }
				]
			}
		},
		{
			"id": "BookingDetail",
			"_note": "Booking record as a declarative type:detail page (pipelinq-pos-mdm-detail-declarative). The booking's flat identity fields (status / source / startAt / endAt / depositAmount / notes / …) auto-render in the body via CnObjectDataWidget. What the auto-body cannot express is split over grid widgets built from BookingDetailSection parts (booking-and-service-pages): the Service/Customer name context and the resourceAssignments table. The Timeline tab is the library `timeline` widget: dated fields plus the audit trail. Notes are the notes leaf; the audit table is dropped, OpenRegister's activity is in the actions menu. lifecycleActions is NOT wired even though booking has an x-openregister-lifecycle: the transitions POST to /api/bookings/{id}/{action} endpoints in BookingService with side-effects (confirmation and reminder emails, no-show fees). The six actions are declared header actions gated by status and time (@now, @now+1h), one primary per state (Confirm deposit, Mark completed); Reschedule follows the new booking the endpoint answers (onSuccessRoute.idPath).",
			"route": "/bookings/:id",
			"type": "detail",
			"title": "Booking",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentBooking",
				"stageField": "status",
				"primaryActionByStage": { "pending-deposit": "booking-confirm-deposit", "confirmed": "booking-complete" },
				"headerActions": [
					{ "id": "booking-confirm-deposit", "label": "Confirm deposit", "type": "api-call", "icon": "Check", "url": "/apps/pipelinq/api/bookings/@objectId/confirm-deposit", "successMessage": "Deposit confirmed.", "visibleWhen": { "field": "status", "value": "pending-deposit" } },
					{ "id": "booking-complete", "label": "Mark completed", "type": "api-call", "icon": "Check", "url": "/apps/pipelinq/api/bookings/@objectId/complete", "successMessage": "Booking marked completed.", "visibleWhen": { "all": [{ "field": "status", "value": "confirmed" }, { "field": "endAt", "op": "lte", "value": "@now" }] } },
					{ "id": "booking-no-show", "label": "Mark no-show", "type": "api-call", "variant": "error", "url": "/apps/pipelinq/api/bookings/@objectId/no-show", "successMessage": "Booking marked as no-show.", "visibleWhen": { "all": [{ "field": "status", "value": "confirmed" }, { "field": "endAt", "op": "lte", "value": "@now" }] } },
					{ "id": "booking-reschedule", "label": "Reschedule", "type": "open-form", "endpoint": { "url": "/apps/pipelinq/api/bookings/@objectId/reschedule", "method": "POST" }, "formProperties": { "newStartAt": { "type": "string", "format": "date-time", "title": "New start time", "required": true } }, "onSuccessRoute": { "name": "BookingDetail", "idPath": "bookingId" }, "successMessage": "Booking rescheduled.", "visibleWhen": { "all": [{ "field": "status", "op": "in", "value": ["confirmed", "pending-deposit"] }, { "field": "endAt", "op": "gt", "value": "@now" }] } },
					{ "id": "booking-send-reminder", "label": "Send reminder", "type": "api-call", "url": "/apps/pipelinq/api/bookings/@objectId/send-reminder", "successMessage": "Reminder dispatched.", "visibleWhen": { "all": [{ "field": "status", "value": "confirmed" }, { "field": "startAt", "op": "gt", "value": "@now+1h" }] } },
					{ "id": "booking-cancel", "label": "Cancel booking", "type": "open-form", "variant": "error", "endpoint": { "url": "/apps/pipelinq/api/bookings/@objectId/cancel", "method": "POST" }, "formProperties": { "reason": { "type": "string", "title": "Cancellation reason" } }, "successMessage": "Booking cancelled.", "visibleWhen": { "all": [{ "field": "status", "op": "in", "value": ["confirmed", "pending-deposit"] }, { "field": "endAt", "op": "gt", "value": "@now" }] } }
				],
				"documentationUrl": "https://pipelinq.conduction.nl",
				"excludeFields": ["resourceAssignments", "statusHistory"],
				"_note": "Booking archetype (bespoke-detail-pages). An appointment booking is a scheduled service slot, so the body opens with the booking fields (status, source, startAt/endAt, customerId, serviceId, depositAmount, confirmation/reminder timestamps, cancellationReason) 8-wide beside a right column holding the deposit KPI stat above the related graph (service, resource, customer, previousBookingId reschedule chain), with Documents full-width for any signed intake / deposit receipt. IMPORTANT: no calendar body widget or tab — although a booking is time-bound, the booking schema declares NO calendar linkedType, and per the hard rule comms/scheduling leaves only appear when the schema declares them; the real schedule, the resourceAssignments/statusHistory arrays-on-object and the computed Timeline stay in the PRESERVED BookingDetailSection bodyWidget (after-data); the six time-gated admin actions are declared header actions (bespoke endpoints with side-effects, so not lifecycleActions).",
				"widgets": [
					{ "id": "booking-deposit", "type": "stat", "title": "Deposit", "icon": "Cash", "content": { "label": "Deposit", "format": { "style": "currency", "currency": "@config.currency", "decimals": 2 }, "source": { "register": "pipelinq", "schema": "appointmentBooking", "metric": "sum", "field": "depositAmount", "filter": { "id": "@objectId" } } } },
					{ "id": "booking-data", "type": "data", "title": "Booking", "icon": "Calendar", "content": { "title": "Booking", "columns": 2, "include": ["status", "source", "startAt", "endAt", "customerId", "serviceId", "depositAmount", "confirmationSentAt", "reminderSentAt", "cancellationReason", "notes", "internalNotes"], "overrides": { "customerId": { "label": "Customer", "formatter": "bookingCustomerName" }, "serviceId": { "label": "Service", "formatter": "bookingServiceName" }, "status": { "editable": false }, "startAt": { "editable": false }, "endAt": { "editable": false }, "confirmationSentAt": { "editable": false }, "reminderSentAt": { "editable": false }, "notes": { "label": "Note for the customer" }, "internalNotes": { "label": "Internal note (earlier)", "editable": false } } } },
					{ "id": "booking-context", "type": "BookingContextWidget", "title": "Service and customer", "icon": "AccountClockOutline", "content": { "title": "Service and customer" } },
					{ "id": "booking-related", "type": "related", "title": "Related", "icon": "LinkVariant" },
					{
						"id": "booking-tabs",
						"type": "tabs",
						"title": "Booking",
						"icon": "ViewDashboard",
						"_note": "The working surface of a booking, one tab at a time (pipelinq review E7). Timeline: the library `timeline` widget (nextcloud-vue 2.65): the booking's dated fields plus its audit trail, so every status change shows as a dated change with who made it (review E6). Notes: the notes leaf, as on LeadDetail, instead of the hand-written notes editor. The audit table is gone: OpenRegister's activity is in the actions menu (E6). Children stay out of `layout`.",
						"content": {
							"ariaLabel": "Booking",
							"tabs": [
								{ "widgetId": "booking-timeline", "label": "Timeline" },
								{ "widgetId": "booking-assignments", "label": "Resources" },
								{ "widgetId": "booking-notes", "label": "Notes" },
								{ "widgetId": "booking-files", "label": "Documents" }
							]
						}
					},
					{ "id": "booking-timeline", "type": "timeline", "title": "Timeline", "icon": "Timeline", "content": { "fields": [ { "field": "@self.created", "label": "Booking created" }, { "field": "depositPaidAt", "label": "Deposit cleared" }, { "field": "confirmationSentAt", "label": "Confirmation mail sent" }, { "field": "reminderSentAt", "label": "Reminder sent" }, { "field": "startAt", "label": "Starts" }, { "field": "endAt", "label": "Ends" }, { "field": "cancelledAt", "label": "Cancelled" }, { "field": "noShowFeeChargedAt", "label": "No-show fee charged" } ], "lists": [ { "field": "statusHistory", "dateField": "changedAt", "labelField": "status", "detailField": "reason" } ], "auditTrail": true, "order": "asc" } },
					{ "id": "booking-assignments", "type": "BookingAssignmentsWidget", "title": "Resource assignments", "icon": "AccountGroup", "content": {} },
					{ "id": "booking-notes", "type": "integration", "integrationId": "notes", "title": "Notes", "icon": "NoteTextOutline" },
					{ "id": "booking-files", "type": "integration", "integrationId": "files", "title": "Documents", "icon": "FolderOutline" }
				],
				"layout": [
					{ "id": "2", "widgetId": "booking-data",    "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "1", "widgetId": "booking-deposit", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "5", "widgetId": "booking-context", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 4 },
					{ "id": "3", "widgetId": "booking-related", "gridX": 8, "gridY": 6, "gridWidth": 4, "gridHeight": 3 },
					{ "id": "4", "widgetId": "booking-tabs",    "gridX": 0, "gridY": 6, "gridWidth": 8, "gridHeight": 10 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		}
	]
}
