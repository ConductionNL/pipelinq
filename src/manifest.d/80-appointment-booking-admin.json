{
	"menu": [
		{
			"id": "BookingsGroup",
			"label": "Appointments",
			"icon": "CalendarClockOutline",
			"order": 150,
			"children": [
				{
					"id": "Services",
					"label": "Services",
					"icon": "ViewGridOutline",
					"route": "Services"
				},
				{
					"id": "Resources",
					"label": "Resources",
					"icon": "SourceBranch",
					"route": "Resources"
				},
				{
					"id": "Bookings",
					"label": "Bookings",
					"icon": "Calendar",
					"route": "Bookings"
				},
				{
					"id": "WalkInQueue",
					"label": "Walk-in queue",
					"icon": "AccountClockOutline",
					"route": "WalkInQueue"
				}
			]
		}
	],
	"pages": [
		{
			"id": "Services",
			"_note": "Service catalogue as a declarative type:index page (pipelinq-views-to-declarative-r2). price→the service's own currency (reporting currency when unset; objectCurrency formatter), durationMinutes→duration format, status→badge with its x-enum-labels label (enumLabel formatter), bookableOnline→Yes/No (yesNo formatter; the library's check mark was too pale to see). 'New service' navigates to the bespoke ServiceDetail create form (id:'new'); row open navigates to ServiceDetail. ServiceDetail stays custom (multiStep sub-table editor + policy cards + cache-invalidation hook).",
			"route": "/services",
			"type": "index",
			"title": "Services and resources",
			"config": {
				"pageTabs": [
					{ "label": "Services", "route": "Services", "countFrom": { "register": "pipelinq", "schema": "appointmentService", "filter": {} } },
					{ "label": "Resources", "route": "Resources", "countFrom": { "register": "pipelinq", "schema": "appointmentResource", "filter": {} } }
				],
				"register": "pipelinq",
				"schema": "appointmentService",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"selectable": true,
				"rowRoute": "ServiceDetail",
				"columns": [
					{
						"key": "name",
						"label": "Service",
						"secondary": "{description}"
					},
					{
						"key": "durationMinutes",
						"label": "Duration",
						"format": {
							"style": "number",
							"suffix": " min"
						}
					},
					{
						"key": "bufferBeforeMinutes",
						"label": "Buffer before / after",
						"format": {
							"style": "number",
							"suffix": " min"
						}
					},
					{
						"key": "price",
						"label": "Price",
						"formatter": "objectCurrency",
						"formatterOptions": {
							"decimals": 2
						}
					},
					{
						"key": "bookableOnline",
						"label": "Online",
						"type": "boolean",
						"formatter": "yesNo"
					},
					{
						"key": "requiredResourceTypes",
						"label": "Booked on",
						"sortable": false,
						"widget": "badge",
						"formatter": "enumLabel"
					},
					{
						"key": "status",
						"label": "Status",
						"formatter": "enumLabel",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"active": "success",
								"draft": "default",
								"archived": "default"
							}
						}
					}
				],
				"headerActions": [
					{
						"id": "create",
						"label": "New service",
						"icon": "Plus",
						"handler": "navigate",
						"route": "ServiceDetail",
						"params": {
							"id": "new"
						}
					}
				],
				"actions": [
					{
						"id": "view",
						"label": "View",
						"icon": "EyeOutline",
						"handler": "navigate",
						"route": "ServiceDetail"
					}
				],
				"showTitle": true,
				"showTitleIcon": false,
				"rowTitle": "plain",
				"countText": "{shown} of {total} services · what residents can book, and on whom or what it is booked",
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "Download"
					},
					{
						"action": "actions-menu",
						"label": "Actions",
						"items": ["refresh", "documentation"]
					},
					{
						"action": "create",
						"variant": "primary",
						"icon": "Plus",
						"label": "New service"
					}
				],
				"searchPlaceholder": "Filter by service name",
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true,
						"showCount": true
					},
					{
						"label": "Online to book",
						"filter": {
							"bookableOnline": true
						},
						"showCount": true
					},
					{
						"label": "Draft",
						"filter": {
							"status": "draft"
						},
						"showCount": true
					},
					{
						"label": "Archived",
						"filter": {
							"status": "archived"
						},
						"showCount": true
					}
				],
				"viewSwitch": [
					"table",
					"cards",
					"board",
					"map"
				],
				"footerNote": "A service is booked on the resources with the requested kind and skills. A changed duration clears the saved free times.",
				"_boardNote": "Board look (PqServices, round 12): count line, quick filters with counts, the name with its description under it, the buffer and what a service is booked on.",
				"filterMenu": true
			}
		},
		{
			"id": "ServiceDetail",
			"route": "/services/:id",
			"type": "custom",
			"title": "Service",
			"component": "ServiceDetailView",
			"_note": "Uses CnDetailPage/CnDetailCard. The cached availability is expired on the server (AvailabilityCacheInvalidationListener). It derives display-only labels (formatDuration, formatCurrency, requiredSkillsLabel) that are not schema properties.",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentService"
			}
		},
		{
			"id": "Resources",
			"_note": "Resource catalogue (staff/room/equipment) as a declarative type:index page (pipelinq-views-to-declarative-r2): the literal navigate params primitive now expresses 'New resource' → ResourceDetail id:'new'. type→badge, bookable→boolean, status→badge. ResourceDetail stays custom (workingHours grid + vacation list + cache invalidation).",
			"route": "/resources",
			"type": "index",
			"title": "Resources",
			"config": {
				"pageTabs": [
					{ "label": "Services", "route": "Services", "countFrom": { "register": "pipelinq", "schema": "appointmentService", "filter": {} } },
					{ "label": "Resources", "route": "Resources", "countFrom": { "register": "pipelinq", "schema": "appointmentResource", "filter": {} } }
				],
				"register": "pipelinq",
				"schema": "appointmentResource",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"selectable": false,
				"rowRoute": "ResourceDetail",
				"columns": [
					"name",
					{ "key": "type", "label": "Type", "widget": "badge", "widgetProps": { "colorMap": { "staff": "primary", "room": "default", "equipment": "default" } } },
					{ "key": "bookable", "label": "Bookable", "type": "boolean" },
					{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "active": "success", "inactive": "default", "archived": "default" } } }
				],
				"headerActions": [
					{ "id": "create", "label": "New resource", "icon": "Plus", "handler": "navigate", "route": "ResourceDetail", "params": { "id": "new" } }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "ResourceDetail" }
				]
			}
		},
		{
			"id": "ResourceDetail",
			"route": "/resources/:id",
			"type": "custom",
			"title": "Resource",
			"component": "ResourceDetailView",
			"_note": "The cached availability is expired on the server (AvailabilityCacheInvalidationListener). It holds a live useObjectSubscription so a concurrently edited resource updates in place.",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentResource"
			}
		},
		{
			"id": "Bookings",
			"_note": "Customer appointment ledger as a declarative type:index page (pipelinq-views-to-declarative-r1). View-only — admins create bookings through the public portal flow, never from this list — so the row click is the only action and navigates to the bespoke BookingDetail (reschedule/cancel/act), which stays custom.",
			"route": "/bookings",
			"type": "index",
			"title": "Appointments",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentBooking",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"_boardNote": "PqAfspraken: the count line, the period chips with their counts, a selectable table that reads when, with whom, about what, where and with which handler, and a footer that says how appointments come in. The chips read the booking's own fields: the period from startAt, Mine from the handler (assignee), Unconfirmed from the awaiting-deposit status. 'This week' is the coming seven days, the window the filter tokens can name.",
				"showAdd": false,
				"showFormDialog": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": true,
				"showMassCopy": false,
				"showMassDelete": false,
				"selectable": true,
				"sortKey": "startAt",
				"sortOrder": "asc",
				"countText": "{shown} of {total} appointments · sorted by time",
				"searchPlaceholder": "Filter by customer or service",
				"headerButtons": [ { "action": "export", "label": "Download" } ],
				"rowTitle": "plain",
				"footerNote": "Customers book appointments in the portal. Open one to reschedule or cancel it.",
				"quickFilters": [
					{ "label": "Today", "activeLabel": "Period: today", "filter": { "startAt[gte]": "@today", "startAt[lt]": "@today+1d" }, "showCount": true },
					{ "label": "This week", "activeLabel": "Period: this week", "filter": { "startAt[gte]": "@today", "startAt[lt]": "@today+7d" }, "default": true, "showCount": true },
					{ "label": "Mine", "activeLabel": "Handler: me", "filter": { "assignee": "@me" }, "showCount": true },
					{ "label": "Unconfirmed", "activeLabel": "Status: unconfirmed", "filter": { "status": "pending-deposit" }, "showCount": true }
				],
				"columns": [
					{ "key": "startAt", "label": "When", "formatter": "bookingWhen", "secondary": "{startAt|weekday:today}", "cellClass": "cn-cell--strong" },
					{ "key": "customerId", "label": "With whom", "formatter": "bookingCustomerName" },
					{ "key": "subject", "label": "About", "secondary": "{source}", "cellClass": "cn-cell--strong" },
					{ "key": "location", "label": "Location or desk" },
					{ "key": "assignee", "label": "Handler", "formatter": "userDisplayName", "widget": "avatar", "widgetProps": { "user": true } },
					{ "key": "status", "label": "Status", "formatter": "enumLabel", "widget": "badge", "widgetProps": { "colorMap": { "confirmed": "success", "completed": "primary", "no-show": "error", "pending-deposit": "warning", "cancelled-by-customer": "default", "cancelled-by-business": "default", "rescheduled": "default" } } }
				],
				"actions": [
					{ "id": "view", "label": "Open", "icon": "Eye", "handler": "navigate", "route": "BookingDetail" }
				]
			}
		},
		{
			"id": "BookingDetail",
			"_note": "Booking record as a declarative type:detail page. The admin actions are the page's actionsComponent (BookingHeaderActions), not lifecycleActions: the real transitions POST to bespoke /api/bookings/{id}/{action} endpoints in BookingService with side-effects (confirmation and reminder mails, no-show fees) and time-window gating, and Reschedule creates a new booking and navigates to it; OpenRegister's /transition would only flip the status. Missing primitive: a declarative action that POSTs to a host-app endpoint with time-window gating and a navigate-to-the-new-object reload mode.",
			"route": "/bookings/:id",
			"type": "detail",
			"title": "Appointment",
			"actionsComponent": "BookingHeaderActions",
			"config": {
				"register": "pipelinq",
				"schema": "appointmentBooking",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"excludeFields": ["resourceAssignments", "statusHistory"],
				"_note": "Appointment page on the shared relation frame, as the PqAfspraak board draws it: the pills (Appointment and the status), the breadcrumb back to Appointments, the meta line with how it was booked, and the admin actions as a row of buttons under the title (BookingHeaderActions; the PqAfspraakVerplaatsen dialogs open from Reschedule and Cancel). One tab strip fills the body: Overview stacks the appointment data, the recent changes and the assigned resources; then Resources, Notes, Documents, Related and History. The customer and the when-and-where card are the side column. The deposit is a field of the data card, where the board shows it, instead of a stat card of its own.",
				"titleField": "subject",
				"follow": false,
				"breadcrumb": { "label": "Appointments", "route": "Bookings" },
				"typePill": { "text": "Appointment", "variant": "info" },
				"statusPill": { "field": "status", "colorMap": { "confirmed": "success", "completed": "primary", "no-show": "error", "pending-deposit": "warning", "cancelled-by-customer": "default", "cancelled-by-business": "default", "rescheduled": "default" }, "labels": { "pending-deposit": "Awaiting deposit", "confirmed": "Confirmed", "completed": "Finished", "no-show": "No-show", "cancelled-by-customer": "Cancelled by the customer", "cancelled-by-business": "Cancelled by us", "rescheduled": "Rescheduled" } },
				"headerMeta": "{startAt|weekday} · {startAt|time} to {endAt|time}",
				"tabsLabel": "Appointment",
				"layout": [
					{ "id": "1", "widgetId": "booking-panels", "gridX": 0, "gridY": 0, "gridWidth": 12, "gridHeight": 18, "showTitle": false }
				],
				"sideColumn": ["booking-context", "booking-when", "booking-request"],
				"widgets": [
					{
						"id": "booking-panels",
						"type": "tabs",
						"title": "Appointment",
						"icon": "CalendarClock",
						"_note": "One strip. Overview stacks the data card, the recent changes (the library timeline: the dated fields, the status history and the audit trail) and the assigned resources. Children stay out of `layout`, or the tabs widget and the grid would each render them once.",
						"content": {
							"ariaLabel": "Appointment",
							"tabs": [
								{ "widgetIds": ["booking-data", "booking-timeline", "booking-assignments"], "label": "Overview" },
								{ "widgetId": "booking-assignments", "label": "Resources" },
								{ "widgetId": "booking-notes", "label": "Notes" },
								{ "widgetId": "booking-files", "label": "Documents" },
								{ "widgetId": "booking-related", "label": "Related" },
								{ "widgetId": "booking-history", "label": "History" }
							]
						}
					},
					{ "id": "booking-data", "type": "data", "title": "Appointment details", "icon": "Calendar", "content": { "title": "Appointment details", "columns": 2, "include": ["serviceId", "customerId", "startAt", "endAt", "source", "depositAmount", "cancellationReason", "noShowFeeChargedAt", "confirmationSentAt", "reminderSentAt", "notes", "internalNotes"], "overrides": { "customerId": { "label": "Customer", "formatter": "bookingCustomerName" }, "serviceId": { "label": "Service", "formatter": "bookingServiceName" }, "startAt": { "label": "Starts", "editable": false }, "endAt": { "label": "Ends", "editable": false }, "source": { "label": "Booked via", "formatter": "enumLabel" }, "depositAmount": { "label": "Deposit", "formatter": "objectCurrency" }, "noShowFeeChargedAt": { "label": "No-show fee charged", "editable": false }, "confirmationSentAt": { "label": "Confirmation sent", "editable": false }, "reminderSentAt": { "label": "Reminder sent", "editable": false }, "notes": { "label": "Note for the customer" }, "internalNotes": { "label": "Internal note", "editable": false } } } },
					{ "id": "booking-timeline", "type": "timeline", "title": "Recent changes", "icon": "Timeline", "content": { "fields": [ { "field": "@self.created", "label": "Booking created" }, { "field": "depositPaidAt", "label": "Deposit cleared" }, { "field": "confirmationSentAt", "label": "Confirmation mail sent" }, { "field": "reminderSentAt", "label": "Reminder sent" }, { "field": "startAt", "label": "Starts" }, { "field": "endAt", "label": "Ends" }, { "field": "cancelledAt", "label": "Cancelled" }, { "field": "noShowFeeChargedAt", "label": "No-show fee charged" } ], "lists": [ { "field": "statusHistory", "dateField": "changedAt", "labelField": "status", "detailField": "reason" } ], "auditTrail": false, "order": "desc" } },
					{ "id": "booking-assignments", "type": "BookingAssignmentsWidget", "title": "Assigned resources", "icon": "AccountGroup", "content": {} },
					{ "id": "booking-notes", "type": "integration", "integrationId": "notes", "title": "Notes", "icon": "NoteTextOutline" },
					{ "id": "booking-files", "type": "integration", "integrationId": "files", "title": "Documents", "icon": "FolderOutline" },
					{ "id": "booking-related", "type": "related", "title": "Related", "icon": "LinkVariant" },
					{ "id": "booking-history", "type": "audit-trail", "title": "History", "icon": "History" },
					{ "id": "booking-context", "type": "BookingCustomerWidget", "title": "Customer", "icon": "AccountBoxOutline", "content": {} },
					{ "id": "booking-when", "type": "BookingWhenWidget", "title": "When and where", "icon": "MapMarkerCheck", "content": {} },
					{
						"id": "booking-request",
						"type": "record-list",
						"title": "Linked request",
						"icon": "LinkVariant",
						"_note": "PqAfspraak's Gekoppeld verzoek: the ticket the booking names in `ticket`, read by its id (`_ids`), opening its own page. A booking without one says so.",
						"content": {
							"register": "pipelinq",
							"schema": "ticket",
							"filter": { "_ids": ["@object.ticket"] },
							"limit": 1,
							"title": "{title}",
							"meta": "{reference} · {status} · {assignee|user}",
							"rowRoute": "TicketDetail",
							"emptyText": "Not linked to a request"
						}
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		}
	]
}
