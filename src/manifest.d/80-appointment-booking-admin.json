{
	"menu": [
		{
			"id": "BookingsGroup",
			"label": "Appointments",
			"icon": "icon-calendar",
			"order": 150,
			"children": [
				{
					"id": "Services",
					"label": "Services",
					"icon": "icon-toggle-pictures",
					"route": "Services"
				},
				{
					"id": "Resources",
					"label": "Resources",
					"icon": "icon-user",
					"route": "Resources"
				},
				{
					"id": "Bookings",
					"label": "Bookings",
					"icon": "icon-calendar",
					"route": "Bookings"
				}
			]
		}
	],
	"pages": [
		{
			"id": "Services",
			"route": "/services",
			"type": "custom",
			"title": "Services",
			"component": "ServiceListView",
			"config": {
				"register": "pipelinq",
				"schema": "service"
			}
		},
		{
			"id": "ServiceDetail",
			"route": "/services/:id",
			"type": "custom",
			"title": "Service",
			"component": "ServiceDetailView",
			"config": {
				"register": "pipelinq",
				"schema": "service"
			}
		},
		{
			"id": "Resources",
			"route": "/resources",
			"type": "custom",
			"title": "Resources",
			"component": "ResourceListView",
			"_note": "KEPT custom (pipelinq-views-to-declarative-r1): the 'New resource' entry point navigates to ResourceDetail with id:'new', and the declarative type:index navigate handler always passes {id: row[rowKey]} so it cannot express a create-to-detail action. Convertible once nc-vue gains a static-params header action (or a ResourceNew page is added).",
			"config": {
				"register": "pipelinq",
				"schema": "resource"
			}
		},
		{
			"id": "ResourceDetail",
			"route": "/resources/:id",
			"type": "custom",
			"title": "Resource",
			"component": "ResourceDetailView",
			"config": {
				"register": "pipelinq",
				"schema": "resource"
			}
		},
		{
			"id": "Bookings",
			"_note": "Customer appointment ledger as a declarative type:index page (pipelinq-views-to-declarative-r1). View-only — admins create bookings through the public portal flow, never from this list — so the row click is the only action and navigates to the bespoke BookingDetail (reschedule/cancel/act), which stays custom.",
			"route": "/bookings",
			"type": "index",
			"title": "Bookings",
			"config": {
				"register": "pipelinq",
				"schema": "booking",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"showAdd": false,
				"showFormDialog": false,
				"showViewAction": false,
				"showEditAction": false,
				"showCopyAction": false,
				"showDeleteAction": false,
				"showMassImport": false,
				"showMassExport": false,
				"showMassCopy": false,
				"showMassDelete": false,
				"columns": [
					"customerId",
					"serviceId",
					{ "key": "startAt", "label": "Datum/tijd", "format": "date-time" },
					{ "key": "status", "label": "Status", "widget": "badge", "widgetProps": { "colorMap": { "confirmed": "success", "completed": "primary", "no-show": "error", "pending-deposit": "warning", "cancelled-by-customer": "default", "cancelled-by-business": "default", "rescheduled": "default" } } },
					"source"
				],
				"actions": [
					{ "id": "view", "label": "Open", "icon": "Eye", "handler": "navigate", "route": "BookingDetail" }
				]
			}
		},
		{
			"id": "BookingDetail",
			"route": "/bookings/:id",
			"type": "custom",
			"title": "Booking",
			"component": "BookingDetailView",
			"config": {
				"register": "pipelinq",
				"schema": "booking"
			}
		}
	]
}
