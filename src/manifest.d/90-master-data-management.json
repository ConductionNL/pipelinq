  "pages": [
    {
      "id": "MdmMasterEntities",
      "route": "/mdm/master-entities",
      "type": "custom",
      "title": "Master entities",
      "component": "MdmMasterEntityListView"
    },
    {
      "id": "MdmMasterEntityDetail",
      "_note": "Master-entity steward view as a declarative type:detail page (pipelinq-pos-mdm-detail-declarative). The masterEntity register object's flat fields (masterId / entityType / status / dataQualityScore / aliases / mergedFrom / lastReviewedAt / gdprNotes / …) auto-render in the body via CnObjectDataWidget; the raw source-record children render as a relatedCollections table (sourceRecord, FK 'currentMasterEntity'). The parts no declarative primitive can express live in one kind:'section' bodyWidget (MdmGoldenRecordSection, after-related): the server-COMPUTED golden record (merge-rule survivorship) with per-attribute provenance (sourceSystem + trustTier) and the derived linkage lineage, fetched from GET /api/mdm/entities/{id} (a projection, not stored flat on the schema), plus the 'Resolve conflicts' modal which recomputes the golden record on save. KEPT-AS-NOTE: the golden-record / provenance / lineage are a host-app PROJECTION (computed, not stored), so they stay in the section rather than the auto-body. Missing primitive: a type:detail variant whose body is sourced from a host-app projection endpoint rather than (only) the OR object. The instance-wide Data quality + Duplicate candidates dashboards stay their own pages — they are not entity-scoped in the source.",
      "route": "/mdm/master-entities/:id",
      "type": "detail",
      "title": "Master entity",
      "config": {
        "register": "pipelinq",
        "schema": "masterEntity",
        "documentationUrl": "https://pipelinq.conduction.nl",
        "relatedCollections": [
          {
            "title": "Source records",
            "register": "pipelinq",
            "schema": "sourceRecord",
            "filter": { "currentMasterEntity": "@objectId" },
            "sort": { "field": "lastSeen", "dir": "desc" },
            "columns": [
              { "key": "sourceSystem", "label": "Source system" },
              { "key": "nativeId", "label": "Native id" },
              { "key": "lastSeen", "label": "Last seen" },
              { "key": "linkageMethod", "label": "Linkage" },
              { "key": "linkageConfidence", "label": "Confidence" }
            ],
            "limit": 200
          }
        ],
        "bodyWidgets": [
          {
            "id": "mdm-golden-record",
            "component": "MdmGoldenRecordSection",
            "title": "Golden record",
            "placement": "after-related",
            "props": { "masterId": "@objectId" }
          }
        ],
        "sidebar": true
      }
    },
    {
      "id": "MdmDataQuality",
      "_note": "Master-data quality monitor as a declarative type:dashboard page (pipelinq-dashboards-declarative). The four headline KPIs (average quality score + good/fair/poor entity buckets) are endpoint-bound stat widgets reading GET /apps/pipelinq/api/mdm/dashboard. The non-KPI surfaces the stat grid cannot express — the lowest-quality master-entity table, the sync-queue health cards, and the dead-letter retry table (Retry POSTs to /api/mdm/sync-queue/{id}/retry, a re-queue side-effect) — live in one kind:'section' bodyWidget (MdmDataQualitySection), which self-fetches the same endpoint so a Retry refreshes it in place. No period filter — the dashboard is an instance-wide snapshot.",
      "route": "/mdm/data-quality",
      "type": "dashboard",
      "title": "Data quality",
      "config": {
        "documentationUrl": "https://pipelinq.conduction.nl",
        "widgets": [
          { "id": "mdm-avg-score", "type": "stat", "title": "Average quality score", "content": { "label": "Average quality score", "caption": "0.00 – 1.00", "icon": "ChartLine", "valueColor": "#0082c9", "format": { "style": "number", "decimals": 2 }, "source": { "kind": "endpoint", "url": "/apps/pipelinq/api/mdm/dashboard", "path": "averageScore" } } },
          { "id": "mdm-good", "type": "stat", "title": "Good", "content": { "label": "Good (> 0.8)", "caption": "entities", "icon": "CheckCircle", "valueColor": "#2d7d46", "format": { "style": "number", "decimals": 0 }, "source": { "kind": "endpoint", "url": "/apps/pipelinq/api/mdm/dashboard", "path": "buckets.good" } } },
          { "id": "mdm-fair", "type": "stat", "title": "Fair", "content": { "label": "Fair (0.6 – 0.8)", "caption": "entities", "icon": "AlertCircle", "valueColor": "#c28a00", "format": { "style": "number", "decimals": 0 }, "source": { "kind": "endpoint", "url": "/apps/pipelinq/api/mdm/dashboard", "path": "buckets.fair" } } },
          { "id": "mdm-poor", "type": "stat", "title": "Poor", "content": { "label": "Poor (< 0.6)", "caption": "entities", "icon": "AlertOctagon", "valueColor": "#c0392b", "format": { "style": "number", "decimals": 0 }, "source": { "kind": "endpoint", "url": "/apps/pipelinq/api/mdm/dashboard", "path": "buckets.poor" } } }
        ],
        "layout": [
          { "id": 1, "widgetId": "mdm-avg-score", "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
          { "id": 2, "widgetId": "mdm-good", "gridX": 3, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
          { "id": 3, "widgetId": "mdm-fair", "gridX": 6, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false },
          { "id": 4, "widgetId": "mdm-poor", "gridX": 9, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": false }
        ],
        "bodyWidgets": [
          { "id": "mdm-data-quality-section", "component": "MdmDataQualitySection", "placement": "after-grid" }
        ]
      }
    },
    {
      "id": "MdmDuplicates",
      "route": "/mdm/duplicates",
      "type": "custom",
      "title": "Duplicate candidates",
      "component": "MdmDuplicateCandidatesDashboard"
    },
    {
      "id": "MdmTrustConfig",
      "route": "/mdm/trust-config",
      "type": "list",
      "title": "Trust configuration",
      "register": "pipelinq",
      "schema": "trustConfiguration"
    },
    {
      "id": "MdmSyncQueue",
      "route": "/mdm/sync-queue",
      "type": "custom",
      "title": "Sync queue",
      "component": "MdmSyncQueueAdmin"
    }
  ]
}
