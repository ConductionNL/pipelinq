{
	"menu": [
		{
			"id": "MarketingGroup",
			"label": "Marketing",
			"order": 130,
			"children": [
				{
					"id": "Journeys",
					"label": "Journeys",
					"icon": "MapMarkerPath",
					"route": "Journeys",
					"order": 50
				}
			]
		}
	],
	"pages": [
		{
			"id": "Journeys",
			"_note": "Journey list as a declarative type:index page (marketing-integrated-campaigns). Add and the row Edit action open JourneyFormDialog in the form-dialog slot instead of the declarative dialog: every write compiles the journey into an OpenRegister flow, which only POST and PATCH /api/journeys do. A journey written through the object API would be stored and never compiled, and a journey that is never compiled looks exactly like one whose trigger has not fired yet. The flow status column is what makes that difference visible in the list.",
			"route": "/journeys",
			"type": "index",
			"title": "Journeys",
			"slots": {
				"form-dialog": "JourneyFormDialog"
			},
			"config": {
				"register": "pipelinq",
				"schema": "journey",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"addLabel": "New journey",
				"showEditAction": true,
				"showCopyAction": false,
				"sortKey": "name",
				"sortOrder": "asc",
				"countText": "{shown} of {total} journeys",
				"searchPlaceholder": "Filter by name",
				"filterMenu": true,
				"viewModes": [
					"table",
					"cards",
					"board",
					"map"
				],
				"board": {
					"statusField": "status"
				},
				"footerNote": "A journey is a trigger, a wait, a condition and an action. Pipelinq turns it into a flow.",
				"headerButtons": [
					{
						"action": "export",
						"label": "Download",
						"icon": "Download"
					},
					{
						"action": "add",
						"variant": "primary",
						"label": "New journey"
					}
				],
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true,
						"showCount": true
					},
					{
						"label": "Active",
						"filter": {
							"status": "active"
						},
						"showCount": true
					},
					{
						"label": "Paused",
						"filter": {
							"status": "paused"
						},
						"showCount": true
					},
					{
						"label": "Draft",
						"filter": {
							"status": "draft"
						},
						"showCount": true
					}
				],
				"columns": [
					"name",
					{
						"key": "status",
						"label": "Status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"active": "success",
								"paused": "warning",
								"draft": "default"
							}
						}
					},
					{
						"key": "flowStatus",
						"label": "Flow status",
						"widget": "badge",
						"widgetProps": {
							"colorMap": {
								"compiled": "success",
								"not_compiled": "default",
								"engine_missing": "error",
								"refused": "error"
							}
						}
					},
					"waitFor"
				],
				"map": {
					"center": [
						52.09,
						5.12
					]
				}
			}
		},
		{
			"id": "JourneyDetail",
			"_note": "Journey record as a declarative type:detail page (ADR-062 grid). The journey's own fields auto-render in the details widget. Edit opens JourneyFormDialog in the form-dialog slot, the same dialog as the Journeys index, so an edit here is compiled too. The run log is a bodyWidgets section rather than a declarative object-list widget because the refusal reason has to be read as words: 'suppressed_dunning' is the answer to the only question a marketer asks here, and a raw enum value does not answer it. Its props carry @objectId, the only token that resolves on a detail page.",
			"route": "/journeys/:id",
			"type": "detail",
			"title": "Journey",
			"slots": {
				"form-dialog": "JourneyFormDialog"
			},
			"config": {
				"register": "pipelinq",
				"schema": "journey",
				"documentationUrl": "https://pipelinq.conduction.nl",
				"widgets": [
					{
						"id": "journey-panels",
						"type": "tabs",
						"title": "Journey",
						"content": {
							"ariaLabel": "Journey",
							"tabs": [
								{
									"widgetIds": [
										"journey-data",
										"journey-steps",
										"journey-runs"
									],
									"label": "Overview"
								},
								{
									"widgetId": "journey-history",
									"label": "History"
								}
							]
						}
					},
					{
						"id": "journey-data",
						"type": "data",
						"title": "Journey details",
						"content": {
							"title": "Journey details",
							"columns": 3,
							"include": [
								"description",
								"status",
								"audienceSegment",
								"waitFor",
								"flowStatus",
								"flowError"
							],
							"overrides": {
								"description": {
									"order": 0
								},
								"status": {
									"order": 1,
									"enumLabels": {
										"draft": "Draft",
										"active": "Active",
										"paused": "Paused"
									}
								},
								"audienceSegment": {
									"order": 2
								},
								"waitFor": {
									"order": 3
								},
								"flowStatus": {
									"order": 4
								},
								"flowError": {
									"order": 5
								}
							}
						}
					},
					{
						"id": "journey-steps",
						"type": "facts",
						"title": "Steps",
						"content": {
							"fields": [
								{
									"path": "trigger.kind",
									"label": "Trigger",
									"map": {
										"leadStageChanged": "A lead moved stage",
										"contractRenewalWindow": "A contract is up for renewal",
										"listConfirmed": "Someone confirmed a subscription",
										"shillinqSignal": "A bookkeeping signal changed"
									}
								},
								{
									"path": "waitFor",
									"label": "Wait"
								},
								{
									"path": "condition.field",
									"label": "Condition"
								},
								{
									"path": "action.kind",
									"label": "Action",
									"map": {
										"sendMailing": "Send a mailing",
										"createTask": "Create a task"
									}
								}
							]
						}
					},
					{
						"id": "journey-history",
						"type": "timeline",
						"title": "History",
						"content": {
							"auditTrail": true,
							"order": "desc"
						}
					},
					{
						"id": "journey-flow",
						"type": "facts",
						"title": "Flow",
						"content": {
							"fields": [
								{
									"as": "text",
									"path": "flowStatus",
									"map": {
										"compiled": "Converted into a flow. The flow runs in the automation engine.",
										"not_compiled": "Not converted into a flow yet.",
										"engine_missing": "There is no automation engine to run the flow.",
										"refused": "The automation engine refused the flow."
									}
								}
							],
							"link": {
								"label": "Open flow",
								"route": {
									"name": "FlowDetail",
									"params": {
										"id": "@object.flowUuid"
									}
								}
							}
						}
					},
					{
						"id": "journey-side-history",
						"type": "timeline",
						"title": "History",
						"content": {
							"auditTrail": true,
							"order": "desc",
							"limit": 3
						}
					},
					{
						"id": "journey-runs",
						"type": "object-table",
						"title": "What this journey did",
						"subtitle": "Every contact reached and every contact refused",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/journeys/@objectId/runs", "responsePath": "results" },
							"note": "{counts.sent} sent, {counts.refused} refused, {counts.failed} failed",
							"columns": [
								{ "key": "contactId", "label": "Reached contact", "widget": "fkResolve", "widgetProps": { "register": "pipelinq", "schema": "contact", "labelField": "name" } },
								{ "key": "occurredAt", "label": "When", "widget": "date", "widgetProps": { "showTime": true } },
								{
									"key": "state",
									"label": "Outcome",
									"widget": "badge",
									"enum": ["sent", "refused", "task-created", "failed"],
									"enumLabels": { "sent": "Sent", "refused": "Refused", "task-created": "Task created", "failed": "Failed" },
									"widgetProps": { "colorMap": { "sent": "success", "task-created": "success", "refused": "warning", "failed": "error" } }
								},
								{
									"key": "reason",
									"label": "Why",
									"enum": ["no_consent", "suppressed_dunning", "template_missing", "no_transport", "no_email", "transport_rejected"],
									"enumLabels": {
										"no_consent": "No consent for this channel",
										"suppressed_dunning": "Skipped: this customer is being chased for an unpaid invoice",
										"template_missing": "The template is gone",
										"no_transport": "No mail transport is configured",
										"no_email": "This contact has no email address",
										"transport_rejected": "The mail transport rejected it"
									}
								}
							],
							"emptyText": "This journey has not run yet. Once its trigger fires, every contact it reached and every contact it refused is listed here."
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "journey-panels",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 8,
						"showTitle": false,
						"sizeToContent": true
					}
				],
				"sidebar": {
					"enabled": false
				},
				"follow": false,
				"showTypeEyebrow": false,
				"statusPill": {
					"field": "status",
					"labels": {
						"draft": "Draft",
						"active": "Active",
						"paused": "Paused"
					},
					"colorMap": {
						"active": "success",
						"paused": "warning",
						"draft": "default"
					}
				},
				"breadcrumb": {
					"label": "Journeys",
					"route": "Journeys",
					"separator": "/"
				},
				"actionsMenu": {
					"label": "More"
				},
				"sideColumn": [
					"journey-flow",
					"journey-side-history"
				],
				"headerActions": [
					{
						"id": "pause",
						"label": "Pause",
						"icon": "Pause",
						"type": "api-call",
						"url": "/apps/pipelinq/api/journeys/@objectId/status",
						"method": "POST",
						"payload": {
							"status": "paused"
						},
						"visibleWhen": {
							"field": "status",
							"value": "active"
						},
						"successMessage": "The journey is paused. Its flow no longer runs.",
						"errorMessage": "Could not pause this journey."
					},
					{
						"id": "resume",
						"label": "Resume",
						"icon": "Play",
						"type": "api-call",
						"url": "/apps/pipelinq/api/journeys/@objectId/status",
						"method": "POST",
						"payload": {
							"status": "active"
						},
						"visibleWhen": {
							"field": "status",
							"value": "paused"
						},
						"successMessage": "The journey runs again.",
						"errorMessage": "Could not resume this journey."
					}
				],
				"quickActions": [
					"pause",
					"resume"
				]
			}
		},
		{
			"id": "WeeklyReviewPage",
			"_note": "The weekly marketing review (marketing-integrated-campaigns, ADR-112), reached as a card on the Reports page. One GET /apps/pipelinq/api/weekly-review answers the summary, the three lists and the sources that held nothing, which the facts card names as missing data rather than a zero. Compose again posts to /generate and the page reads the new review.",
			"route": "/reports/weekly-review",
			"type": "dashboard",
			"title": "Weekly review",
			"config": {
				"documentationUrl": "https://pipelinq.conduction.nl",
				"headerActions": [
					{
						"id": "weekly-review-compose",
						"label": "Compose again",
						"type": "api-call",
						"method": "POST",
						"icon": "Refresh",
						"url": "/apps/pipelinq/api/weekly-review/generate",
						"successMessage": "The weekly review was composed again"
					}
				],
				"widgets": [
					{
						"id": "weekly-review-summary",
						"type": "facts",
						"title": "Weekly review",
						"icon": "CalendarWeek",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/weekly-review" },
							"fields": [
								{ "label": "Week of", "path": "weekStarting", "format": "date-long" },
								{ "path": "summary", "as": "text" },
								{ "label": "An agent wrote this summary", "path": "agentAuthoredBy" },
								{
									"label": "Sources with nothing yet: missing data, not a zero",
									"path": "degraded",
									"format": "list"
								}
							],
							"emptyText": "No review yet. Send a mailing, publish a post or connect Search Console, and last week's numbers appear here."
						}
					},
					{
						"id": "weekly-review-highlights",
						"type": "record-list",
						"title": "What moved",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/weekly-review", "responsePath": "highlights" },
							"limit": 20,
							"emptyText": "Nothing moved last week."
						}
					},
					{
						"id": "weekly-review-suggestions",
						"type": "record-list",
						"title": "What to try",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/weekly-review", "responsePath": "suggestions" },
							"limit": 20,
							"emptyText": "No suggestions this week."
						}
					},
					{
						"id": "weekly-review-ideas",
						"type": "record-list",
						"title": "Topic ideas",
						"content": {
							"endpointSource": { "url": "/apps/pipelinq/api/weekly-review", "responsePath": "topicIdeas" },
							"limit": 20,
							"emptyText": "No topic ideas this week."
						}
					}
				],
				"layout": [
					{
						"id": 1,
						"widgetId": "weekly-review-summary",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 3
					},
					{
						"id": 2,
						"widgetId": "weekly-review-highlights",
						"gridX": 0,
						"gridY": 3,
						"gridWidth": 4,
						"gridHeight": 5
					},
					{
						"id": 3,
						"widgetId": "weekly-review-suggestions",
						"gridX": 4,
						"gridY": 3,
						"gridWidth": 4,
						"gridHeight": 5
					},
					{ "id": 4, "widgetId": "weekly-review-ideas", "gridX": 8, "gridY": 3, "gridWidth": 4, "gridHeight": 5 }
				]
			}
		}
	]
}
