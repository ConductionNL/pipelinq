{
	"$comment": "pipelinq's admin settings in the Zuiddrecht set, integrations, marketing and portal tabs, as PqBeheerKoppelingen, PqBeheerMarketing and PqBeheerPortaal draw them: the Asterisk telephony link, the WhatsApp and SMS senders with their monthly budgets, and the service account their webhooks write as; the crawl source, Matomo and Search Console settings and the two mail transports; the three portal tenants, Mijn Zuiddrecht as the default one, with three portal accounts from the cast and their latest audit events. No secret is in the set: the telephony webhook secret, provider keys and the Matomo token live on their OpenConnector sources and the credential broker, and settings only name them. A tenant's live or concept state has no field, so it is not here.",
	"serviceAccounts": [
		{
			"key": "berichten",
			"uid": "pipelinq-berichten",
			"displayName": "Pipelinq berichten",
			"groups": [
				"pipelinq-messaging-service"
			]
		}
	],
	"appConfig": [
		{
			"key": "messaging_service_account",
			"value": "pipelinq-berichten"
		},
		{
			"key": "search.crawl_source",
			"value": "own-site"
		},
		{
			"key": "search.striking_min_impressions",
			"value": "100"
		},
		{
			"key": "matomo.base_url",
			"value": "https://statistiek.zuiddrecht.example"
		},
		{
			"key": "matomo.site_id",
			"value": "1"
		},
		{
			"key": "matomo.source_id",
			"value": "matomo"
		},
		{
			"key": "matomo.credential_ref",
			"value": "b7f4a9c1-2d3e-4f5a-8b6c-7d8e9f0a1b2c"
		},
		{
			"key": "blast.traffic_portal",
			"value": "mijn-zuiddrecht"
		},
		{
			"key": "search.gsc.properties",
			"value": "sc-domain:zuiddrecht.example"
		},
		{
			"key": "search.gsc.last_import_at",
			"value": "{{datetime:-1 06:10}}"
		}
	],
	"objects": [
		{
			"key": "cti-asterisk",
			"register": "pipelinq",
			"schema": "ctiAdapterConfig",
			"data": {
				"platform": "asterisk",
				"api_base_url": "https://pbx.zuiddrecht.example/ari",
				"auth_method": "webhook-secret",
				"credentials_ref": "asterisk-zuiddrecht",
				"screen_pop_enabled": true,
				"screen_pop_delay_ms": 500,
				"click_to_dial_enabled": true,
				"default_outbound_caller_id": "+31786123400",
				"default_country_code": "NL"
			}
		},
		{
			"key": "kanaal-whatsapp-zuiddrecht",
			"register": "pipelinq",
			"schema": "channelProvider",
			"data": {
				"kind": "whatsapp-cloud-api",
				"vendor": "meta",
				"displayName": "WhatsApp Zuiddrecht",
				"sourceId": "meta-whatsapp",
				"phoneNumber": "+31786123400",
				"active": true,
				"sandbox": false,
				"priority": 1
			}
		},
		{
			"key": "kanaal-sms-zuiddrecht",
			"register": "pipelinq",
			"schema": "channelProvider",
			"data": {
				"kind": "sms",
