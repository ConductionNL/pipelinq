		{
			"key": "flow-lead-gekwalificeerd",
			"data": {
				"name": "Lead gekwalificeerd: eigenaar informeren",
				"description": "Stuurt de eigenaar van een lead een melding zodra de lead naar de fase Gekwalificeerd gaat.",
				"trigger": "object.updated",
				"triggerRegister": "pipelinq",
				"triggerSchema": "lead",
				"nodes": [
					{
						"id": "start",
						"type": "openregister.trigger-object",
						"name": "Gestart door een gewijzigde lead",
						"position": {
							"x": 40,
							"y": 40
						},
						"config": {
							"event": "object.updated",
							"register": "pipelinq",
							"schema": "lead"
						}
					},
					{
						"id": "fase",
						"type": "openregister.switch",
						"name": "Is de lead gekwalificeerd?",
						"position": {
							"x": 40,
							"y": 160
						},
						"config": {
							"field": "stage"
						},
						"exits": [
							{
								"id": "ja",
								"condition": "stage == 'Gekwalificeerd'"
							},
							{
								"id": "nee"
							}
						]
					},
					{
						"id": "informeren",
						"type": "openregister.send-notification",
						"name": "Eigenaar informeren",
						"position": {
							"x": 40,
							"y": 280
						},
						"config": {
							"to": "assignee"
						}
					},
					{
						"id": "end",
						"type": "openregister.end",
						"name": "Einde",
						"position": {
							"x": 40,
							"y": 400
						}
					}
				],
				"edges": [
					{
						"from": "start",
						"to": "fase"
					},
					{
						"from": "fase",
						"to": "informeren",
						"fromExit": "ja"
					},
					{
						"from": "fase",
						"to": "end",
						"fromExit": "nee"
					},
					{
						"from": "informeren",
						"to": "end"
					}
				],
				"runs": [
					{
						"subject": "{{object:lead-woonportaal.id}}",
						"subjectRegister": "pipelinq",
						"subjectSchema": "lead",
