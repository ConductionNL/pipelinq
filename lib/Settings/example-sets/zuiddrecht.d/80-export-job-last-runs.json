{
	"$comment": "The last and next run of each BI export job as PqBiExport draws them (exportJob 1.1.0, pq-b5): a real run writes these fields, a seeded job has to carry them. They agree with the exportRun records of part 67, dated from the day the set is viewed as the board's 7 October is.",
	"changes": [
		{
			"key": "laatste-run-tickets",
			"register": "pipelinq",
			"schema": "exportJob",
			"where": {
				"name": "Tickets voor het KCC-dashboard"
			},
			"set": {
				"lastRunStatus": "succeeded",
				"lastRunAt": "{{datetime:0 02:04}}",
				"lastRunRows": 12480,
				"lastRunFiles": 1,
				"nextRunAt": "{{datetime:1 02:00}}"
			}
		},
		{
