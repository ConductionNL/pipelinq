{
	"$comment": "pipelinq's flows in the Zuiddrecht set besides the acknowledgement flow of 44-flows.json, as PqFlows lists them: reminders before a deadline, the Woo hand-over to dossiq, routing reports to the right team, linking a contact moment to its resident, escalating complaints after five working days (its last run stopped early), asking for feedback after closing, and the team lead's weekly overview. The appointment reminder is the paused one: a set stores every flow switched off, and this one stays unpublished.",
	"flows": [
		{
			"key": "flow-termijn-herinneren",
			"data": {
				"name": "Behandelaar een dag voor de termijn herinneren",
				"description": "Kijkt elke ochtend om 07:00 welke open tickets morgen hun termijn halen, en stuurt de behandelaar een herinnering.",
				"trigger": "schedule",
				"cron": "0 7 * * *",
				"nodes": [
					{
						"id": "start",
						"type": "openregister.trigger-schedule",
						"name": "Elke dag om 07:00",
						"position": {
							"x": 40,
							"y": 40
						},
						"config": {
							"cron": "0 7 * * *"
						}
					},
					{
						"id": "zoeken",
						"type": "openregister.object-read",
						"name": "Open tickets met de termijn morgen",
						"position": {
							"x": 40,
							"y": 160
						},
						"config": {
							"register": "pipelinq",
							"schema": "ticket",
							"filter": "slaDeadline == tomorrow and status != 'resolved'"
						}
					},
					{
						"id": "elk",
						"type": "openregister.iterate",
						"name": "Voor elk ticket",
						"position": {
							"x": 40,
							"y": 280
						}
					},
					{
						"id": "herinneren",
						"type": "openregister.send-notification",
						"name": "Behandelaar herinneren",
						"position": {
							"x": 40,
							"y": 400
						},
						"config": {
							"to": "assignee"
						}
					},
					{
						"id": "end",
						"type": "openregister.end",
						"name": "Einde",
						"position": {
							"x": 40,
							"y": 520
						}
					}
				],
				"edges": [
					{
						"from": "start",
						"to": "zoeken"
					},
					{
						"from": "zoeken",
						"to": "elk"
					},
					{
						"from": "elk",
						"to": "herinneren"
					},
					{
						"from": "herinneren",
						"to": "end"
					}
				]
			}
		},
		{
			"key": "flow-woo-naar-dossiq",
			"data": {
				"name": "Woo-vraag overdragen aan dossiq",
				"description": "Als een ticket de soort Woo-vraag krijgt, maakt de flow er een Woo-verzoek van in dossiq en koppelt het zaaknummer terug aan het ticket.",
				"trigger": "object.updated",
				"triggerRegister": "pipelinq",
				"triggerSchema": "ticket",
				"nodes": [
					{
						"id": "start",
						"type": "openregister.trigger-object",
						"name": "Gestart door een gewijzigd ticket",
						"position": {
							"x": 40,
							"y": 40
						},
						"config": {
							"event": "object.updated",
							"register": "pipelinq",
							"schema": "ticket"
						}
					},
					{
						"id": "soort",
						"type": "openregister.switch",
						"name": "Is het een Woo-vraag?",
						"position": {
							"x": 40,
							"y": 160
						},
						"config": {
							"field": "soort"
						},
						"exits": [
							{
								"id": "woo",
								"condition": "soort == 'Woo-vraag'"
							},
							{
								"id": "anders"
							}
						]
					},
					{
						"id": "zaak",
						"type": "openregister.object-write",
						"name": "Woo-verzoek aanmaken in dossiq",
						"position": {
							"x": 40,
							"y": 280
						},
						"config": {
							"target": "dossiq"
						}
					},
					{
						"id": "koppelen",
						"type": "openregister.link-object",
						"name": "Zaak aan het ticket koppelen",
						"position": {
							"x": 40,
							"y": 400
						}
					},
					{
						"id": "end",
						"type": "openregister.end",
						"name": "Einde",
						"position": {
							"x": 40,
							"y": 520
						}
					}
				],
				"edges": [
					{
						"from": "start",
						"to": "soort"
					},
					{
						"from": "soort",
						"to": "zaak",
						"fromExit": "woo"
					},
					{
						"from": "soort",
						"to": "end",
						"fromExit": "anders"
					},
					{
						"from": "zaak",
						"to": "koppelen"
					},
					{
						"from": "koppelen",
						"to": "end"
					}
				]
			}
		},
