			"where": {
				"listId": "{{object:verzendlijst-ondernemers.id}}",
				"email": "joke@smitbloemen.example"
			},
			"set": {
				"contactId": "{{object:contact-joke-smit.id}}"
			}
		},
		{
			"key": "abonnement-ondernemers-anna-devries-contact",
			"register": "pipelinq",
