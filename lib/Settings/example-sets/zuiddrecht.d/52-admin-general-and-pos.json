				"userId": "{{cast:pieter.uid}}",
				"skills": [
					"{{object:vaardigheid-bouwvergunningen.id}}",
					"{{object:vaardigheid-burgerzaken.id}}"
				],
				"maxConcurrent": 8,
				"isAvailable": true
			}
		},
