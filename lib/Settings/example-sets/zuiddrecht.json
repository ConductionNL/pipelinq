{
	"set": "zuiddrecht",
	"$comment": "pipelinq's part of the Zuiddrecht example set: the cast's residents and businesses as clients, the businesses' contact people, and the work of KCC employee daan: a phone question from Henk with the call itself, a question from Sanne about her Woo request, a complaint from Fatima, and a lead for CloudGemeente B.V. with Mark as contact. The lead goes into the default pipeline 'Sales' that pipelinq ships. contactsUid is each cast member's own contactsUid; it names no Contacts card until a later pipelinq:contacts:sync writes one with that uid. appConfig makes the cast's KCC group the CRM group and the BRP group, so daan works as an agent; crm_read_group lets dossiq's case handlers (dossiq-medewerkers) read the parties, contact moments and indicators their cases show, with no CRM write right; remove puts the old values back. Install with `occ openregister:example-set:install zuiddrecht` (openregister PR #4603); pipelinq's own `pipelinq:demo:seed` is separate and unchanged. The BI export part (board PqBiExport): two destinations, a data warehouse and a regional data lake, and four export jobs on them; three run on a schedule and the leads job is switched off.",
	"appConfig": [
		{
			"key": "crm_group",
			"value": "{{cast:kcc.gid}}"
		},
		{
			"key": "crm_read_group",
			"value": "dossiq-medewerkers"
		},
		{
			"key": "brp.allowed_groups",
			"value": "{{cast:kcc.gid}}"
		}
	],
	"objects": [
		{
			"key": "client-henk",
			"register": "pipelinq",
			"schema": "client",
			"data": {
				"name": "{{cast:henk.displayName}}",
				"type": "person",
				"email": "{{cast:henk.email}}",
				"address": "{{cast:henk.address.street}} {{cast:henk.address.number}}, {{cast:henk.address.postcode}} {{cast:henk.address.city}}",
				"contactsUid": "{{cast:henk.contactsUid}}",
				"lifecycleStage": "customer",
				"accountStatus": "active",
				"preferredChannel": "phone",
				"language": "nl",
				"correspondenceLanguage": "nl",
				"notes": "Belt liever dan dat hij mailt. Zijn dochter Linda Bakker helpt hem soms."
			}
		},
		{
			"key": "client-sanne",
			"register": "pipelinq",
			"schema": "client",
			"data": {
				"name": "{{cast:sanne.displayName}}",
				"type": "person",
				"email": "{{cast:sanne.email}}",
				"address": "{{cast:sanne.address.street}} {{cast:sanne.address.number}}, {{cast:sanne.address.postcode}} {{cast:sanne.address.city}}",
				"contactsUid": "{{cast:sanne.contactsUid}}",
				"lifecycleStage": "customer",
				"accountStatus": "active",
				"preferredChannel": "email",
				"language": "nl",
				"correspondenceLanguage": "nl",
				"notes": "Heeft een Woo-verzoek lopen over de verlichting van het fietspad aan de Lindelaan."
			}
		},
		{
			"key": "client-fatima",
			"register": "pipelinq",
			"schema": "client",
			"data": {
				"name": "{{cast:fatima.displayName}}",
				"type": "person",
				"email": "{{cast:fatima.email}}",
				"address": "{{cast:fatima.address.street}} {{cast:fatima.address.number}}, {{cast:fatima.address.postcode}} {{cast:fatima.address.city}}",
				"contactsUid": "{{cast:fatima.contactsUid}}",
				"lifecycleStage": "customer",
				"accountStatus": "active",
				"preferredChannel": "phone",
				"language": "nl",
				"correspondenceLanguage": "nl",
				"notes": "Wil graag uitleg in eenvoudige taal."
			}
		},
		{
			"key": "client-slagerij",
			"register": "pipelinq",
			"schema": "client",
			"data": {
				"name": "{{cast:slagerij.name}}",
				"type": "organization",
				"email": "{{cast:slagerij.email}}",
				"address": "{{cast:slagerij.address.street}} {{cast:slagerij.address.number}}, {{cast:slagerij.address.postcode}} {{cast:slagerij.address.city}}",
				"industry": [
					"{{cast:slagerij.sbi.description}}"
				],
				"contactsUid": "{{cast:slagerij.contactsUid}}",
				"lifecycleStage": "customer",
				"accountStatus": "active",
				"accountOwner": "{{cast:daan.uid}}",
				"preferredChannel": "email",
				"language": "nl",
				"correspondenceLanguage": "nl",
				"notes": "KVK-nummer {{cast:slagerij.kvk}}."
			}
		},
		{
			"key": "contact-janwillem",
			"register": "pipelinq",
			"schema": "contact",
			"data": {
				"name": "{{cast:janwillem.displayName}}",
				"email": "{{cast:janwillem.email}}",
				"role": "Eigenaar",
				"client": "{{object:client-slagerij.id}}",
				"contactsUid": "{{cast:janwillem.contactsUid}}",
				"preferredChannel": "email",
				"language": "nl",
				"correspondenceLanguage": "nl"
			}
		},
		{
			"key": "client-cloudgemeente",
			"register": "pipelinq",
			"schema": "client",
			"data": {
				"name": "{{cast:cloudgemeente.name}}",
				"type": "organization",
				"email": "{{cast:cloudgemeente.email}}",
				"address": "{{cast:cloudgemeente.address.street}} {{cast:cloudgemeente.address.number}}, {{cast:cloudgemeente.address.postcode}} {{cast:cloudgemeente.address.city}}",
				"industry": [
					"{{cast:cloudgemeente.sbi.description}}"
				],
				"contactsUid": "{{cast:cloudgemeente.contactsUid}}",
				"lifecycleStage": "customer",
				"accountStatus": "active",
				"accountOwner": "{{cast:daan.uid}}",
				"preferredChannel": "email",
				"language": "nl",
				"correspondenceLanguage": "nl",
				"notes": "KVK-nummer {{cast:cloudgemeente.kvk}}.",
				"website": "https://cloudgemeente.zuiddrecht.example"
			}
		},
		{
			"key": "contact-mark",
			"register": "pipelinq",
			"schema": "contact",
			"data": {
				"name": "{{cast:mark.displayName}}",
				"email": "{{cast:mark.email}}",
				"role": "Directeur",
				"client": "{{object:client-cloudgemeente.id}}",
				"contactsUid": "{{cast:mark.contactsUid}}",
				"preferredChannel": "email",
				"language": "nl",
				"correspondenceLanguage": "nl"
			}
		},
		{
			"key": "client-vandam",
			"register": "pipelinq",
			"schema": "client",
			"data": {
				"name": "{{cast:vandam.name}}",
				"type": "organization",
				"email": "{{cast:vandam.email}}",
				"address": "{{cast:vandam.address.street}} {{cast:vandam.address.number}}, {{cast:vandam.address.postcode}} {{cast:vandam.address.city}}",
				"industry": [
					"{{cast:vandam.sbi.description}}"
				],
				"contactsUid": "{{cast:vandam.contactsUid}}",
				"lifecycleStage": "customer",
				"accountStatus": "active",
				"accountOwner": "{{cast:daan.uid}}",
				"preferredChannel": "email",
				"language": "nl",
				"correspondenceLanguage": "nl",
				"notes": "KVK-nummer {{cast:vandam.kvk}}."
			}
		},
		{
			"key": "contact-karin",
			"register": "pipelinq",
			"schema": "contact",
			"data": {
				"name": "{{cast:karin.displayName}}",
				"email": "{{cast:karin.email}}",
				"role": "Bedrijfsleider",
				"client": "{{object:client-vandam.id}}",
				"contactsUid": "{{cast:karin.contactsUid}}",
				"preferredChannel": "email",
				"language": "nl",
				"correspondenceLanguage": "nl"
			}
		},
		{
			"key": "ticket-henk-afvalkalender",
			"register": "pipelinq",
			"schema": "ticket",
			"data": {
				"ticketType": "request",
				"title": "Vraag over de nieuwe afvalkalender",
				"description": "De heer Bakker belt. Hij heeft de afvalkalender voor 2027 niet gekregen en wil weten wanneer het grofvuil wordt opgehaald.",
				"client": "{{object:client-henk.id}}",
				"contactsUid": "{{cast:henk.contactsUid}}",
				"assignee": "{{cast:daan.uid}}",
				"status": "resolved",
				"priority": "normal",
				"channel": "phone",
				"category": "afval",
				"occurredAt": "{{datetime:-2 10:25}}",
				"resolvedAt": "{{datetime:-2 10:40}}",
				"resolution": "Ophaaldag voor grofvuil doorgegeven. De afvalkalender gaat per post naar de heer Bakker."
			}
		},
		{
			"key": "interaction-henk-afvalkalender",
			"register": "pipelinq",
			"schema": "ticket",
			"data": {
				"ticketType": "interaction",
				"title": "Telefoongesprek met Henk Bakker over de afvalkalender",
				"description": "Inkomend gesprek. Vraag over de afvalkalender en het grofvuil beantwoord.",
				"direction": "inbound",
				"channel": "telefoon",
				"outcome": "handled",
				"status": "resolved",
				"client": "{{object:client-henk.id}}",
				"contactsUid": "{{cast:henk.contactsUid}}",
				"assignee": "{{cast:daan.uid}}",
				"occurredAt": "{{datetime:-2 10:25}}",
				"duration": "PT15M",
				"parentTicket": "{{object:ticket-henk-afvalkalender.id}}"
			}
		},
		{
			"key": "ticket-sanne-woo",
			"register": "pipelinq",
			"schema": "ticket",
			"data": {
				"ticketType": "request",
				"title": "Vraag over de stand van het Woo-verzoek fietspad Lindelaan",
				"description": "Mevrouw De Vries vraagt wanneer zij een besluit krijgt op haar Woo-verzoek over de verlichting van het fietspad aan de Lindelaan.",
				"client": "{{object:client-sanne.id}}",
				"contactsUid": "{{cast:sanne.contactsUid}}",
				"assignee": "{{cast:daan.uid}}",
				"status": "in_progress",
				"priority": "normal",
				"channel": "email",
				"category": "woo",
				"occurredAt": "{{datetime:-1 09:12}}",
				"slaDeadline": "{{datetime:2 17:00}}",
				"notes": "Navraag gedaan bij {{cast:thomas.displayName}} ({{cast:thomas.function}}) over de termijn. Antwoord volgt."
			}
		},
		{
			"key": "ticket-fatima-klacht",
			"register": "pipelinq",
			"schema": "ticket",
			"data": {
				"ticketType": "complaint",
				"title": "Klacht over een moeilijke brief",
				"description": "Mevrouw El-Amrani begrijpt de brief over de afvalstoffenheffing 2027 niet. Zij vindt dat de gemeente te moeilijke woorden gebruikt en wil dat iemand het uitlegt.",
				"client": "{{object:client-fatima.id}}",
				"contactsUid": "{{cast:fatima.contactsUid}}",
				"assignee": "{{cast:daan.uid}}",
				"status": "new",
				"priority": "normal",
				"channel": "phone",
				"complaintCategory": "communication",
				"occurredAt": "{{datetime:0 11:05}}",
				"slaDeadline": "{{datetime:42 17:00}}"
			}
		},
		{
			"key": "lead-cloudgemeente",
			"register": "pipelinq",
			"schema": "lead",
			"lookups": {
				"pipeline": {
					"schema": "pipeline",
					"where": {
						"title": "Sales",
						"isDefault": true
					}
				}
			},
			"data": {
				"title": "Kantoorruimte voor CloudGemeente B.V.",
				"description": "CloudGemeente B.V. groeit en zoekt in Zuiddrecht kantoorruimte voor vijftien extra werkplekken. Mark Visser vraagt welke panden en regelingen er zijn.",
				"client": "{{object:client-cloudgemeente.id}}",
				"contact": "{{object:contact-mark.id}}",
				"source": "email",
				"pipeline": "{{lookup:pipeline}}",
				"stage": "Gekwalificeerd",
				"stageOrder": 2,
				"status": "open",
				"priority": "normal",
				"probability": 30,
				"expectedCloseDate": "{{date:45}}",
				"assignee": "{{cast:daan.uid}}",
				"stageEnteredAt": "{{datetime:-3 14:00}}",
				"category": "bedrijfsvestiging"
			}
		},
		{
			"key": "export-destination-warehouse",
			"register": "pipelinq",
			"schema": "exportDestination",
			"data": {
				"name": "Datawarehouse",
				"type": "postgres",
				"pathTemplate": "pipelinq/{schema}/{date}",
				"compression": "none",
				"encryptionEnabled": true,
				"validationStatus": "valid",
				"connectorSourceId": "zuiddrecht-datawarehouse"
			}
		},
		{
			"key": "export-destination-datalake",
			"register": "pipelinq",
			"schema": "exportDestination",
			"data": {
				"name": "Regionaal datameer",
				"type": "azure_data_lake",
				"pathTemplate": "zuiddrecht/pipelinq/{schema}/{date}",
				"compression": "gzip",
				"encryptionEnabled": true,
				"validationStatus": "valid",
				"connectorSourceId": "zuiddrecht-datameer"
			}
		},
		{
			"key": "export-job-kcc-tickets",
			"register": "pipelinq",
			"schema": "exportJob",
			"data": {
				"name": "Tickets voor het KCC-dashboard",
				"description": "Elke nacht de tickets en klanten voor het dashboard van het klantcontactcentrum.",
				"sourceSchemas": [
					"ticket",
					"client"
				],
				"destinationId": "{{object:export-destination-warehouse.id}}",
				"format": "parquet",
				"mode": "incremental",
				"incrementalWatermarkColumn": "@self.updated",
				"scheduleCron": "0 2 * * *",
				"enabled": true,
				"createdBy": "{{cast:daan.uid}}",
				"createdAt": "{{datetime:-30 09:00}}"
			}
		},
		{
			"key": "export-job-contacts-per-channel",
			"register": "pipelinq",
			"schema": "exportJob",
			"data": {
				"name": "Contactmomenten per kanaal",
				"description": "Elk uur de contactmomenten, voor de kanaalrapportage.",
				"sourceSchemas": [
					"ticket"
				],
				"destinationId": "{{object:export-destination-warehouse.id}}",
				"format": "parquet",
				"mode": "incremental",
				"incrementalWatermarkColumn": "@self.updated",
				"scheduleCron": "@hourly",
				"rowFilterExpression": "ticketType = 'interaction'",
				"enabled": true,
				"createdBy": "{{cast:daan.uid}}",
				"createdAt": "{{datetime:-30 09:00}}"
			}
		},
		{
			"key": "export-job-appointments",
			"register": "pipelinq",
			"schema": "exportJob",
			"data": {
				"name": "Afspraken en niet verschenen",
				"description": "Elke maandag alle afspraken, met wie niet verscheen.",
				"sourceSchemas": [
					"appointmentBooking"
				],
				"destinationId": "{{object:export-destination-datalake.id}}",
				"format": "csv",
				"mode": "full",
				"scheduleCron": "0 3 * * 1",
				"enabled": true,
				"createdBy": "{{cast:daan.uid}}",
				"createdAt": "{{datetime:-30 09:00}}"
			}
		},
		{
			"key": "export-job-leads",
			"register": "pipelinq",
			"schema": "exportJob",
			"data": {
				"name": "Leads en waarde in de pijplijn",
				"description": "Elke nacht de leads met hun fase en waarde. Staat uit tot de verbinding weer werkt.",
				"sourceSchemas": [
					"lead",
					"pipeline"
				],
				"destinationId": "{{object:export-destination-warehouse.id}}",
				"format": "jsonl",
				"mode": "full",
				"scheduleCron": "@daily",
				"enabled": false,
				"createdBy": "{{cast:daan.uid}}",
				"createdAt": "{{datetime:-30 09:00}}"
			}
		}
	]
}
