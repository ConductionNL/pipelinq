			"key": "ticket-henk-afvalkalender",
			"register": "pipelinq",
			"schema": "ticket",
			"data": {
				"ticketType": "request",
				"title": "Vraag over de nieuwe afvalkalender",
				"description": "De heer Bakker belt. Hij heeft de afvalkalender voor 2027 niet gekregen en wil weten wanneer het grofvuil wordt opgehaald.",
				"client": "{{object:client-henk.id}}",
				"contactsUid": "example-set-zuiddrecht-henk",
				"assignee": "{{cast:daan.uid}}",
				"status": "resolved",
				"priority": "normal",
				"channel": "phone",
				"category": "afval",
				"occurredAt": "{{datetime:-2 10:25}}",
				"resolvedAt": "{{datetime:-2 10:40}}",
				"resolution": "Ophaaldag voor grofvuil doorgegeven. De afvalkalender gaat per post naar de heer Bakker."
			}
		},
		{
			"key": "interaction-henk-afvalkalender",
			"register": "pipelinq",
			"schema": "ticket",
			"data": {
				"ticketType": "interaction",
				"title": "Telefoongesprek met Henk Bakker over de afvalkalender",
				"description": "Inkomend gesprek. Vraag over de afvalkalender en het grofvuil beantwoord.",
				"direction": "inbound",
				"channel": "telefoon",
				"outcome": "handled",
				"status": "resolved",
				"client": "{{object:client-henk.id}}",
				"contactsUid": "example-set-zuiddrecht-henk",
				"assignee": "{{cast:daan.uid}}",
				"occurredAt": "{{datetime:-2 10:25}}",
				"duration": "PT15M",
				"parentTicket": "{{object:ticket-henk-afvalkalender.id}}"
			}
		},
		{
			"key": "ticket-sanne-woo",
			"register": "pipelinq",
			"schema": "ticket",
			"data": {
				"ticketType": "request",
				"title": "Vraag over de stand van het Woo-verzoek fietspad Lindelaan",
