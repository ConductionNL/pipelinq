{
	"set": "zuiddrecht",
	"$comment": "pipelinq's part of the Zuiddrecht example set: the cast's residents and businesses as clients, the businesses' contact people, and the work of KCC employee daan: a phone question from Henk with the call itself, a question from Sanne about her Woo request, a complaint from Fatima, and a lead for CloudGemeente B.V. with Mark as contact. The lead goes into the default pipeline 'Sales' that pipelinq ships. contactsUid holds a marked stand-in until the loader can create Contacts vCards. Install with `occ openregister:example-set:install zuiddrecht` (openregister PR #4603); pipelinq's own `pipelinq:demo:seed` is separate and unchanged.",
	"objects": [
		{
			"key": "client-henk",
			"register": "pipelinq",
			"schema": "client",
			"data": {
				"name": "{{cast:henk.displayName}}",
				"type": "person",
				"email": "{{cast:henk.email}}",
				"address": "{{cast:henk.address.street}} {{cast:henk.address.number}}, {{cast:henk.address.postcode}} {{cast:henk.address.city}}",
				"contactsUid": "example-set-zuiddrecht-henk",
				"lifecycleStage": "customer",
				"accountStatus": "active",
				"preferredChannel": "phone",
				"language": "nl",
				"correspondenceLanguage": "nl",
				"notes": "Belt liever dan dat hij mailt. Zijn dochter Linda Bakker helpt hem soms."
			}
		},
		{
			"key": "client-sanne",
			"register": "pipelinq",
			"schema": "client",
			"data": {
				"name": "{{cast:sanne.displayName}}",
				"type": "person",
				"email": "{{cast:sanne.email}}",
				"address": "{{cast:sanne.address.street}} {{cast:sanne.address.number}}, {{cast:sanne.address.postcode}} {{cast:sanne.address.city}}",
				"contactsUid": "example-set-zuiddrecht-sanne",
