              "property": "reporterPhone",
              "type": "tel",
              "maxLength": 64
            },
            {
              "field": "organisation",
              "property": "reporterOrganisation",
              "type": "text",
              "maxLength": 255
            },
            {
              "field": "pageUrl",
              "property": "sourceUrl",
              "type": "text",
              "maxLength": 2048
            }
          ],
          "fixed": {
            "ticketType": "request",
            "channel": "website",
            "status": "new",
            "source": "website-partner"
          }
        },
        "fieldFallbacks": {
          "title": [
            "organisation",
            "contactName",
            "contactEmail"
          ]
        },
        "requireAnyOf": [
          "message",
          "contactEmail"
        ]
      },
      {
        "@self": {
          "register": "pipelinq",
          "schema": "webForm",
          "slug": "web-form-website-contact"
        },
        "title": "Contact form on the website",
        "key": "website-contact",
        "status": "published",
        "audience": "public",
        "destination": {
          "register": "pipelinq",
          "schema": "ticket"
        },
        "mapping": {
          "fields": [
            {
              "field": "title",
              "property": "title",
              "type": "text",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "field": "message",
              "property": "description",
              "type": "textarea",
              "maxLength": 20000
            },
            {
              "field": "contactName",
              "property": "reporterName",
              "type": "text",
              "maxLength": 255
            },
            {
              "field": "contactEmail",
              "property": "reporterEmail",
              "type": "email",
              "maxLength": 255
            },
            {
