{
  "_meta": {
    "spdx-license": "EUPL-1.2",
    "spdx-copyright": "2026 Conduction B.V.",
    "description": "openspec change pipelinq-open-client-on-contactmoment. An inbound call or email notifies the handling user and the sales group, in Nextcloud and as a background web push, with a primary 'Open client' button that OpenRegister resolves through the ticket's `client` relation. The rules first lived on the `contactmoment` schema, which unify-ticket-supertype folded into `ticket`; they are declared here on `ticket`, filtered on the contact-moment channel values `telefoon` and `email`, and address `assignee`, the ticket's handler field (the retired schema called it `agent`)."
  },
  "components": {
    "schemas": {
      "ticket": {
        "slug": "ticket",
        "x-openregister-notifications": {
          "incomingCall": {
            "trigger": {
              "type": "created",
              "filter": {
                "field": "channel",
                "operator": "equals",
                "value": "telefoon"
              }
            },
            "enabled": true,
            "originApp": "pipelinq",
            "channels": [
              "nc-notification",
              "web-push"
            ],
            "recipients": [
              {
                "kind": "field",
                "field": "assignee"
              },
              {
                "kind": "groups",
                "groups": [
                  "sales"
                ]
              }
            ],
            "subject": {
              "nl": "Inkomende oproep van {{client}}",
              "en": "Incoming call from {{client}}"
            },
            "actions": [
              {
                "label": {
                  "nl": "Klant openen",
                  "en": "Open client"
                },
                "primary": true,
                "target": {
                  "kind": "object-detail",
                  "object": {
                    "kind": "relation",
                    "field": "client"
                  }
                }
              }
            ]
          },
          "incomingEmail": {
            "trigger": {
              "type": "created",
              "filter": {
                "field": "channel",
                "operator": "equals",
                "value": "email"
              }
            },
            "enabled": true,
            "originApp": "pipelinq",
            "channels": [
              "nc-notification",
              "web-push"
            ],
            "recipients": [
              {
                "kind": "field",
                "field": "assignee"
              },
              {
                "kind": "groups",
                "groups": [
                  "sales"
                ]
              }
            ],
            "subject": {
              "nl": "Inkomende e-mail van {{client}}",
              "en": "Incoming email from {{client}}"
            },
            "actions": [
              {
                "label": {
                  "nl": "Klant openen",
                  "en": "Open client"
                },
                "primary": true,
                "target": {
                  "kind": "object-detail",
                  "object": {
                    "kind": "relation",
                    "field": "client"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
