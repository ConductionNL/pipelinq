{
  "components": {
    "registers": {
      "pipelinq": {
        "schemas": [
          "zgwEndpoint",
          "zgwClient",
          "nrcAbonnement",
          "zgwResourceMapping"
        ]
      }
    },
    "schemas": {
      "zgwEndpoint": {
        "slug": "zgwEndpoint",
        "title": "ZGW Endpoint",
        "icon": "Server",
        "version": "1.0.0",
        "summary": "Configuration profile for a single ZGW deployment per gemeente (ZRC/DRC/BRC/ZTC/AC/NRC component URLs).",
        "description": "Tracks the per-gemeente ZGW deployment configuration: the six component base URLs (ZRC, DRC, BRC, ZTC, AC, NRC), the bound ZgwClient credential reference, the actief/readOnly write toggles, and the optional mTLS material. Used by ZgwApiClient + ZrcClient + DrcClient + BrcClient + ZtcClient + AcClient + NrcSubscriptionService to address the right host per call. One endpoint per gemeente (gemeenteCode is the natural key); coexistence-validator gates against same-gemeente double write paths versus stuf-zkn-bg-adapter. Mapped to Schema.org SoftwareApplication for register tooling.",
        "@type": "schema:SoftwareApplication",
        "required": [
          "naam",
          "gemeenteCode",
          "componenten",
          "clientId"
        ],
        "properties": {
          "naam": {
            "type": "string",
            "description": "Display name (e.g. 'Gemeente Zoetermeer - Open Zaak (Dimpact)')",
            "maxLength": 200,
            "facetable": true,
            "title": "Naam"
          },
          "gemeenteCode": {
            "type": "string",
            "description": "4-digit CBS gemeente code (e.g. '0637' for Zoetermeer)",
            "maxLength": 8,
            "facetable": true,
            "title": "Gemeente Code"
          },
          "componenten": {
            "type": "object",
            "description": "Component base URLs (each a full base URL with no trailing slash)",
            "properties": {
              "zrc": {
                "type": "string",
                "format": "uri",
                "title": "Zrc",
                "description": "Zrc for this record."
              },
              "drc": {
                "type": "string",
                "format": "uri",
                "title": "Drc",
                "description": "Drc for this record."
              },
              "brc": {
                "type": "string",
                "format": "uri",
                "title": "Brc",
                "description": "Brc for this record."
              },
              "ztc": {
                "type": "string",
                "format": "uri",
                "title": "Ztc",
                "description": "Ztc for this record."
              },
              "ac": {
                "type": "string",
                "format": "uri",
                "title": "Ac",
                "description": "Ac for this record."
              },
              "nrc": {
                "type": "string",
                "format": "uri",
                "title": "Nrc",
                "description": "Nrc for this record."
              }
            },
            "title": "Componenten"
          },
          "clientId": {
            "type": "string",
            "description": "Reference to the zgwClient id used for this endpoint",
            "maxLength": 128,
            "facetable": true,
            "title": "Client ID"
          },
          "actief": {
            "type": "boolean",
            "description": "Whether this endpoint is the active write path (write=on) for its gemeente",
            "default": false,
            "facetable": true,
            "title": "Actief"
          },
          "readOnly": {
            "type": "boolean",
            "description": "If true the endpoint may only be read from; write operations raise",
            "default": false,
            "facetable": true,
            "title": "Read Only"
          },
          "mutualTlsCert": {
            "type": "string",
            "description": "Optional vault reference to the PEM-encoded mTLS client certificate",
            "maxLength": 256,
            "title": "Mutual Tls Cert"
          },
          "mutualTlsKey": {
            "type": "string",
            "description": "Optional vault reference to the PEM-encoded mTLS private key",
            "maxLength": 256,
            "title": "Mutual Tls Key"
          },
          "aangemaakt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 creation timestamp",
            "title": "Aangemaakt"
          }
        }
      },
      "zgwClient": {
        "slug": "zgwClient",
        "title": "ZGW Client Credentials",
        "icon": "Key",
        "version": "1.0.0",
        "summary": "JWT credentials per VNG-API-Common spec for one or more ZgwEndpoints.",
        "description": "Holds the clientIdentifier (issued by the gemeente IT team) and the vault reference to the HS256 client secret used to mint per-request JWTs against VNG-API-Common-protected ZGW components. No raw secret is stored on the schema — the secretKluisRef points at a vault entry maintained by gemeente operations. Used by ZgwApiClient.mintJwt() for every outbound call. Mapped to Schema.org CreativeWork (credential-like, no closer Schema.org equivalent).",
        "@type": "schema:CreativeWork",
        "required": [
          "clientIdentifier",
          "secretKluisRef",
          "userId",
          "userRepresentation"
        ],
        "properties": {
          "clientIdentifier": {
            "type": "string",
            "description": "VNG API-Common client identifier; sent in JWT iss + client_id claims",
            "maxLength": 128,
            "facetable": true,
            "title": "Client Identifier"
          },
          "secretKluisRef": {
            "type": "string",
            "description": "Vault reference (e.g. 'vault://zgw/zoetermeer/client-secret') to the HS256 client secret",
            "maxLength": 256,
            "title": "Secret Kluis Ref"
          },
          "userId": {
            "type": "string",
            "description": "VNG user_id claim value (e.g. 'pipelinq')",
            "maxLength": 128,
            "title": "User ID"
          },
          "userRepresentation": {
            "type": "string",
            "description": "Human-readable user_representation claim value",
            "maxLength": 256,
            "title": "User Representation"
          },
          "tokenLevensduurSeconden": {
            "type": "integer",
            "description": "JWT lifetime in seconds (default 3600)",
            "default": 3600,
            "minimum": 60,
            "maximum": 86400,
            "title": "Token Levensduur Seconden"
          },
          "aangemaakt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 creation timestamp",
            "title": "Aangemaakt"
          }
        }
      },
      "nrcAbonnement": {
        "slug": "nrcAbonnement",
        "title": "NRC Abonnement",
        "icon": "BellRing",
        "version": "1.0.0",
        "summary": "Subscription state for one NRC endpoint per ZgwEndpoint (callback URL, bearer secret ref, active kanalen).",
        "description": "Tracks the lifecycle of a single Notificaties Routerings Component (NRC) abonnement: the URL NRC returned on POST /api/v1/abonnement, the pipelinq inbox callback URL, the per-abonnement bearer token vault reference used to authenticate inbound NRC POSTs, the subscribed kanalen + filters, and the last-received timestamp. Owned by NrcSubscriptionService; consumed by ZgwNotificationController to authorise inbound callbacks and by NrcNotificationListener to dispatch them. Mapped to Schema.org Action for register tooling.",
        "@type": "schema:Action",
        "required": [
          "endpointId",
          "abonnementUrl",
          "callbackUrl",
          "callbackAuth",
          "kanalen"
        ],
        "properties": {
          "endpointId": {
            "type": "string",
            "description": "Reference to the parent ZgwEndpoint id",
            "maxLength": 128,
            "facetable": true,
            "title": "Endpoint ID"
          },
          "abonnementUrl": {
            "type": "string",
            "format": "uri",
            "description": "Full URL of the registered NRC abonnement (returned by NRC on POST)",
            "maxLength": 1024,
            "title": "Abonnement URL"
          },
          "callbackUrl": {
            "type": "string",
            "format": "uri",
            "description": "Pipelinq callback URL (e.g. https://pipelinq.example.nl/index.php/apps/pipelinq/api/zgw/notificaties/inbox)",
            "maxLength": 1024,
            "title": "Callback URL"
          },
          "callbackAuth": {
            "type": "string",
            "description": "Vault reference (e.g. 'vault://zgw/zoetermeer/nrc-callback-bearer') OR opaque bearer token used by NRC to authenticate inbound callbacks",
            "maxLength": 256,
            "title": "Callback Auth"
          },
          "kanalen": {
            "type": "array",
            "description": "Subscribed kanalen with optional per-kanaal filter map",
            "items": {
              "type": "object",
              "properties": {
                "naam": {
                  "type": "string",
                  "description": "Kanaal name (e.g. zaken, besluiten, catalogi)",
                  "title": "Naam"
                },
                "filters": {
                  "type": "object",
                  "description": "Optional filter map (e.g. bronorganisatie)",
                  "title": "Filters"
                }
              }
            },
            "title": "Kanalen"
          },
          "laatstOntvangenOp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the last successfully processed NRC notification",
            "title": "Laatst Ontvangen Op"
          },
          "actief": {
            "type": "boolean",
            "description": "Whether this subscription is active",
            "default": true,
            "facetable": true,
            "title": "Actief"
          }
        }
      },
      "zgwResourceMapping": {
        "slug": "zgwResourceMapping",
        "title": "ZGW Resource Mapping",
        "icon": "Link",
        "version": "1.0.0",
        "summary": "Bidirectional link between a pipelinq entity (request/contact/document) and a ZGW resource URL (zaak/besluit/rol/informatieobject).",
        "description": "ZGW uses absolute URLs as the canonical identifier for zaken, besluiten, rollen and informatieobjecten. This mapping persists the URL + UUID + most-recent ETag per resource so inbound NRC notifications (which reference resources by URL) can be correlated back to the originating pipelinq entity, and so PATCH operations can include If-Match for optimistic concurrency. Multiple mappings per Request are expected during ZGW <-> StUF coexistence migration. Mapped to Schema.org Thing as a pure relation row.",
        "@type": "schema:Thing",
        "required": [
          "pipelinqEntiteit",
          "pipelinqId",
          "zgwResourceType",
          "zgwUrl",
          "endpointId"
        ],
        "properties": {
          "pipelinqEntiteit": {
            "type": "string",
            "enum": [
              "request",
              "contact",
              "document"
            ],
            "description": "Pipelinq entity type backing the mapping",
            "facetable": true,
            "title": "Pipelinq Entiteit"
          },
          "pipelinqId": {
            "type": "string",
            "description": "UUID of the backing pipelinq entity",
            "maxLength": 64,
            "facetable": true,
            "title": "Pipelinq ID"
          },
          "zgwResourceType": {
            "type": "string",
            "enum": [
              "zaak",
              "besluit",
              "rol",
              "informatieobject"
            ],
            "description": "ZGW resource kind referenced by zgwUrl",
            "facetable": true,
            "title": "Zgw Resource Type"
          },
          "zgwUrl": {
            "type": "string",
            "format": "uri",
            "description": "Full URL of the ZGW resource (canonical identifier)",
            "maxLength": 1024,
            "title": "Zgw URL"
          },
          "zgwUuid": {
            "type": "string",
            "description": "UUID extracted from zgwUrl (lookup convenience)",
            "maxLength": 64,
            "facetable": true,
            "title": "Zgw UUID"
          },
          "endpointId": {
            "type": "string",
            "description": "Reference to the owning ZgwEndpoint id",
            "maxLength": 128,
            "facetable": true,
            "title": "Endpoint ID"
          },
          "laatsteSynchronisatie": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of last successful read from ZGW",
            "title": "Laatste Synchronisatie"
          },
          "etag": {
            "type": "string",
            "description": "Most recent ETag from GET/PATCH on this resource (used as If-Match on PATCH)",
            "maxLength": 256,
            "title": "Etag"
          }
        }
      },
      "request": {
        "slug": "request",
        "properties": {
          "zgwResourceMappings": {
            "type": "array",
            "description": "References to zgwResourceMapping rows linking this Request to one or more ZGW zaak/besluit/rol/informatieobject URLs (zgw-api-bridge spec REQ-ZGW-008).",
            "items": {
              "type": "string",
              "description": "UUID of a zgwResourceMapping row"
            },
            "title": "Zgw Resource Mappings"
          }
        }
      }
    },
