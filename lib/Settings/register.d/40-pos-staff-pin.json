{
    "components": {
        "registers": {
            "pipelinq": {
                "schemas": [
                    "posRole",
                    "posStaff"
                ]
            }
        },
        "schemas": {
            "posTransaction": {
                "properties": {
                    "staffMemberId": {
                        "type": "string",
                        "description": "UUID of the posStaff member who processed this transaction (per-staff sales attribution; fed to the shillinq commission journal).",
                        "maxLength": 64,
                        "title": "Staff member",
                        "facetable": true
                    }
                }
            },
            "posRole": {
                "slug": "posRole",
                "title": "POS Role",
                "icon": "AccountKey",
                "version": "1.0.0",
                "summary": "A named set of POS action permissions assignable to staff members",
                "description": "Defines what a POS operator may do: void completed transactions, apply line-item discounts up to a ceiling, process refunds, and open the cash drawer outside a sale (no-sale). Roles are assigned to posStaff members and resolved server-side on PIN authentication. Mapped to Schema.org Role.",
                "@type": "schema:Role",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Role display name, e.g. Kassamedewerker, Supervisor, Manager",
                        "maxLength": 64,
                        "title": "Name",
                        "facetable": true
                    },
                    "description": {
                        "type": "string",
                        "description": "Optional description of the role",
                        "maxLength": 255,
                        "title": "Description"
                    },
                    "canVoid": {
                        "type": "boolean",
                        "description": "Whether this role may void completed transactions",
                        "default": false,
                        "title": "Can void",
                        "facetable": true
                    },
                    "maxDiscountPercent": {
                        "type": "integer",
                        "description": "Maximum line-item discount percentage this role may apply (0-100)",
                        "minimum": 0,
                        "maximum": 100,
                        "default": 0,
                        "title": "Max discount %"
                    },
                    "canRefund": {
                        "type": "boolean",
                        "description": "Whether this role may process refunds",
                        "default": false,
                        "title": "Can refund",
                        "facetable": true
                    },
                    "canNoSale": {
                        "type": "boolean",
                        "description": "Whether this role may open the cash drawer without a transaction",
                        "default": false,
                        "title": "Can no-sale",
                        "facetable": true
                    }
                }
            },
            "posStaff": {
                "slug": "posStaff",
                "title": "POS Staff",
                "icon": "AccountBadge",
                "version": "1.0.0",
                "summary": "A POS operator authenticated by a hashed PIN and bound to a posRole",
                "description": "Represents a point-of-sale operator on a shared terminal. The PIN is stored only as a salted one-way hash (pinHash) and is NEVER returned by the API; the server verifies it in constant time and resolves the role permission matrix on success. failedPinAttempts and lockedUntil implement a brute-force lockout. Mapped to Schema.org Person.",
                "@type": "schema:Person",
                "required": [
                    "displayName",
                    "posRole"
                ],
                "properties": {
                    "displayName": {
                        "type": "string",
                        "description": "Name shown on the POS terminal after login",
                        "maxLength": 128,
                        "title": "Name",
                        "facetable": true
                    },
                    "userId": {
                        "type": "string",
                        "description": "Optional Nextcloud user UID linking this staff member to an account",
                        "maxLength": 64,
                        "title": "Nextcloud user"
                    },
                    "posRole": {
                        "type": "string",
                        "description": "UUID reference to the staff member's posRole",
                        "maxLength": 64,
                        "title": "Role",
                        "facetable": true
                    },
                    "pinHash": {
                        "type": "string",
                        "description": "Salted one-way hash of the 4-6 digit PIN. Write-only: never returned by the API.",
                        "maxLength": 255,
                        "title": "PIN hash"
                    },
                    "isActive": {
                        "type": "boolean",
                        "description": "Whether this staff member may log in",
                        "default": true,
                        "title": "Active",
                        "facetable": true
                    },
                    "failedPinAttempts": {
                        "type": "integer",
                        "description": "Consecutive failed PIN attempts (reset on success, lockout at 5)",
                        "minimum": 0,
                        "default": 0,
                        "title": "Failed attempts"
                    },
                    "lockedUntil": {
                        "type": "string",
                        "description": "ISO-8601 timestamp until which login is locked after repeated failures",
                        "format": "date-time",
                        "title": "Locked until"
                    }
                }
            }
        },
        "objects": [
            {
                "@self": { "register": "pipelinq", "schema": "posRole", "slug": "pos-role-kassamedewerker" },
                "name": "Kassamedewerker",
                "description": "Standaard kassamedewerker zonder speciale bevoegdheden",
                "canVoid": false,
