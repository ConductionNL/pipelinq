{
  "components": {
    "registers": {
      "pipelinq": {
        "schemas": [
          "masterEntity",
          "sourceRecord",
          "mergeOperation"
        ]
      }
    },
    "schemas": {
      "masterEntity": {
        "slug": "masterEntity",
        "title": "Master Entity",
        "icon": "AccountStarOutline",
        "version": "1.1.0",
        "summary": "Single authoritative golden record per master entity (Contact / Account / Product / Vendor).",
        "description": "The golden record consolidated from one or more source-records via trust-tier resolution. Holds the winning attribute values (goldenRecord), per-attribute provenance, merge lineage, lifecycle status and a computed data-quality score. Mapped to Schema.org Thing.",
        "x-schema-org": "schema:Thing",
        "x-openregister-quality": {
          "field": "qualityScore",
          "statusField": "qualityStatus",
          "rules": [
            {
              "type": "required",
              "field": "goldenRecord.name",
              "weight": 1
            },
            {
              "type": "required",
              "field": "goldenRecord.email",
              "weight": 1
            },
            {
              "type": "format",
              "field": "goldenRecord.email",
              "format": "email",
              "weight": 1
            },
            {
              "type": "format",
              "field": "goldenRecord.kvkNumber",
              "pattern": "^[0-9]{8}$",
              "weight": 1
            },
            {
              "type": "freshness",
              "field": "lastSourceUpdate",
              "halfLifeDays": 180,
              "weight": 2
            }
          ],
          "thresholds": {
            "good": 0.8,
            "fair": 0.5
          }
        },
        "x-openregister-dedup": {
          "blockingKeys": [],
          "matchRules": [
            {
              "field": "goldenRecord.kvkNumber",
              "method": "exact",
              "weight": 0.4
            },
            {
              "field": "goldenRecord.email",
              "method": "exact",
              "weight": 0.3
            },
            {
              "field": "goldenRecord.name",
              "method": "normalized",
              "weight": 0.2
            },
            {
              "field": "goldenRecord.name",
              "method": "levenshtein",
              "weight": 0.1
            }
          ],
          "threshold": 0.7
        },
        "x-openregister-survivorship": {
          "sourceLink": {
            "mode": "reverseFk",
            "sourceSchema": "sourceRecord",
            "referenceField": "currentMasterEntity"
          },
          "goldenRecordField": "goldenRecord",
          "provenanceField": "attributeProvenance",
          "trustTierField": "trustTier",
          "tierOrder": [
            "discard",
            "bronze",
            "silver",
            "gold"
          ],
          "defaultTier": "bronze",
          "discardTier": "discard",
          "freshnessAnchorField": "lastChange",
          "overridesField": "attributeOverrides"
        },
        "x-openregister-merge": {
          "sourceLink": {
            "mode": "reverseFk",
            "sourceSchema": "sourceRecord",
            "referenceField": "currentMasterEntity"
          },
          "entityType": "entityType",
          "statusField": "status",
          "survivorStatus": "active",
          "mergedStatus": "merged-into-other",
          "reversalWindowDays": 30
        },
        "required": [
          "masterId",
          "entityType",
          "goldenRecord",
          "attributeProvenance",
          "status"
        ],
        "properties": {
          "masterId": {
            "type": "string",
            "title": "Master ID",
            "description": "Stable UUID; never reused after merge.",
            "maxLength": 64,
            "facetable": true
          },
          "entityType": {
            "type": "string",
            "title": "Entity type",
            "description": "Type of master entity.",
            "enum": [
              "contact",
              "account",
              "product",
              "vendor"
            ],
            "facetable": true
          },
          "goldenRecord": {
            "type": "object",
            "title": "Golden record",
            "description": "Winning attribute values per trust-tier configuration."
          },
          "attributeProvenance": {
            "type": "object",
            "title": "Attribute provenance",
            "description": "Per-attribute metadata: which source won, trustTier, lastUpdated, confidence."
          },
          "attributeOverrides": {
            "type": "object",
            "title": "Attribute overrides",
            "description": "Per-attribute steward override map (attribute => {value, overriddenBy, rationale}) written by OpenRegister's conflict-resolution override endpoint; short-circuits tier selection for that attribute during survivorship recompute."
          },
          "aliases": {
            "type": "array",
            "title": "Aliases",
            "description": "Previous masterId values from merges, for backward-compat lookups.",
            "items": {
              "type": "string"
            }
          },
          "mergedFrom": {
            "type": "array",
            "title": "Merged from",
            "description": "masterId values that were merged into this entity.",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Lifecycle status.",
            "enum": [
              "active",
              "merged-into-other",
              "soft-deleted",
              "quarantined"
            ],
            "default": "active",
            "facetable": true
          },
          "mergedIntoMasterId": {
            "type": "string",
            "title": "Merged into master ID",
            "description": "If merged-into-other, the masterId this entity was merged into.",
            "maxLength": 64
          },
          "dataQualityScore": {
            "type": "number",
            "title": "Data quality score",
            "description": "Downstream-facing quality score 0-1. Mirrors OpenRegister's materialised qualityScore directly; the former app-side cross-source agreement blend (DataQualityScorer) is retired (ADR-045). Optional — OpenRegister materialises qualityScore on save.",
            "minimum": 0,
            "maximum": 1,
            "facetable": true
          },
          "qualityScore": {
            "type": "number",
            "title": "OR quality score",
            "description": "Per-object quality score 0-1 materialised by OpenRegister from the x-openregister-quality annotation (completeness/format/freshness). This is the authoritative score the downstream read API exposes.",
            "minimum": 0,
            "maximum": 1,
            "facetable": true
          },
          "qualityStatus": {
            "type": "string",
            "title": "OR quality status",
            "description": "Status label materialised by OpenRegister from qualityScore (good/fair/poor).",
            "enum": [
              "good",
              "fair",
              "poor"
            ],
            "facetable": true
          },
          "lastSourceUpdate": {
            "type": "string",
            "format": "date-time",
            "title": "Last source update",
            "description": "Most recent attributeProvenance lastUpdated across all attributes; the date OpenRegister's freshness rule decays against."
          },
          "lastReviewedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Last reviewed at",
            "description": "Last time a data steward reviewed or actioned this entity."
          },
          "tags": {
            "type": "array",
            "title": "Tags",
            "description": "Free-form labels.",
            "items": {
              "type": "string"
            }
          },
          "gdprNotes": {
            "type": "string",
            "title": "GDPR notes",
            "description": "Right-of-deletion tracking and proof-of-deletion notes.",
            "maxLength": 4096
          }
        }
      },
      "sourceRecord": {
        "slug": "sourceRecord",
        "title": "Source Record",
        "icon": "DatabaseImportOutline",
        "version": "1.0.0",
        "summary": "Per-system raw copy of an entity, linked to a Master Entity.",
        "description": "A copy of an entity as supplied by a specific source system (Pipelinq CRM, Shillinq, KvK API, etc.). Carries both raw and normalised attributes that compete in duplicate detection and golden-record recomputation.",
        "x-schema-org": "schema:Thing",
        "required": [
          "sourceRecordId",
          "sourceSystem",
          "nativeId",
          "entityType",
          "currentMasterEntity",
          "rawAttributes",
          "mappedAttributes",
          "firstSeen",
          "lastSeen",
          "lastChange",
          "linkageMethod",
          "linkageConfidence"
        ],
        "properties": {
          "sourceRecordId": {
            "type": "string",
            "title": "Source record ID",
            "description": "Composite natural key sourceSystem:nativeId.",
            "maxLength": 255,
            "facetable": true
          },
          "sourceSystem": {
            "type": "string",
            "title": "Source system",
            "description": "Origin system slug.",
            "maxLength": 64,
            "facetable": true
          },
          "nativeId": {
            "type": "string",
            "title": "Native ID",
            "description": "Object ID in the source system.",
            "maxLength": 255
          },
          "entityType": {
            "type": "string",
            "title": "Entity type",
            "enum": [
              "contact",
              "account",
              "product",
              "vendor"
            ],
            "facetable": true,
            "description": "Entity Type for this record."
          },
          "currentMasterEntity": {
            "type": "string",
            "title": "Current master entity",
            "description": "UUID of the linked Master Entity.",
            "maxLength": 64,
            "facetable": true
          },
          "rawAttributes": {
            "type": "object",
            "title": "Raw attributes",
            "description": "Unmodified source values as received."
          },
          "mappedAttributes": {
            "type": "object",
            "title": "Mapped attributes",
            "description": "Normalised / cleansed values that compete in matching."
          },
          "firstSeen": {
            "type": "string",
            "format": "date-time",
            "title": "First seen",
            "description": "First Seen for this record."
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time",
            "title": "Last seen",
            "description": "Last Seen for this record."
          },
          "lastChange": {
            "type": "string",
            "format": "date-time",
            "title": "Last change",
            "description": "When mapped attributes last changed; used for freshness decay."
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "description": "Steward confidence in this source record (default 1.0).",
            "minimum": 0,
            "maximum": 1,
            "default": 1
          },
          "linkageMethod": {
            "type": "string",
            "title": "Linkage method",
            "enum": [
              "deterministic-key",
              "probabilistic-match",
              "manual-assignment",
              "system-auto-merge"
            ],
            "facetable": true,
            "description": "Linkage Method for this record."
          },
          "linkageConfidence": {
            "type": "number",
            "title": "Linkage confidence",
            "minimum": 0,
            "maximum": 1,
            "description": "Linkage Confidence for this record."
          },
          "withdrawn": {
            "type": "boolean",
            "title": "Withdrawn",
            "description": "True if the source system has deleted or retracted this record.",
            "default": false,
            "facetable": true
          }
        }
      },
      "mergeOperation": {
        "slug": "mergeOperation",
        "title": "Merge Operation",
        "icon": "SourceMerge",
        "version": "1.0.0",
        "summary": "Log of a merge with pre-merge snapshot for reversal.",
        "description": "Records every merge (manual or auto) with the pre-merge snapshot, attribute-resolution log, downstream sync status and reversibility window. Mapped to Schema.org Action.",
        "x-schema-org": "schema:Action",
        "required": [
          "mergedIntoMasterId",
          "mergedFromMasterIds",
          "mergedAt",
          "mergeReason",
          "preMergeSnapshot",
          "attributeResolutionLog",
          "reversible"
        ],
        "properties": {
          "mergedIntoMasterId": {
            "type": "string",
            "title": "Merged into master ID",
            "maxLength": 64,
            "facetable": true,
            "description": "Unique identifier for the associated merged into master."
          },
          "mergedFromMasterIds": {
            "type": "array",
            "title": "Merged from master IDs",
            "items": {
              "type": "string"
            },
            "description": "Merged From Master Ids for this record."
          },
          "mergedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Merged at",
            "description": "Timestamp when merged occurred."
          },
          "mergedBy": {
            "type": "string",
            "title": "Merged by",
            "description": "Nextcloud user UID or system-auto-merge.",
            "maxLength": 128
          },
          "mergeReason": {
            "type": "string",
            "title": "Merge reason",
            "enum": [
              "duplicate-detected-deterministic",
              "duplicate-detected-probabilistic",
              "manual-bulk",
              "data-stewardship-review",
              "migration"
            ],
            "facetable": true,
            "description": "Merge Reason for this record."
          },
          "preMergeSnapshot": {
            "type": "object",
            "title": "Pre-merge snapshot",
            "description": "Deep copy of goldenRecords, attributeProvenances and status for all entities, for reversal."
          },
          "attributeResolutionLog": {
            "type": "array",
            "title": "Attribute resolution log",
            "items": {
              "type": "object"
            },
            "description": "Attribute Resolution Log for this record."
          },
          "downstreamSyncStatus": {
            "type": "object",
            "title": "Downstream sync status",
            "description": "Downstream Sync Status for this record."
          },
          "reversible": {
            "type": "boolean",
            "title": "Reversible",
            "default": true,
            "facetable": true,
            "description": "Reversible for this record."
          },
          "reversedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Reversed at",
            "description": "Timestamp when reversed occurred."
          },
          "reversedBy": {
            "type": "string",
            "title": "Reversed by",
            "maxLength": 128,
            "description": "Reversed By for this record."
          }
        }
      },
      "contact": {
        "properties": {
          "masterEntityRef": {
            "type": "string",
            "title": "Master entity ref",
            "description": "UUID of the Master Entity this contact maps to (MDM). Null for legacy / un-linked contacts.",
            "maxLength": 64,
            "facetable": true
          },
          "isMasterRecord": {
            "type": "boolean",
            "title": "Is master record",
            "description": "True only if this contact is the canonical CRM representation of the master entity.",
            "default": false,
            "facetable": true
          }
        }
      },
      "client": {
        "properties": {
          "masterEntityRef": {
            "type": "string",
            "title": "Master entity ref",
            "description": "UUID of the Master Entity this account maps to (MDM). Null for legacy / un-linked accounts.",
            "maxLength": 64,
            "facetable": true
          },
          "isMasterRecord": {
            "type": "boolean",
            "title": "Is master record",
            "description": "True only if this account is the canonical CRM representation of the master entity.",
            "default": false,
            "facetable": true
          }
        }
      },
      "product": {
        "properties": {
          "masterEntityRef": {
            "type": "string",
            "title": "Master entity ref",
            "description": "UUID of the Master Entity this product maps to (MDM). Null for legacy / un-linked products.",
            "maxLength": 64,
            "facetable": true
          },
          "isMasterRecord": {
            "type": "boolean",
            "title": "Is master record",
            "description": "True only if this product is the canonical representation of the master entity.",
            "default": false,
            "facetable": true
          }
        }
      }
    },
