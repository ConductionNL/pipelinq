{
  "components": {
    "schemas": {
      "product": {
        "slug": "product",
        "version": "1.3.0",
        "properties": {
          "variantAttributes": {
            "type": "array",
            "title": "Variant attributes",
            "description": "What the variants of this product differ in, such as size or colour, each with the values it allows. Each variant names one value for every attribute.",
            "visible": false,
            "items": {
              "type": "object",
              "required": [
                "name",
                "values"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Attribute",
                  "description": "The attribute, such as Size.",
                  "maxLength": 100
                },
                "values": {
                  "type": "array",
                  "title": "Values",
                  "description": "The values the attribute allows, such as S, M and L.",
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
