                "required": [
                    "bsnGemaskeerd",
                    "isFormeelGeldig",
                    "validatieTijdstip"
                ],
                "properties": {
                    "bsnGemaskeerd": {
                        "type": "string",
                        "title": "BSN (gemaskeerd)",
                        "description": "Gemaskeerde BSN-weergave (***45678*). Het volledige BSN wordt hier nooit opgeslagen.",
                        "maxLength": 16
                    },
                    "isFormeelGeldig": {
                        "type": "boolean",
                        "title": "Formeel geldig",
                        "description": "Of de invoer de 11-proef doorstaat en exact 9 cijfers telt.",
                        "facetable": true
                    },
                    "validatieTijdstip": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Validatietijdstip"
                    },
                    "geinitieerdDoor": {
                        "type": "string",
                        "title": "Geïnitieerd door",
                        "description": "Nextcloud user-UID die de validatie uitvoerde.",
                        "maxLength": 128
                    },
                    "context": {
                        "type": "string",
