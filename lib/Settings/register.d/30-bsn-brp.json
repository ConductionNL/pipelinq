            "bsnValidatie": {
                "slug": "bsnValidatie",
                "title": "BSN Validatie",
                "icon": "CheckDecagramOutline",
                "version": "1.0.0",
                "summary": "Resultaat van een client-side 11-proef BSN-formatcontrole.",
                "description": "Uitkomst van een deterministische 11-proef (RvIG). Bevat geen volledig BSN in plain-text: alleen een gemaskeerde weergave wordt bewaard (ADR-005). Eenmalig aangemaakt, nooit gewijzigd, geen externe call.",
