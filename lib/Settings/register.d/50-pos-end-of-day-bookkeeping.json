    "schemas": {
      "posZReport": {
        "slug": "posZReport",
        "title": "POS Z-Report",
        "icon": "FileChart",
        "version": "1.0.0",
        "summary": "Daily POS end-of-day settlement, aggregating confirmed transactions per terminal",
        "description": "Represents a daily Z-report (end-of-day settlement) for a POS terminal. Aggregates all confirmed/settled posTransaction objects for a given reportDate (and optional terminalId), computing per-rate tax breakdown, payment-method breakdown and gross/net totals server-authoritative: client-supplied figures are never trusted. Lifecycle: draft -> ready -> submitted -> posted -> reconciled, with a failed branch for retried submissions. Mapped to Schema.org Invoice.",
        "x-schema-org": "schema:Invoice",
        "required": [
          "reference",
          "reportDate",
          "createdAt",
          "status"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "description": "Human-readable Z-report reference, e.g. Z-2026-05-20-KAS01 (date + terminal)",
            "maxLength": 64,
            "facetable": true,
            "title": "Reference"
          },
          "reportDate": {
            "type": "string",
            "format": "date",
            "description": "Settlement date (not creation date) in YYYY-MM-DD",
            "facetable": true,
            "title": "Report Date"
          },
          "terminalId": {
            "type": "string",
            "description": "POS terminal / register identifier (e.g. kassa-01); null when the report spans all terminals",
            "maxLength": 64,
            "facetable": true,
            "title": "Terminal ID"
          },
          "store": {
            "type": "string",
            "format": "uuid",
            "description": "Optional reference to a store/location entity (future use)",
            "x-external-register": "openregister",
            "title": "Store"
          },
          "transactionIds": {
            "type": "array",
            "description": "UUIDs of aggregated posTransaction objects (audit trail)",
            "items": {
              "type": "string"
            },
            "title": "Transaction Ids"
          },
          "transactionCount": {
            "type": "integer",
            "description": "Number of transactions aggregated",
            "default": 0,
            "minimum": 0,
            "title": "Transaction Count"
          },
          "subtotal": {
            "type": "number",
            "description": "Sum of transaction subtotals excluding tax",
            "default": 0,
            "title": "Subtotal"
          },
          "discountTotal": {
            "type": "number",
            "description": "Aggregate discount across all transactions",
            "default": 0,
            "title": "Discount Total"
          },
          "taxBreakdown": {
            "type": "array",
            "description": "Per-rate tax summary, e.g. [{rate:21, base:200.00, tax:42.00}]",
            "items": {
              "type": "object"
            },
            "title": "Tax Breakdown"
          },
          "totalTax": {
            "type": "number",
            "description": "Aggregate tax (sum of taxBreakdown[*].tax)",
            "default": 0,
            "title": "Total Tax"
          },
          "total": {
            "type": "number",
            "description": "Grand total including tax",
            "default": 0,
            "title": "Total"
          },
          "paymentMethodBreakdown": {
            "type": "array",
            "description": "Per-payment-method totals, e.g. [{method:cash, amount:300.00}]",
            "items": {
              "type": "object"
            },
            "title": "Payment Method Breakdown"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the Z-report was generated (server-set)",
            "title": "Created At"
          },
          "settledAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the transactions were settled",
            "title": "Settled At"
          },
          "status": {
            "type": "string",
            "description": "Lifecycle status",
            "enum": [
              "draft",
              "ready",
              "submitted",
              "posted",
              "failed",
              "reconciled"
            ],
            "default": "draft",
            "title": "Status",
            "facetable": true
          },
          "bookkeepingStatus": {
            "type": "string",
            "description": "Projection of the shillinq journal-entry outcome for this POS day. pending = raise queued / shillinq unreachable; raised = shillinq accepted and returned a journal id; failed = the registry raise exhausted its retries. The GL chart, the VAT posting and the journal itself live in shillinq (cross-app contract #3); this is only a read-only status mirror so operators can see whether the day is booked.",
            "enum": [
              "pending",
              "raised",
              "failed"
            ],
            "default": "pending",
            "title": "Bookkeeping status",
            "facetable": true
          },
          "shillinqJournalEntryId": {
            "type": "string",
            "description": "JournalEntry id returned by shillinq once the registry-mediated shillinq.JournalEntry.raise is accepted. Empty while pending or failed.",
            "maxLength": 64,
            "facetable": true,
            "title": "Shillinq Journal Entry ID"
          },
          "bookkeepingAttempts": {
            "type": "integer",
            "description": "Number of shillinq.JournalEntry.raise dispatch attempts (incremented per raise; drives the max-attempts terminal-failed cut-off).",
            "default": 0,
            "minimum": 0,
            "title": "Bookkeeping Attempts"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes (e.g. overage adjustment)",
            "maxLength": 2000,
            "title": "Notes"
          }
        }
      }
    },
