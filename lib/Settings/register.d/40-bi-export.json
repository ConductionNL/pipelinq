{
    "components": {
        "registers": {
            "pipelinq": {
                "schemas": [
                    "exportDestination",
                    "exportJob",
                    "exportRun",
                    "exportSchemaSnapshot"
                ]
            }
        },
        "schemas": {
            "exportDestination": {
                "slug": "exportDestination",
                "title": "Export Destination",
                "icon": "DatabaseExport",
                "version": "1.0.0",
                "summary": "A configured sink for BI data exports",
                "description": "Represents a configured external warehouse sink (S3, Azure Data Lake, GCS, BigQuery, Snowflake, SFTP, Postgres). Credentials live in an OpenConnector source; this schema only references the source by id (ADR-005). Used by the BI export pipeline as the upload target for an export job.",
                "required": [
                    "name",
                    "type",
                    "connectorSourceId",
                    "pathTemplate"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Friendly name for the destination (e.g. 'Production S3').",
                        "maxLength": 255,
                        "minLength": 1
                    },
                    "type": {
                        "type": "string",
                        "description": "Destination type.",
                        "enum": [
                            "s3",
                            "azure_data_lake",
                            "gcs",
                            "bigquery",
                            "snowflake",
                            "sftp",
                            "postgres"
                        ]
                    },
                    "connectorSourceId": {
                        "type": "string",
                        "description": "UUID reference to an OpenConnector source holding the credentials. Credentials are never stored on this object.",
                        "maxLength": 255
                    },
                    "pathTemplate": {
                        "type": "string",
                        "description": "Template for the destination path, e.g. s3://bucket/pipelinq/{schema}/{partition}/. Placeholders: {schema}, {partition}, {run_id}, {timestamp}.",
                        "maxLength": 1024
                    },
                    "compression": {
                        "type": "string",
                        "description": "Compression algorithm for written files.",
                        "enum": [
                            "none",
                            "gzip",
                            "snappy",
                            "zstd"
                        ],
                        "default": "none"
                    },
                    "encryptionEnabled": {
                        "type": "boolean",
                        "description": "Enable server-side encryption-at-rest for object-store destinations.",
                        "default": true
                    },
                    "namingConvention": {
                        "type": "string",
                        "description": "File naming pattern, e.g. {schema}_{run_id}_{timestamp}.parquet.",
                        "maxLength": 512
                    },
                    "validationStatus": {
                        "type": "string",
                        "description": "Result of the last connection test.",
                        "enum": [
                            "untested",
                            "valid",
                            "invalid"
                        ],
                        "default": "untested"
                    },
                    "lastValidatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 timestamp of the last connection test."
                    }
                }
            },
            "exportJob": {
                "slug": "exportJob",
                "title": "Export Job",
                "icon": "Export",
                "version": "1.0.0",
                "summary": "A configured, repeatable BI export task",
                "description": "Represents a configured, repeatable export of one or more pipelinq schemas to an export destination. Supports full-refresh and incremental (watermark/CDC) modes, multiple formats, cron scheduling, row filters and a column allowlist for PII minimisation (GDPR).",
                "required": [
                    "name",
                    "sourceSchemas",
                    "destinationId",
                    "format",
                    "mode",
                    "scheduleCron",
                    "createdBy",
                    "createdAt"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Job name for display.",
                        "maxLength": 255,
                        "minLength": 1
                    },
                    "description": {
                        "type": "string",
                        "description": "Free-text job description.",
                        "maxLength": 2048
                    },
                    "sourceSchemas": {
                        "type": "array",
                        "description": "List of pipelinq schema slugs to export.",
                        "items": {
                            "type": "string"
                        }
                    },
                    "destinationId": {
                        "type": "string",
                        "description": "UUID reference to an exportDestination.",
                        "maxLength": 255
                    },
                    "format": {
                        "type": "string",
                        "description": "Output format.",
                        "enum": [
                            "csv",
                            "parquet",
                            "jsonl"
                        ]
                    },
                    "mode": {
                        "type": "string",
                        "description": "Export mode: full re-export or incremental watermark/CDC.",
                        "enum": [
                            "full",
                            "incremental"
                        ]
                    },
                    "incrementalWatermarkColumn": {
                        "type": "string",
                        "description": "Column name used for incremental tracking (e.g. updated_at). Required when mode = incremental.",
                        "maxLength": 255
                    },
                    "scheduleCron": {
                        "type": "string",
                        "description": "UNIX cron expression (5-field) or shortcut (@hourly, @daily, @weekly).",
                        "maxLength": 128
                    },
                    "enabled": {
                        "type": "boolean",
                        "description": "Whether the job runs on its schedule. Defaults to false until tested.",
                        "default": false
                    },
                    "partitionBy": {
                        "type": "string",
                        "description": "Optional partitioning expression, e.g. created_at:day.",
                        "maxLength": 255
                    },
                    "rowFilterExpression": {
                        "type": "string",
                        "description": "Optional SQL-style row filter, applied before export. Example: status != 'deleted'.",
                        "maxLength": 2048
                    },
                    "columnAllowlist": {
                        "type": "array",
                        "description": "If set, only these columns are exported; all others are dropped (PII minimisation).",
                        "items": {
                            "type": "string"
                        }
                    },
                    "createdBy": {
                        "type": "string",
                        "description": "Nextcloud user UID of the job creator.",
                        "maxLength": 255
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 timestamp when the job was created."
                    }
                }
            },
            "exportRun": {
                "slug": "exportRun",
                "title": "Export Run",
                "icon": "History",
                "version": "1.0.0",
                "summary": "One immutable execution of an export job (audit record)",
                "description": "Records one execution of an export job. Serves as the immutable per-run audit record (ADR-009): row/byte/file counts, per-file manifest with checksums, watermark range, error state and destination acknowledgement.",
                "required": [
                    "jobId",
                    "status",
                    "modeUsed"
                ],
                "properties": {
                    "jobId": {
                        "type": "string",
                        "description": "UUID reference to the exportJob.",
                        "maxLength": 255
                    },
                    "startedAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 timestamp when the run started (null while pending)."
                    },
                    "endedAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 timestamp when the run completed (null while running)."
                    },
                    "status": {
                        "type": "string",
                        "description": "Run status.",
                        "enum": [
                            "pending",
                            "running",
                            "succeeded",
                            "failed",
                            "partial",
                            "skipped_overlap"
                        ],
                        "default": "pending"
                    },
                    "modeUsed": {
                        "type": "string",
                        "description": "Mode used for this run.",
                        "enum": [
                            "full",
                            "incremental"
                        ]
                    },
                    "watermarkFrom": {
                        "type": "string",
                        "description": "For incremental runs: start of the watermark range (previous run's watermarkTo)."
                    },
                    "watermarkTo": {
                        "type": "string",
                        "description": "For incremental runs: end of the watermark range (max value observed this run)."
                    },
                    "rowCount": {
                        "type": "integer",
                        "description": "Number of rows exported in this run."
                    },
                    "byteCount": {
                        "type": "integer",
                        "description": "Total bytes written to the destination."
                    },
                    "fileCount": {
                        "type": "integer",
                        "description": "Number of files written."
                    },
                    "fileManifestJson": {
                        "type": "array",
                        "description": "Array of files written, each with path, size_bytes, sha256, rows_in_file, compression_used, upload_status.",
                        "items": {
                            "type": "object"
                        }
                    },
                    "errorMessage": {
                        "type": "string",
                        "description": "Error description when status is failed or partial.",
                        "maxLength": 4096
                    },
                    "destinationAck": {
                        "type": "string",
                        "description": "Destination acknowledgement (S3 ETag, BigQuery load-job id, Snowflake query id, ...).",
                        "maxLength": 1024
                    }
                }
            },
            "exportSchemaSnapshot": {
                "slug": "exportSchemaSnapshot",
                "title": "Export Schema Snapshot",
                "icon": "TableColumn",
                "version": "1.0.0",
                "summary": "The structure of a pipelinq schema at export time",
                "description": "Records the column structure of a pipelinq schema at the time of an export run, enabling schema-drift detection between runs (added/removed/changed columns).",
                "required": [
                    "runId",
                    "pipelinqSchemaName",
                    "columnDefinitionsJson"
                ],
                "properties": {
                    "runId": {
                        "type": "string",
                        "description": "UUID reference to the exportRun.",
                        "maxLength": 255
                    },
                    "pipelinqSchemaName": {
                        "type": "string",
                        "description": "Name of the pipelinq schema captured (e.g. contact, lead).",
                        "maxLength": 255
                    },
                    "columnDefinitionsJson": {
                        "type": "object",
                        "description": "Map of column names to their type/nullability, e.g. {\"id\":\"uuid\",\"email\":\"string|null\"}."
                    },
                    "comparedToPrevious": {
                        "type": "array",
                        "description": "Changes from the prior run, e.g. ['added: phone', 'removed: legacy_field', 'changed: status (string -> enum)'].",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
