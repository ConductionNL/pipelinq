        "required": [
          "bewijsItemId",
          "veldpad",
          "grond"
        ],
        "properties": {
          "bundleId": {
            "type": "string",
            "description": "UUID reference to the ExportBundle (set when the bundle is generated)",
            "maxLength": 255,
            "title": "Bundle"
          },
          "bewijsItemId": {
            "type": "string",
            "description": "UUID reference to the redacted BewijsItem",
            "maxLength": 255,
            "title": "Bewijs item",
            "facetable": true
          },
          "veldpad": {
            "type": "string",
            "description": "JSONPath of the redacted field",
            "maxLength": 512,
            "title": "Veldpad"
          },
          "voorWaarde": {
            "type": "string",
            "description": "Value before redaction (kept for 4-eyes audit)",
            "title": "Voor-waarde"
          },
          "naWaarde": {
            "type": "string",
            "description": "Value after redaction",
            "title": "Na-waarde"
          },
          "uitgevoerdDoor": {
            "type": "string",
            "description": "UID of the handler who applied the redaction",
            "maxLength": 255,
            "title": "Uitgevoerd door"
          },
          "uitgevoerdOp": {
            "type": "string",
            "format": "date-time",
            "description": "When the redaction was applied",
            "title": "Uitgevoerd op"
          },
          "grond": {
            "type": "string",
            "description": "Legal ground for the redaction",
            "enum": [
              "bescherming-rechten-derden",
              "wettelijke-verplichting",
              "bedrijfsgeheim",
              "art-23-eigen-gegevens"
            ],
            "title": "Grond",
            "facetable": true
          }
        }
      }
    },
