    "schemas": {
      "contact": {
        "slug": "contact",
        "x-openregister-notifications": {
          "newContact": {
            "actions": [
              {
                "label": {
                  "en": "Open",
                  "nl": "Openen"
                },
                "primary": true,
                "target": {
                  "kind": "object-detail"
                }
              }
            ]
          }
        }
      },
