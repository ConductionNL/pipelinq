{
  "components": {
    "registers": {
      "pipelinq": {
        "schemas": [
          "expense"
        ]
      }
    },
    "schemas": {
      "expense": {
        "x-schema-org": "schema:Invoice",
        "slug": "expense",
        "title": "Expense",
        "icon": "ReceiptOutline",
        "version": "1.0.0",
        "summary": "An approved or pending expense submission with optional Shillinq AP sync state.",
        "description": "Captured expense (declaratie / onkostenbon) submitted in pipelinq. When status transitions to 'approved' the expense is dispatched as an AP voucher to Shillinq through OpenRegister's WebhookService; apSyncStatus and apSyncedAt record the outcome of that one-way integration.",
        "required": [
          "title",
          "amount"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Short title for the expense (schema:name).",
            "maxLength": 255,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "description": "Free-text description of the expense.",
            "maxLength": 2000,
            "title": "Description"
          },
          "amount": {
            "type": "number",
            "description": "Expense amount in the configured currency.",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code.",
            "default": "EUR",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency"
          },
          "category": {
            "type": "string",
            "description": "Expense category (e.g. accommodation, travel, supplies, meals, software).",
            "title": "Category"
          },
          "client": {
            "type": "string",
            "description": "UUID of the related client (pipelinq client schema).",
            "title": "Client"
          },
          "billable": {
            "type": "boolean",
            "description": "Whether this expense is billable to the linked project/client.",
            "default": false,
            "title": "Billable"
          },
          "status": {
            "type": "string",
            "description": "Expense workflow status.",
            "enum": [
              "draft",
              "submitted",
              "approved",
              "rejected"
            ],
            "default": "draft",
            "title": "Status"
          },
          "approvedBy": {
            "type": "string",
            "description": "User ID of the approver.",
            "title": "Approved By"
          },
          "approvedAt": {
            "type": "string",
            "description": "ISO 8601 UTC timestamp of approval.",
            "format": "date-time",
            "title": "Approved At"
          },
          "apSyncStatus": {
            "type": "string",
            "description": "Shillinq AP sync state for this expense (null until the first approval event)..",
            "enum": [
              "pending",
              "synced",
              "failed"
            ],
            "title": "Ap Sync Status"
          },
          "apSyncedAt": {
            "type": "string",
            "description": "ISO 8601 UTC timestamp of the last successful Shillinq AP dispatch..",
            "format": "date-time",
            "title": "Ap Synced At"
          }
        }
      }
    },
