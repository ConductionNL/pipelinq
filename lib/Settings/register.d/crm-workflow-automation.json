					{ "type": "fire_webhook", "result": "failure", "httpStatus": 503, "error": "Upstream unavailable" }
				],
				"status": "failure",
				"error": "Webhook endpoint returned HTTP 503"
			},
			{
				"@self": {
					"register": "pipelinq",
					"schema": "decisionTable",
					"slug": "decision-sla-tier"
				},
				"name": "SLA-tier bepaling",
				"description": "Bepaalt het SLA-niveau op basis van leadwaarde en industrie.",
				"hitPolicy": "FIRST",
				"inputs": [
					{ "field": "value", "label": "Leadwaarde" },
					{ "field": "industry", "label": "Industrie" }
				],
				"outputs": [
					{ "field": "sla_tier", "label": "SLA-niveau" },
					{ "field": "assignee_pool", "label": "Toewijzingspool" }
				],
				"rules": [
					{
						"when": { "value": { "gte": 50000 } },
						"then": { "sla_tier": "high", "assignee_pool": "senior-verkoop" }
					},
					{
						"when": { "industry": "Gemeente" },
						"then": { "sla_tier": "high", "assignee_pool": "publieke-sector" }
					},
					{
						"when": { "value": { "gte": 10000 } },
						"then": { "sla_tier": "medium", "assignee_pool": "verkoop" }
					},
					{
						"when": {},
						"then": { "sla_tier": "standard", "assignee_pool": "verkoop" }
					}
				]
			}
		]
	}
}
