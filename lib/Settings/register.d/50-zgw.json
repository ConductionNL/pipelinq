{
    "components": {
        "registers": {
            "pipelinq": {
                "schemas": [
                    "zgwEndpoint",
                    "zgwClient",
                    "nrcAbonnement",
                    "zgwResourceMapping"
                ]
            }
        },
        "schemas": {
            "zgwEndpoint": {
                "slug": "zgwEndpoint",
                "title": "ZGW Endpoint",
                "version": "1.0.0",
                "summary": "Configuration profile for a single ZGW (zaakgericht-werken) deployment per gemeente, listing the ZRC/DRC/BRC/ZTC/AC component URLs plus NRC.",
                "@type": "schema:Service",
                "required": [
                    "naam",
                    "gemeenteCode",
                    "componenten",
                    "clientId"
                ],
                "properties": {
                    "naam": {
                        "type": "string",
                        "description": "Display name, e.g. Gemeente Zoetermeer - Open Zaak (Dimpact)",
                        "maxLength": 255,
                        "title": "Naam",
                        "facetable": true
                    },
                    "gemeenteCode": {
                        "type": "string",
                        "description": "4-digit CBS gemeente code, e.g. 0637",
                        "maxLength": 8,
                        "title": "Gemeentecode",
                        "facetable": true
                    },
                    "componenten": {
                        "type": "object",
                        "description": "Base URLs per ZGW component (zrc, drc, brc, ztc, ac, nrc).",
                        "title": "Componenten",
                        "properties": {
                            "zrc": {"type": "string", "description": "Zaken API (ZRC) base URL"},
                            "drc": {"type": "string", "description": "Documenten API (DRC) base URL"},
                            "brc": {"type": "string", "description": "Besluiten API (BRC) base URL"},
                            "ztc": {"type": "string", "description": "Catalogi API (ZTC) base URL"},
                            "ac": {"type": "string", "description": "Autorisaties API (AC) base URL"},
                            "nrc": {"type": "string", "description": "Notificaties API (NRC) base URL"}
                        }
                    },
                    "clientId": {
                        "type": "string",
                        "description": "Reference (id) to the zgwClient used for this endpoint",
                        "maxLength": 255,
                        "title": "Client",
                        "facetable": true
                    },
                    "actief": {
                        "type": "boolean",
                        "description": "Whether this endpoint is the active write path (write=on). Toggling to true triggers NRC subscription registration.",
                        "default": false,
                        "title": "Actief",
                        "facetable": true
                    },
                    "readOnly": {
                        "type": "boolean",
                        "description": "If true, read-only consumption only; write operations are blocked.",
                        "default": false,
                        "title": "Alleen-lezen",
                        "facetable": true
                    },
                    "mutualTlsCertRef": {
                        "type": "string",
                        "description": "Optional vault reference to a PEM client certificate for mTLS with this endpoint.",
                        "maxLength": 512,
                        "title": "mTLS-certificaat (kluis)"
                    },
                    "mutualTlsKeyRef": {
                        "type": "string",
                        "description": "Optional vault reference to the mTLS private key.",
                        "maxLength": 512,
                        "title": "mTLS-sleutel (kluis)"
                    },
                    "aangemaakt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 creation timestamp",
                        "title": "Aangemaakt"
                    }
                }
            },
            "zgwClient": {
                "slug": "zgwClient",
                "title": "ZGW Client",
                "version": "1.0.0",
                "summary": "JWT credentials per VNG-API-Common. The secret itself is never stored here, only a vault reference.",
                "@type": "schema:Service",
                "required": [
                    "clientIdentifier",
                    "secretKluisRef",
                    "userId",
                    "userRepresentation"
                ],
                "properties": {
                    "clientIdentifier": {
                        "type": "string",
                        "description": "VNG API-Common client identifier; sent in JWT iss and client_id claims, e.g. pipelinq-zoetermeer",
                        "maxLength": 255,
                        "title": "Client identifier",
                        "facetable": true
                    },
                    "secretKluisRef": {
                        "type": "string",
                        "description": "Vault reference to the client secret, e.g. vault://zgw/zoetermeer/client-secret. The plaintext secret is NEVER stored in this schema.",
                        "maxLength": 512,
                        "title": "Secret (kluis-referentie)"
                    },
                    "userId": {
                        "type": "string",
                        "description": "VNG API-Common user_id claim, e.g. pipelinq",
                        "maxLength": 255,
                        "title": "User id"
                    },
                    "userRepresentation": {
                        "type": "string",
                        "description": "VNG API-Common user_representation claim, e.g. Pipelinq backend (Conduction)",
                        "maxLength": 255,
                        "title": "User representation"
                    },
                    "tokenLevensduurSeconden": {
                        "type": "integer",
                        "description": "JWT lifetime in seconds (default 3600).",
                        "default": 3600,
                        "title": "Token-levensduur (s)"
                    },
                    "aangemaakt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 creation timestamp",
                        "title": "Aangemaakt"
                    }
                }
            },
            "nrcAbonnement": {
                "slug": "nrcAbonnement",
                "title": "NRC Abonnement",
                "version": "1.0.0",
                "summary": "Subscription state for a single NRC endpoint per ZGW endpoint: registered abonnement URL, callback bearer (vault ref), active kanalen/filters and last-received timestamp.",
                "@type": "schema:Service",
                "required": [
                    "endpointId",
                    "callbackUrl",
                    "callbackAuthKluisRef",
                    "kanalen"
                ],
                "properties": {
                    "endpointId": {
                        "type": "string",
                        "description": "Reference (id) to the parent zgwEndpoint",
                        "maxLength": 255,
                        "title": "Endpoint",
                        "facetable": true
                    },
                    "abonnementUrl": {
                        "type": "string",
                        "description": "Full URL of the registered NRC abonnement (returned by NRC on POST /abonnement).",
                        "maxLength": 1024,
                        "title": "Abonnement-URL"
                    },
                    "callbackUrl": {
                        "type": "string",
                        "description": "Pipelinq callback endpoint URL the NRC posts notifications to.",
                        "maxLength": 1024,
                        "title": "Callback-URL"
                    },
                    "callbackAuthKluisRef": {
                        "type": "string",
                        "description": "Vault reference to the per-abonnement bearer token used to authenticate inbound NRC callbacks. The token itself is NEVER stored here.",
                        "maxLength": 512,
                        "title": "Callback-auth (kluis-referentie)"
                    },
                    "kanalen": {
                        "type": "array",
                        "description": "Subscribed kanalen with per-kanaal filters, e.g. [{naam: zaken, filters: {bronorganisatie: 002564440}}].",
                        "title": "Kanalen",
                        "items": {"type": "object"}
                    },
                    "laatstOntvangenOp": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 timestamp of the last successfully processed NRC notification.",
                        "title": "Laatst ontvangen op"
                    },
                    "actief": {
                        "type": "boolean",
                        "description": "Whether this subscription is active.",
                        "default": false,
                        "title": "Actief",
                        "facetable": true
                    }
                }
            },
            "zgwResourceMapping": {
                "slug": "zgwResourceMapping",
                "title": "ZGW Resource Mapping",
                "version": "1.0.0",
                "summary": "Bidirectional link between a pipelinq entity (request/contact/document) and a ZGW resource URL. ZGW uses URLs as canonical identifiers, so this mapping relates inbound NRC notifications back to the originating pipelinq entity.",
                "@type": "schema:Thing",
                "required": [
                    "pipelinqEntiteit",
                    "pipelinqId",
                    "zgwResourceType",
                    "zgwUrl",
                    "endpointId"
                ],
                "properties": {
                    "pipelinqEntiteit": {
                        "type": "string",
                        "description": "The pipelinq entity type this mapping links.",
                        "enum": ["request", "contact", "document"],
                        "title": "Pipelinq-entiteit",
                        "facetable": true
                    },
                    "pipelinqId": {
                        "type": "string",
                        "description": "UUID of the pipelinq entity.",
                        "maxLength": 255,
                        "title": "Pipelinq-id",
                        "facetable": true
                    },
                    "zgwResourceType": {
                        "type": "string",
                        "description": "The ZGW resource type.",
                        "enum": ["zaak", "besluit", "rol", "informatieobject"],
                        "title": "ZGW-resourcetype",
                        "facetable": true
                    },
                    "zgwUrl": {
                        "type": "string",
                        "description": "Full URL of the ZGW resource (canonical identifier).",
                        "maxLength": 1024,
                        "title": "ZGW-URL",
                        "facetable": true
                    },
                    "zgwUuid": {
                        "type": "string",
                        "description": "UUID extracted from the zgwUrl, for convenience in lookups.",
                        "maxLength": 255,
                        "title": "ZGW-UUID"
                    },
                    "endpointId": {
                        "type": "string",
                        "description": "Reference (id) to the zgwEndpoint this mapping belongs to.",
                        "maxLength": 255,
                        "title": "Endpoint",
                        "facetable": true
                    },
                    "laatsteSynchronisatie": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 timestamp of last successful read from ZGW.",
                        "title": "Laatste synchronisatie"
                    },
                    "etag": {
                        "type": "string",
                        "description": "Most recent ETag from GET/PATCH on this resource, used for optimistic concurrency on subsequent PATCH calls.",
                        "maxLength": 255,
                        "title": "ETag"
                    }
                }
            }
        },
