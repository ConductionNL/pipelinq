									"value": "CTO"
								},
								{
									"field": "lifecycleStage",
									"operator": "equals",
									"value": "prospect"
								}
							]
						},
						{
							"type": "AND",
							"children": [
								{
									"field": "jobTitle",
									"operator": "containsAny",
									"value": [
										"architect",
