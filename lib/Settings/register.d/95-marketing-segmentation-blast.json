              "field": "lifecycleStage",
              "operator": "in",
              "value": [
                "customer",
                "renewal"
              ]
            }
          ]
        },
        "estimatedSize": 37,
        "createdBy": "admin",
        "createdAt": "2026-09-18T09:45:00+00:00",
        "updatedAt": "2026-10-12T11:00:00+00:00"
      },
      {
        "@self": {
          "register": "pipelinq",
          "schema": "segment",
          "slug": "segment-inactive-leads"
        },
        "name": "Inactive Leads",
        "description": "Leads zonder contactmoment in de afgelopen 90 dagen die nog geen 'closed' status hebben: voor de win-back campagne.",
        "entityType": "contact",
        "rules": {
          "type": "AND",
          "children": [
            {
              "field": "leadStage",
              "operator": "notIn",
              "value": [
                "closed-won",
                "closed-lost"
              ]
            },
            {
              "field": "lastContactMoment",
              "operator": "before",
              "value": "2026-07-09"
            },
            {
              "type": "OR",
              "children": [
                {
                  "field": "leadScore",
                  "operator": "greaterThan",
                  "value": 40
                },
                {
                  "field": "source",
                  "operator": "equals",
                  "value": "web-form"
                }
              ]
            }
          ]
        },
        "estimatedSize": 412,
        "createdBy": "marketing@example.com",
        "createdAt": "2026-09-22T13:20:00+00:00",
        "updatedAt": "2026-10-07T16:48:00+00:00"
      },
