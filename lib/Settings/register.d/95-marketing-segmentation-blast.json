									]
								},
								{
									"field": "leadScore",
									"operator": "greaterThan",
									"value": 25
								}
							]
						}
					]
				},
				"estimatedSize": 186,
				"createdBy": "marketing@example.com",
				"createdAt": "2026-09-28T12:15:00+00:00",
				"updatedAt": "2026-10-18T08:00:00+00:00"
			},
			{
				"@self": {
					"register": "pipelinq",
					"schema": "campaignTemplate",
					"slug": "template-q4-product-launch"
				},
				"name": "Q4 Product Launch",
				"channel": "email",
				"subject": "Nieuw in Q4: {{product_name}} — zo werkt het voor {{organisation_name}}",
				"bodyHtml": "<!doctype html><html lang=\"nl\"><body><p>Beste {{first_name}},</p><p>Vandaag introduceren we <strong>{{product_name}}</strong>. We hebben deze release ontworpen met klanten zoals {{organisation_name}} in gedachten.</p><p><a href=\"https://pipelinq.example.nl/q4-launch?utm_campaign=blast-q4-launch&utm_source=pipelinq-blast\">Bekijk de demo</a></p><hr><p style=\"font-size:12px;color:#666\">Conduction B.V. &middot; Nieuwezijds Voorburgwal 282, 1012 RT Amsterdam, Nederland<br>Geen interesse meer? <a href=\"{{unsubscribe_link}}\">Uitschrijven</a></p></body></html>",
				"bodyText": "Beste {{first_name}},\n\nVandaag introduceren we {{product_name}}. We hebben deze release ontworpen met klanten zoals {{organisation_name}} in gedachten.\n\nDemo: https://pipelinq.example.nl/q4-launch?utm_campaign=blast-q4-launch&utm_source=pipelinq-blast\n\n---\nConduction B.V., Nieuwezijds Voorburgwal 282, 1012 RT Amsterdam, Nederland\nUitschrijven: {{unsubscribe_link}}",
				"senderName": "Conduction Pipelinq",
				"senderEmail": "marketing@pipelinq.example.nl",
				"replyTo": "support@pipelinq.example.nl",
				"variables": [
					"first_name",
					"organisation_name",
