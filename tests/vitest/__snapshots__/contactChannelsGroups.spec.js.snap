exports[`the e-mail and phone groups > render the empty lines when there are no entries 1`] = `"<div data-v-609f8863="" class="contact-channels-section"><section data-v-609f8863="" class="contact-channels-section__group"><div data-v-609f8863="" class="contact-channels-section__group-header"><h4 data-v-609f8863="">Emails</h4><button data-v-609f8863="" class="nc-button" data-variant="tertiary" data-testid="add-email-button"><b data-v-609f8863="" class="icon-plus" size="18"></b>Add</button></div><p data-v-609f8863="" class="contact-channels-section__empty">No email addresses yet.</p></section><section data-v-609f8863="" class="contact-channels-section__group"><div data-v-609f8863="" class="contact-channels-section__group-header"><h4 data-v-609f8863="">Phones</h4><button data-v-609f8863="" class="nc-button" data-variant="tertiary" data-testid="add-phone-button"><b data-v-609f8863="" class="icon-plus" size="18"></b>Add</button></div><p data-v-609f8863="" class="contact-channels-section__empty">No phone numbers yet.</p></section><section data-v-609f8863="" class="contact-channels-section__group"><div data-v-609f8863="" class="contact-channels-section__group-header"><h4 data-v-609f8863="">Social profiles</h4><button data-v-609f8863="" class="nc-button" data-variant="tertiary" data-testid="add-social-button"><b data-v-609f8863="" class="icon-plus" size="18"></b>Add</button></div><p data-v-609f8863="" class="contact-channels-section__empty">No social profiles yet.</p></section></div>"`;

exports[`the e-mail and phone groups > render the same markup 1`] = `"<div data-v-609f8863="" class="contact-channels-section"><section data-v-609f8863="" class="contact-channels-section__group"><div data-v-609f8863="" class="contact-channels-section__group-header"><h4 data-v-609f8863="">Emails</h4><button data-v-609f8863="" class="nc-button" data-variant="tertiary" data-testid="add-email-button"><b data-v-609f8863="" class="icon-plus" size="18"></b>Add</button></div><ul data-v-609f8863="" class="contact-channels-section__list"><li data-v-609f8863="" class="contact-channels-section__row"><span data-v-609f8863="" class="contact-channels-section__kind">Work</span><a data-v-609f8863="" href="mailto:a@example.org" class="contact-channels-section__value">a@example.org</a><b data-v-609f8863="" class="icon-star" title="Primary" size="16"></b><b data-v-609f8863="" class="icon-check" title="Verified" size="16"></b><button data-v-609f8863="" class="nc-button" data-variant="tertiary" data-testid="write-email-button"><b data-v-609f8863="" class="icon-write" size="16"></b>Write email</button><button data-v-609f8863="" class="nc-button" data-variant="tertiary" aria-label="Edit"><b data-v-609f8863="" class="icon-pencil" size="16"></b></button><button data-v-609f8863="" class="nc-button" data-variant="tertiary" aria-label="Remove"><b data-v-609f8863="" class="icon-delete" size="16"></b></button></li><li data-v-609f8863="" class="contact-channels-section__row"><span data-v-609f8863="" class="contact-channels-section__kind">Private</span><a data-v-609f8863="" href="mailto:b@example.org" class="contact-channels-section__value">b@example.org</a><button data-v-609f8863="" class="nc-button" data-variant="tertiary" data-testid="write-email-button"><b data-v-609f8863="" class="icon-write" size="16"></b>Write email</button><button data-v-609f8863="" class="nc-button" data-variant="tertiary" aria-label="Edit"><b data-v-609f8863="" class="icon-pencil" size="16"></b></button><button data-v-609