            },
            {
                "id": "askQuestion",
                "type": "create",
                "label": "Stel een vraag",
                "register": "pipelinq",
                "schema": "ticket",
                "defaults": {
                    "ticketType": "request",
                    "channel": "portal"
                },
                "scopeField": "portalSubject",
                "fields": [
                    "title",
                    "description"
                ],
                "requiredFields": [
                    "title",
                    "description"
                ],
                "fieldConfigs": {
                    "title": {
                        "label": "Onderwerp",
                        "required": true,
                        "placeholder": "Waar gaat uw vraag over?"
                    },
                    "description": {
                        "label": "Uw vraag",
                        "required": true,
                        "size": "full"
                    }
                },
                "createdAtField": "occurredAt",
                "confirmationMail": "contact-confirmation",
                "topicField": "title",
                "submitLabel": "Vraag versturen",
                "successMessage": "Wij hebben uw vraag ontvangen. U vindt hem terug bij Mijn vragen."
            },
            {
                "id": "replyToQuestion",
                "label": "Reageren op het antwoord",
                "endpoint": "/index.php/apps/pipelinq/api/portal/questions/reply",
                "method": "POST",
                "attachTo": {
                    "app": "pipelinq",
                    "schema": "ticket",
                    "collection": "myQuestions"
                },
                "rowField": "ticket",
                "rowWhen": {
                    "field": "status",
                    "in": [
                        "awaiting_customer"
                    ]
                },
                "fields": [
                    "ticket",
                    "message"
                ],
                "requiredFields": [
                    "message"
                ],
                "fieldConfigs": {
                    "ticket": {
                        "visible": false,
                        "required": true
                    },
                    "message": {
                        "label": "Uw reactie",
                        "required": true,
                        "size": "full"
                    }
                },
                "submitLabel": "Reactie versturen",
                "successMessage": "Uw reactie is verstuurd."
            },
            {
