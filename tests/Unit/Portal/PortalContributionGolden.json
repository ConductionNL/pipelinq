            {
                "id": "createRequest",
                "type": "create",
                "label": "Een verzoek indienen namens uw organisatie",
                "register": "pipelinq",
                "schema": "ticket",
                "defaults": {
                    "ticketType": "request"
                },
                "scopeField": "client",
                "scopeClaim": "clientId",
                "fields": [
                    "title",
                    "description",
                    "category"
                ],
                "fieldConfigs": {
                    "title": {
                        "label": "Onderwerp",
                        "required": true,
                        "size": "large",
                        "placeholder": "Waar gaat uw verzoek over?"
                    },
                    "description": {
                        "label": "Omschrijving",
                        "required": true,
                        "size": "full",
                        "placeholder": "Beschrijf uw verzoek zo volledig mogelijk"
                    },
                    "category": {
                        "label": "Categorie"
                    }
                },
                "optionsProviders": {
                    "category": {
                        "type": "static",
                        "options": [
                            {
                                "value": "Support",
                                "label": "Support"
                            },
                            {
                                "value": "Facturatie",
                                "label": "Facturatie"
                            },
                            {
                                "value": "Technisch",
                                "label": "Technisch"
                            },
                            {
                                "value": "Accountbeheer",
                                "label": "Accountbeheer"
                            },
                            {
                                "value": "Sales",
                                "label": "Sales"
                            },
                            {
                                "value": "Integratie",
                                "label": "Integratie"
                            }
                        ]
                    }
                },
                "submitLabel": "Verzoek indienen",
                "successMessage": "Uw verzoek is ingediend"
            },
            {
                "id": "createComplaint",
