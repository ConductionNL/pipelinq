                        }
                    },
                    {
                        "field": "occurredAt",
                        "label": "Ingediend",
                        "render": "date"
                    }
                ],
                "detail": {
                    "layout": "card",
                    "fields": [
                        "title",
                        "category",
                        "status",
                        "description",
                        "occurredAt",
                        "customerMessage"
                    ]
                },
                "defaultSort": {
                    "field": "occurredAt",
                    "direction": "desc"
                }
            },
            {
                "id": "clientComplaints",
