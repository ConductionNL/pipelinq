                        "valueLabels": {
                            "new": "Ontvangen",
                            "in_progress": "In behandeling",
                            "awaiting_customer": "Wacht op uw reactie",
                            "resolved": "Opgelost",
                            "completed": "Afgerond",
                            "rejected": "Afgewezen",
