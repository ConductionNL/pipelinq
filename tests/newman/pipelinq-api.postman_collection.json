    {
      "name": "Setup Wizard (ADR-042)",
      "item": [
        {
          "name": "GET /ocs/v2.php/cloud/user — back on the admin identity",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ocs/v2.php/cloud/user?format=json",
            "header": [
              { "key": "OCS-APIRequest", "value": "true" },
              { "key": "Accept", "value": "application/json" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// The preceding folder deliberately authenticated as a non-admin,",
                  "// and Newman's cookie jar is per-host, not per-request: whatever",
                  "// authenticated last owns the session. POST /setup/action/... below",
                  "// writes, so re-assert the identity rather than assuming the",
                  "// collection-level basic auth took the session back.",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('The server reports the caller as {{username}} again', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.ocs.data.id).to.eql(pm.variables.replaceIn('{{username}}'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /setup/status",
