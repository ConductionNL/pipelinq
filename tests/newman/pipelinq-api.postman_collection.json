    {
      "name": "CRM Workflow Automation",
      "item": [
        {
          "name": "GET /automations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/automations",
            "header": [
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has pagination fields', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j).to.have.property('total');",
                  "  pm.expect(j).to.have.property('page');",
                  "  pm.expect(j).to.have.property('pages');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /automations (admin creates)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/automations",
            "header": [
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Newman test automation\", \"trigger\": \"lead_created\", \"isActive\": false, \"triggerConditions\": {}, \"actions\": [{\"type\": \"add_note\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin create returns 201', function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "if (j.automation && j.automation.id) { pm.collectionVariables.set('automationId', j.automation.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /automations/runtime",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/automations/runtime",
            "header": [
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Runtime list requires auth and returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Runtime list paginated', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j).to.have.property('results');",
                  "  pm.expect(j).to.have.property('total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /automations/{id} (cleanup)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/automations/{{automationId}}",
            "header": [
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delete returns 200', function () {",
                  "  if (pm.collectionVariables.get('automationId')) { pm.response.to.have.status(200); }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /webhooks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/webhooks",
            "header": [
