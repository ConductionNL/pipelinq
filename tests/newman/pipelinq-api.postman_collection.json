                  "// catch-all (dashboard#page /{path}) now serves this path, so",
                  "// there is no JSON master-entity read-API. A JSON body with a",
                  "// golden record would mean the wrapper still exists.",
                  "pm.test('No JSON MDM read-API response is served', function () {",
                  "  var ct = pm.response.headers.get('Content-Type') || '';",
                  "  if (ct.indexOf('application/json') !== -1) {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property('goldenRecord');",
                  "    pm.expect(json).to.not.have.property('masterId');",
                  "  } else {",
