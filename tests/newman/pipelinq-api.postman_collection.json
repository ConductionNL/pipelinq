        {
          "name": "GET /ocs/v2.php/cloud/user — the next request really is a non-admin",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ocs/v2.php/cloud/user?format=json",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{nonAdminUsername}}", "type": "string" },
                { "key": "password", "value": "{{nonAdminPassword}}", "type": "string" }
              ]
            },
            "header": [
              { "key": "OCS-APIRequest", "value": "true" },
              { "key": "Accept", "value": "application/json" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// WITHOUT THIS THE 403 BELOW WAS A LIE. {{nonAdminUsername}} and",
                  "// {{nonAdminPassword}} were referenced by the next request and",
                  "// defined by nothing — not by the collection, not by the shared",
                  "// workflow's fallback --env-vars. Postman then sent an",
                  "// Authorization header that authenticates nobody, Nextcloud fell",
                  "// back to the session cookie Newman's jar had picked up from the",
                  "// preceding ADMIN requests, and the call ran as the admin.",
                  "// Measured on a fresh NC32: HTTP 200. The test named 'non-admin",
                  "// is refused' performed, successfully, the admin write it exists",
                  "// to prove is refused.",
                  "//",
                  "// A status code cannot tell you who asked. Ask the server.",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('The server reports the caller as {{nonAdminUsername}}', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.ocs.data.id).to.eql(pm.variables.replaceIn('{{nonAdminUsername}}'));",
                  "});",
                  "pm.test('That caller is NOT in the admin group', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.ocs.data.groups).to.not.include('admin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT /rapportage/sla — non-admin → 403",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/rapportage/sla",
