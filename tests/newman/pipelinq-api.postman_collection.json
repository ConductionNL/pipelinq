    {
      "name": "Rapportage (Reporting)",
      "item": [
        {
          "name": "GET /rapportage/kpis — happy path",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/rapportage/kpis?from=2026-04-01&to=2026-04-30",
