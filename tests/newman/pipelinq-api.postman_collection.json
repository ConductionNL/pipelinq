              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has config', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.config).to.be.an('object');",
                  "});",
                  "pm.test('Config has register key', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.config).to.have.property('register');",
                  "});",
                  "// Captured so the update below can write back the value this",
                  "// deployment actually uses. The request used to POST a literal",
                  "// {\"register\":\"1\"} and it SUCCEEDED: it repointed the app at",
                  "// register 1 for the rest of the run and for every collection",
                  "// Newman ran after it, because the shared workflow runs all",
                  "// collections in one pass against one instance.",
                  "pm.collectionVariables.set('registerId', String(pm.response.json().config.register));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /settings (update)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/settings",
            "header": [
              { "key": "OCS-APIREQUEST", "value": "true" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"register\": \"{{registerId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has success', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /settings — the update round-trips, it does not repoint the app",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/settings",
            "header": [
              { "key": "OCS-APIREQUEST", "value": "true" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "// The `success: true` above is the controller's word for it. This",
                  "// reads the value back. It is also the regression guard for the",
                  "// destructive literal that used to sit in the request body: the",
                  "// register is the pointer every CRM endpoint resolves its data",
                  "// through, and writing the wrong one degrades the rest of the run",
                  "// into assertions against an unrelated register.",
                  "pm.test('Register still points where GET /settings first reported', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(String(json.config.register)).to.eql(pm.collectionVariables.get('registerId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
