          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has results array', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j).to.have.property('results');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /dmn/evaluate (invalid table -> 400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/dmn/evaluate",
            "header": [
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"decisionTableId\": \"does-not-exist\", \"inputData\": {\"score\": 10}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid decisionTableId returns 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Static message field present', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j).to.have.property('message');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
