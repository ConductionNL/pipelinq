          "name": "GET /notes (invalid type returns 400)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/index.php/apps/pipelinq/api/notes/invalid_type/123",
            "header": [
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
